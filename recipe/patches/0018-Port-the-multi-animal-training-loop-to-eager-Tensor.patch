+def restore_weights(net, checkpoint_path, net_type, include_prefixes=None):
+    """Load ``checkpoint_path`` into ``net``, redownloading it when it is missing.
+
+    Same contract as ``auxfun_models.smart_restore``: a checkpoint that does not
+    load and that sits where DeepLabCut keeps its pretrained weights is fetched
+    again before the load is retried.
+    """
+    try:
+        return load_tf1_checkpoint(net, checkpoint_path, include_prefixes=include_prefixes)
+    except (ValueError, tf.errors.OpError) as err:
+        dlcparent_path = auxiliaryfunctions.get_deeplabcut_path()
+        expected = auxfun_models.MODELTYPE_FILEPATH_MAP.get(net_type)
+        if expected is None or str(checkpoint_path) != str(dlcparent_path / expected):
+            raise
+        auxfun_models.check_for_weights(net_type, dlcparent_path)
+        return load_tf1_checkpoint(net, checkpoint_path, include_prefixes=include_prefixes)
