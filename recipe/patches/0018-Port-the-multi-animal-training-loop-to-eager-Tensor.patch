+"""Pieces a TensorFlow 2 training loop needs that no longer come from a Session.
+
+``setup_preloading``/``start_preloading`` (a FIFOQueue fed by a Python thread
+through a Coordinator), ``slim.learning.create_train_op`` and
+``tf.train.Saver`` each have a direct eager counterpart; they are collected
+here so the single- and multi-animal loops share one implementation.
+"""
+
+import os
+from pathlib import Path
+
+import tensorflow as tf
+
+from deeplabcut.pose_estimation_tensorflow.datasets import Batch
+
+#: Depth of the prefetch queue, i.e. the capacity of the FIFOQueue it replaces.
+QUEUE_SIZE = 20
+
+
+class LearningRate:
+    """The piecewise schedule of ``multi_step``, stepped once per iteration.
+
+    Lives here rather than in ``core/train.py`` because importing that module
+    turns eager execution off for the whole process.
+    """
+
+    def __init__(self, cfg):
+        self.steps = cfg["multi_step"]
+        self.current_step = 0
+
+    def get_lr(self, iteration):
+        lr = self.steps[self.current_step][0]
+        if iteration == self.steps[self.current_step][1]:
+            self.current_step += 1
+
+        return lr
+
+
+def configure_gpu_memory_growth(allow_growth=True):
+    """Grow the GPU allocation on demand instead of taking the whole device."""
+    if not allow_growth:
+        return
+    for device in tf.config.list_physical_devices("GPU"):
+        try:
+            tf.config.experimental.set_memory_growth(device, True)
+        except RuntimeError:
+            # The device is already initialised; its policy cannot change now.
+            pass
+
+
+def make_dataset(dataset, batch_spec, queue_size=QUEUE_SIZE):
+    """Prefetch the batches of a ``PoseDataset`` into a ``tf.data`` pipeline.
+
+    ``dataset.next_batch()`` returns a ``{Batch: numpy array}`` dictionary and
+    never runs out.  The result yields the same batches keyed by the *name* of
+    each ``Batch`` member: ``tf.nest`` sorts the keys of a dictionary it flattens
+    and ``Batch`` members do not compare.
+    """
+    keys = sorted(batch_spec, key=lambda k: k.value)
+
+    def generator():
+        while True:
+            batch = dataset.next_batch()
+            yield tuple(batch[key].astype("float32") for key in keys)
+
+    signature = tuple(tf.TensorSpec(batch_spec[key], tf.float32) for key in keys)
+    pipeline = tf.data.Dataset.from_generator(generator, output_signature=signature)
+    pipeline = pipeline.prefetch(queue_size)
+    names = [key.name for key in keys]
+    return pipeline.map(lambda *tensors: dict(zip(names, tensors)))
+
+
+def make_optimizer(cfg, learning_rate):
+    """The optimizer ``core/train.get_optimizer`` builds, without a graph.
+
+    ``MomentumOptimizer(lr, 0.9)`` keeps ``a <- 0.9 a + g``, ``w <- w - lr a``
+    and ``SGD(lr, momentum=0.9)`` keeps ``v <- 0.9 v - lr g``, ``w <- w + v``,
+    the same sequence for a constant learning rate.  ``AdamOptimizer`` defaults
+    to ``epsilon=1e-8`` where Keras defaults to ``1e-7``, so it is passed.
+    """
+    if cfg["optimizer"] == "sgd":
+        return tf.keras.optimizers.legacy.SGD(learning_rate=learning_rate, momentum=0.9)
+    if cfg["optimizer"] == "adam":
+        return tf.keras.optimizers.legacy.Adam(learning_rate=learning_rate, epsilon=1e-8)
+    raise ValueError("unknown optimizer {}".format(cfg["optimizer"]))
+
+
+def make_train_step(net, optimizer, global_step, variables_to_train=None):
+    """One optimisation step, the eager form of ``create_train_op``.
+
+    ``create_train_op`` makes the update operations of every batch
+    normalisation layer control dependencies of the loss, computes the
+    gradients of the trainable variables, applies them and increments the
+    global step, checking the loss for inf and nan on the way.  Calling the
+    layers with ``is_training=True`` applies those updates in place, so the
+    order is the same and nothing has to be collected.
+    """
+
+    @tf.function(reduce_retracing=True)
+    def train_step(batch, learning_rate):
+        optimizer.learning_rate.assign(learning_rate)
+        with tf.GradientTape() as tape:
+            losses = net.train({Batch[name]: tensor for name, tensor in batch.items()})
+            total_loss = tf.debugging.check_numerics(losses["total_loss"], "LossTensor is inf or nan")
+        variables = net.trainable_variables if variables_to_train is None else variables_to_train
+        gradients = tape.gradient(total_loss, variables)
+        optimizer.apply_gradients(zip(gradients, variables))
+        global_step.assign_add(1)
+        return losses
+
+    return train_step
+
+
+class SnapshotSaver:
+    """Write name-based snapshots, keeping the last ``max_to_keep`` of them.
+
+    Reproduces what ``tf.train.Saver(max_to_keep=n).save(sess, prefix,
+    global_step=it)`` leaves on disk: the checkpoint shards, the ``checkpoint``
+    state file naming the newest and listing the ones kept, and the deletion of
+    everything older.
+    """
+
+    def __init__(self, model, prefix, max_to_keep=5):
+        from deeplabcut.pose_estimation_tensorflow.nnets import save_tf1_checkpoint
+
+        self._save = save_tf1_checkpoint
+        self.model = model
+        self.prefix = str(prefix)
+        self.max_to_keep = max_to_keep
+        self.saved = []
+
+    def save(self, global_step):
+        written = self._save(self.model, self.prefix, global_step=global_step, write_state=False)
+        self.saved.append(written)
+        while self.max_to_keep and len(self.saved) > self.max_to_keep:
+            self._remove(self.saved.pop(0))
+        self._write_state()
+        return written
+
+    @staticmethod
+    def _remove(written):
+        path = Path(written)
+        for stale in path.parent.glob(path.name + ".*"):
+            stale.unlink(missing_ok=True)
+
+    def _write_state(self):
+        directory = os.path.dirname(os.path.abspath(self.prefix)) or "."
+        with open(os.path.join(directory, "checkpoint"), "w") as handle:
+            handle.write(f'model_checkpoint_path: "{os.path.basename(self.saved[-1])}"\n')
+            for written in self.saved:
+                handle.write(f'all_model_checkpoint_paths: "{os.path.basename(written)}"\n')
