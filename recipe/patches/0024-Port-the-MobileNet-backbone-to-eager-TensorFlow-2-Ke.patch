+#
+"""Tests for the eager TensorFlow 2 MobileNet backbone and pose net.
+
+Never builds a TF1 graph.  The comparison against the ``tf_slim``
+implementation needs the two engines in separate processes and lives in
+``test_nnets_keras_equivalence.py``'s sibling harness; what is checked here is
+the contract, the checkpoint bridge and the batch-norm behaviour patch 0014
+established.
+"""
+import numpy as np
+import pytest
+
+tf = pytest.importorskip("tensorflow")
+
+from deeplabcut.pose_estimation_tensorflow.backbones import (  # noqa: E402
+    mobilenet_v2_keras as mnk,
+)
+from deeplabcut.pose_estimation_tensorflow.nnets import (  # noqa: E402
+    KERAS_ENGINE,
+    TF1_ENGINE,
+    KerasBackboneFactory,
+    PoseMobileNetKeras,
+    PoseNetFactory,
+    ensure_eager_execution,
+    load_tf1_checkpoint,
+    save_tf1_checkpoint,
+)
+from deeplabcut.pose_estimation_tensorflow.nnets.checkpoint import (  # noqa: E402
+    compare_to_tf1_checkpoint,
+)
+
+SIZE = (128, 160)
+ALPHAS = ["mobilenet_v2_1.0", "mobilenet_v2_0.75", "mobilenet_v2_0.5", "mobilenet_v2_0.35"]
+#: tf_slim variable counts: 260 backbone plus two per prediction head
+N_BACKBONE = 260
+
+
+@pytest.fixture(scope="module", autouse=True)
+def eager():
+    """Turn eager on for this module, and leave it on.
+
+    Eager cannot be re-enabled once the eager context has been touched, so a
+    module that turns it off again on the way out makes every later Keras test
+    skip.  All the Keras test modules therefore leave it on, which is what lets
+    them run in any collection order.
+    """
+    try:
+        ensure_eager_execution()
+    except RuntimeError as err:  # a TF1 graph was built earlier in this process
+        pytest.skip(str(err))
+    yield
+
+
+def pose_cfg(**kwargs):
+    cfg = {
+        "stride": 8.0,
+        "weigh_part_predictions": False,
+        "mean_pixel": [123.68, 116.779, 103.939],
+        "location_refinement": True,
+        "locref_stdev": 7.2801,
+        "locref_loss_weight": 1.0,
+        "locref_huber_loss": True,
+        "intermediate_supervision": False,
+        "intermediate_supervision_layer": 12,
+        "weight_decay": 0.0001,
+        "batch_size": 1,
+        "dataset_type": "imgaug",
+        "pairwise_huber_loss": True,
+        "pairwise_predict": False,
+        "partaffinityfield_predict": False,
+        "num_joints": 4,
+        "num_limbs": 0,
+        "net_type": "mobilenet_v2_1.0",
+        "multi_stage": False,
+        "pairwise_loss_weight": 1.0,
+    }
+    cfg.update(kwargs)
+    return cfg
+
+
+def images(batch_size, seed=0):
+    return tf.constant(
+        np.random.RandomState(seed).uniform(0, 255, (batch_size, *SIZE, 3)),
+        dtype=tf.float32,
+    )
+
+
+def build(cfg, batch_size=None):
+    if batch_size is not None:
+        cfg = dict(cfg, batch_size=batch_size)
+    model = PoseNetFactory.create(cfg, engine=KERAS_ENGINE)
+    model.build_for([cfg["batch_size"], *SIZE, 3])
+    return model
+
+
+# ---------------------------------------------------------------------------
+# engine and factory wiring
+# ---------------------------------------------------------------------------
+@pytest.mark.parametrize("net_type", ALPHAS)
+def test_the_keras_engine_selects_the_keras_mobilenet(net_type):
+    cfg = pose_cfg(net_type=net_type)
+    assert isinstance(PoseNetFactory.create(cfg, engine=KERAS_ENGINE), PoseMobileNetKeras)
+    assert type(PoseNetFactory.create(cfg, engine=TF1_ENGINE)).__name__ == "PoseMobileNet"
+
+
+def test_tf1_stays_the_default():
+    assert type(PoseNetFactory.create(pose_cfg())).__name__ == "PoseMobileNet"
+
+
+@pytest.mark.parametrize("net_type", ALPHAS)
+def test_the_backbone_is_registered(net_type):
+    assert KerasBackboneFactory.supports(net_type)
+    backbone = KerasBackboneFactory.create(pose_cfg(net_type=net_type))
+    assert isinstance(backbone, mnk.MobilenetV2Keras)
+
+
+# ---------------------------------------------------------------------------
+# the contract
+# ---------------------------------------------------------------------------
+@pytest.mark.parametrize("net_type", ALPHAS)
+def test_every_weight_carries_a_tf_slim_name(net_type):
+    model = build(pose_cfg(net_type=net_type))
+    weights = model.slim_weight_map()
+    assert len(weights) == N_BACKBONE + 4  # part_pred and locref, weights + biases
+    assert model.unmapped_weights() == []
+    assert all(name.startswith(("MobilenetV2/", "pose/")) for name in weights)
+
+
+def test_intermediate_supervision_adds_one_head():
+    model = build(pose_cfg(intermediate_supervision=True))
+    assert len(model.slim_weight_map()) == N_BACKBONE + 6
+    assert "pose/intermediate_supervision/block4/weights" in model.slim_weight_map()
+    assert model.unmapped_weights() == []
+
+
+def test_heads_are_the_documented_contract():
+    model = build(pose_cfg(intermediate_supervision=True))
+    out = model.get_net(images(1))
+    assert set(out) == {"features", "part_pred", "locref", "part_pred_interm"}
+    assert out["part_pred"].shape == (1, SIZE[0] // 8, SIZE[1] // 8, 4)
+    assert out["locref"].shape == (1, SIZE[0] // 8, SIZE[1] // 8, 8)
+    assert out["features"].shape[-1] == 1280
+
+
+def test_extract_features_returns_the_tf_slim_end_point_names():
+    model = build(pose_cfg())
+    net, end_points = model.extract_features(images(1))
+    assert net.shape == (1, SIZE[0] // 16, SIZE[1] // 16, 1280)
+    for i in range(1, 20):
+        assert f"layer_{i}" in end_points
+    # the expanded_conv tensors the tf_slim builder harvests from the graph
+    assert "layer_3/expansion_output" in end_points
+    assert "layer_3/depthwise_output" in end_points
+    assert "layer_3/output" in end_points
+    # the first expanded_conv has no expansion stage, as in the checkpoint
+    assert "layer_2/expansion_output" not in end_points
+    assert len(end_points) == 69
+
+
+def test_no_variable_is_claimed_twice():
+    model = build(pose_cfg(intermediate_supervision=True))
+    by_id = {}
+    for name, variable in model.slim_weight_map().items():
+        by_id.setdefault(id(variable), []).append(name)
+    assert all(len(names) == 1 for names in by_id.values())
+
+
+def test_depthwise_layers_use_slims_weight_name():
+    model = build(pose_cfg())
+    names = model.slim_weight_map()
+    assert "MobilenetV2/expanded_conv/depthwise/depthwise_weights" in names
+    assert names["MobilenetV2/expanded_conv/depthwise/depthwise_weights"].shape == (3, 3, 32, 1)
+    # slim.separable_conv2d(num_outputs=None) has no pointwise stage
+    assert "MobilenetV2/expanded_conv/depthwise/pointwise_weights" not in names
+
+
+# ---------------------------------------------------------------------------
+# batch norm: what patch 0014 established
+# ---------------------------------------------------------------------------
+def test_inference_is_independent_of_batch_composition():
+    """Patch 0014's property, without its graph replication.
+
+    An image's output does not depend on what it is batched with, because
+    batch norm reads the moving averages rather than the batch.  Not
+    bit-for-bit: TensorFlow reassociates differently for different batch
+    sizes -- its own start-up banner warns that oneDNN may give "slightly
+    different numerical results ... from different computation orders" -- and
+    which kernel is picked depends on the host CPU.  Measured on the feature
+    map: 0.0 on one machine, 1.4e-06 on a GitHub runner, against 4.19 when
+    the norm really does read the batch, which
+    ``test_batch_mode_reproduces_the_bug_it_replaces`` pins down.  1e-4 sits
+    a factor of 70 above the noise and 4e4 below the bug.
+    """
+    model = build(pose_cfg(), batch_size=4)
+    batch = images(4, seed=1)
+    alone, _ = model.extract_features(batch[:1])
+    together, _ = model.extract_features(batch)
+    shuffled, _ = model.extract_features(tf.gather(batch, [3, 0, 2, 1]))
+    assert np.abs(alone.numpy() - together.numpy()[:1]).max() < 1e-4
+    assert np.abs(alone.numpy() - shuffled.numpy()[1:2]).max() < 1e-4
+
+    head_alone = model.get_net(batch[:1])["part_pred"].numpy()
+    head_together = model.get_net(batch)["part_pred"].numpy()[:1]
+    assert np.abs(head_alone - head_together).max() < 1e-5
+
+
+def test_batch_mode_reproduces_the_bug_it_replaces():
+    """The stock tf_slim reduction really does depend on the other images.
+
+    This is what the tolerance in
+    ``test_inference_is_independent_of_batch_composition`` has to separate
+    from kernel noise, so measure it at the same two points.
+    """
+    model = build(pose_cfg(), batch_size=4)
+    model.backbone.set_bn_mode(mnk.BN_BATCH)
+    batch = images(4, seed=1)
+    feat_alone, _ = model.extract_features(batch[:1])
+    feat_together, _ = model.extract_features(batch)
+    assert np.abs(feat_alone.numpy() - feat_together.numpy()[:1]).max() > 1.0
+    alone = model.get_net(batch[:1])["part_pred"].numpy()
+    together = model.get_net(batch)["part_pred"].numpy()[:1]
+    assert np.abs(alone - together).max() > 1e-3
+
+
+def test_a_dynamic_batch_dimension_is_batch_independent_too():
+    """What export_model builds, and the one case patch 0014 could not fix."""
+    model = build(pose_cfg(), batch_size=4)
+
+    @tf.function(input_signature=[tf.TensorSpec([None, *SIZE, 3], tf.float32)])
+    def graph(x):
+        return model.get_net(x)["part_pred"]
+
+    batch = images(4, seed=1)
+    alone = graph(batch[:1]).numpy()
+    for size in (2, 3, 4):
+        assert np.abs(alone - graph(batch[:size]).numpy()[:1]).max() < 1e-4
+
+
+def test_the_backbone_updates_its_moving_averages_only_in_training_mode():
+    """Unlike resnet: training_scope() propagates is_training to the backbone.
+
+    The tf_slim training graph really does carry 52 ``is_training=True``
+    batch-norm nodes and 104 UPDATE_OPS, so the Keras net must move its moving
+    statistics when, and only when, ``is_training`` is set.
+    """
+    model = build(pose_cfg())
+    bn = model.backbone.layer_lookup["MobilenetV2/Conv"].bn
+    before = bn.moving_mean.numpy().copy()
+    model.get_net(images(1), is_training=False)
+    assert np.array_equal(before, bn.moving_mean.numpy())
+    model.get_net(images(1), is_training=True)
+    assert not np.array_equal(before, bn.moving_mean.numpy())
+
+
+def test_moving_average_mode_differs_from_the_shipped_default():
+    """The variant that was measured at 12.79 px and rejected is still reachable."""
+    model = build(pose_cfg())
+    default = model.get_net(images(1))["part_pred"].numpy()
+    model.backbone.set_bn_mode(mnk.BN_MOVING)
+    moving = model.get_net(images(1))["part_pred"].numpy()
+    assert np.abs(default - moving).max() > 1e-3
+
+
+# ---------------------------------------------------------------------------
+# checkpoints and training
+# ---------------------------------------------------------------------------
+@pytest.mark.parametrize("net_type", ALPHAS)
+def test_checkpoint_round_trip(tmp_path, net_type):
+    model = build(pose_cfg(net_type=net_type, intermediate_supervision=True))
+    written = save_tf1_checkpoint(model, str(tmp_path / "snapshot"), global_step=3)
+    assert written.endswith("snapshot-3")
+    for variable in model.slim_weight_map().values():
+        variable.assign(tf.zeros_like(variable))
+    report = load_tf1_checkpoint(model, written)
+    assert report.ok and report.missing == [] and report.unused == []
+    assert len(report.loaded) == N_BACKBONE + 6
+    assert max(compare_to_tf1_checkpoint(model, written).values()) == 0.0
+
