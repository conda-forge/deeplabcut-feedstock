+
+
+@PoseNetFactory.register("mobilenet", engine=KERAS_ENGINE)
+class PoseMobileNetKeras(BaseKerasPoseNet):
+    """Keras twin of :class:`PoseMobileNet`.
+
+    Batch norm reproduces patch 0014: every image is normalised by its own
+    statistics, independently of the batch it is in.  See
+    ``backbones/mobilenet_v2_keras.py`` for why that, and not the moving
+    averages, is the right inference behaviour for this backbone.
+    """
+
+    def __init__(self, cfg):
+        super().__init__(cfg)  # stores cfg with set_untracked
+        self.backbone = KerasBackboneFactory.create(cfg)
+        n_joints = cfg["num_joints"]
+        n_parts = n_joints + cfg.get("num_idchannel", 0)
+        self._add_head("part_pred", "pose/part_pred/block4", n_parts)
+        if cfg["location_refinement"]:
+            self._add_head("locref", "pose/locref_pred/block4", n_joints * 2)
+        if cfg["pairwise_predict"] and "multi-animal" not in cfg["dataset_type"]:
+            self._add_head("pairwise_pred", "pose/pairwise_pred/block4", n_joints * (n_joints - 1) * 2)
+        if cfg["partaffinityfield_predict"] and "multi-animal" in cfg["dataset_type"]:
+            self._add_head("pairwise_pred", "pose/pairwise_pred/block4", cfg["num_limbs"] * 2)
+        self.interm_end_point = None
+        if cfg["intermediate_supervision"]:
+            self.interm_end_point = f"layer_{cfg['intermediate_supervision_layer']}"
+            self._add_head("part_pred_interm", "pose/intermediate_supervision/block4", n_parts)
+
+    def extract_features(self, inputs, is_training=False):
+        # Unlike PoseResnet, which passes is_training=False to resnet_v1
+        # unconditionally, mobilenet_v2.training_scope() propagates is_training
+        # into the backbone: the tf_slim training graph really does run all 52
+        # batch norms in training mode and update their moving averages.
+        return self.backbone(inputs, training=is_training)
+
+    def prediction_layers(self, features, end_points, is_training=False):
+        out = {"features": features}
+        for key, layer in self._heads.items():
+            source = end_points[self.interm_end_point] if key == "part_pred_interm" else features
+            out[key] = layer(source, training=is_training)
+        return out
