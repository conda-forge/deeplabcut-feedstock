+def test_config_survives_deeplabcuts_own_yaml_writers(tmp_path):
+    """The real corruption path: build a net, then let DeepLabCut save the config."""
+    from deeplabcut.utils.auxiliaryfunctions import read_plainconfig, write_plainconfig
+
+    cfg = pose_cfg(intermediate_supervision=True)
+    cfg["all_joints"] = [[i] for i in range(cfg["num_joints"])]
+    cfg["all_joints_names"] = ["a", "b", "c", "d"]
+    cfg["multi_step"] = [[0.005, 10000], [0.02, 430000]]
+
+    reference = tmp_path / "pose_cfg_before.yaml"
+    write_plainconfig(str(reference), cfg)
+
+    PoseNetFactory.create(cfg, engine=KERAS_ENGINE)
+
+    written = tmp_path / "pose_cfg_after.yaml"
+    write_plainconfig(str(written), cfg)
+
+    assert "!!python" not in written.read_text()
+    assert written.read_text() == reference.read_text()
+    assert read_plainconfig(str(written)) == read_plainconfig(str(reference))
+
