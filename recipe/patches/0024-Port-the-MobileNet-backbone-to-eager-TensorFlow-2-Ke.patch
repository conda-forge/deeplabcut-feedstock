+@pytest.mark.parametrize("net_type", ALPHAS)
+def test_building_the_net_leaves_the_callers_config_alone(net_type):
+    yaml = pytest.importorskip("yaml")
+    cfg = pose_cfg(net_type=net_type, intermediate_supervision=True)
+    cfg["all_joints"] = [[i] for i in range(cfg["num_joints"])]
+    cfg["multi_step"] = [[0.005, 10000], [0.02, 430000]]
+    before = yaml.dump(cfg, default_flow_style=False)
+
+    model = PoseNetFactory.create(cfg, engine=KERAS_ENGINE)
+
+    after = yaml.dump(cfg, default_flow_style=False)
+    assert _trackable_values(cfg) == {}
+    assert "!!python" not in after
+    assert after == before
+    assert model.cfg is cfg
+    # the backbone keeps no reference of its own, only scalars and fresh lists
+    assert getattr(model.backbone, "cfg", None) is None
+    assert model.backbone.mean_pixel is not cfg["mean_pixel"]
+
