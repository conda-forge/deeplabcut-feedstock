+@pytest.mark.parametrize("batch_size", [1, 4])
+def test_setup_pose_prediction_runs_the_keras_mobilenet(tmp_path, batch_size):
+    """core/predict dispatches on the engine, so a mobilenet project reaches this."""
+    from deeplabcut.pose_estimation_tensorflow.core import predict
+
+    cfg = pose_cfg(tf_engine="keras", batch_size=batch_size)
+    model = build(dict(cfg))
+    cfg["init_weights"] = save_tf1_checkpoint(model, str(tmp_path / "snapshot"), global_step=1)
+
+    session, inputs, outputs = predict.setup_pose_prediction(cfg)
+    values = session.run(outputs, feed_dict={inputs: images(batch_size).numpy()})
+    scmap, locref = predict.extract_cnn_output(values, cfg)
+    assert scmap.shape[-3:] == (SIZE[0] // 8, SIZE[1] // 8, 4)
+    if batch_size == 1:
+        pose = predict.argmax_pose_predict(scmap, locref, cfg["stride"])
+        assert pose.shape == (4, 3)
+    if hasattr(session, "close"):
+        session.close()
+
+
+def test_the_production_path_is_batch_independent(tmp_path):
+    """Patch 0014's guarantee, all the way through core/predict."""
+    from deeplabcut.pose_estimation_tensorflow.core import predict
+
+    model = build(pose_cfg())
+    weights = save_tf1_checkpoint(model, str(tmp_path / "snapshot"), global_step=1)
+    batch = images(4, seed=1).numpy()
+
+    poses = {}
+    for batch_size in (1, 4):
+        cfg = pose_cfg(tf_engine="keras", batch_size=batch_size)
+        cfg["init_weights"] = weights
+        session, inputs, outputs = predict.setup_pose_prediction(cfg)
+        values = session.run(outputs, feed_dict={inputs: batch[:batch_size]})
+        scmap, locref = predict.extract_cnn_output(values, cfg)
+        if batch_size > 1:
+            scmap = scmap[0]
+            locref = locref.reshape(batch_size, *scmap.shape[:2], -1, 2)[0]
+        poses[batch_size] = predict.argmax_pose_predict(scmap, locref, cfg["stride"])
+        if hasattr(session, "close"):
+            session.close()
+
+    moved = np.linalg.norm(poses[1][:, :2] - poses[4][:, :2], axis=-1)
+    assert moved.max() < 1e-3, moved
