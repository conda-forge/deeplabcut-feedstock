+"""MobileNet V2 as an eager ``tf.keras`` backbone.
+
+Replaces, for ``net_type=mobilenet_v2_*``, the vendored tf_slim model-zoo copy
+in ``backbones/mobilenet.py`` + ``backbones/mobilenet_v2.py`` +
+``nnets/conv_blocks.py``, restricted to the configurations DeepLabCut builds:
+``mobilenet_base`` with ``base_only=True``, depth multipliers 1.0/0.75/0.5/0.35
+and ``finegrain_classification_mode`` for the small ones.
+
+Contains no ``tf.compat.v1``, no ``tf_slim``, no ``variable_scope``, no
+``arg_scope``, no placeholder and no Session.  Every layer carries the tf_slim
+variable scope it stands in for and exposes ``slim_weights()``, so
+``BaseKerasPoseNet.slim_weight_map`` and ``nnets/checkpoint.py`` handle
+snapshots in both directions with no further plumbing.
+
+Inference-time batch norm is the part that needs care.  ``PoseMobileNet``
+builds this backbone through ``mobilenet_v2.training_scope()``, which defaults
+to ``is_training=True``, so all 52 batch-norm layers normalise with batch
+statistics even at inference.  Those 52 layers *are* the feature extractor and
+switching them to the stored moving averages destroys accuracy, so the
+behaviour is kept.  What ``BN_PER_IMAGE`` removes is the dependence on which
+images share a batch: it reduces over ``[height, width]`` only, which is what
+the tf_slim code computes when it is handed one image at a time.  Unlike the
+graph replication it replaces it costs one pass instead of N and works for a
+dynamic batch dimension, so exported models get it too.
+"""
+
+import tensorflow as tf
+
+from deeplabcut.pose_estimation_tensorflow.nnets.factory import KerasBackboneFactory
+from deeplabcut.pose_estimation_tensorflow.nnets.layers import SlimConv
+
+# tf_slim defaults, from mobilenet.training_scope() and V2_DEF.  Note these are
+# not slim.batch_norm's own defaults: training_scope() overrides decay, and
+# V2_DEF overrides scale.
+MOBILENET_BN_DECAY = 0.997
+MOBILENET_BN_EPSILON = 1e-3  # slim.batch_norm's default epsilon
+MOBILENET_BN_SCALE = True  # V2_DEF sets center=True, scale=True
+MOBILENET_WEIGHT_DECAY = 0.00004  # mobilenet.training_scope(weight_decay=...)
+MOBILENET_STDDEV = 0.09  # mobilenet.training_scope(stddev=...)
+
+#: normalise every image by its own statistics: patch 0014's behaviour
+BN_PER_IMAGE = "per_image"
+#: normalise by the statistics of the whole batch: stock tf_slim at inference
+BN_BATCH = "batch"
+#: normalise by the stored moving averages, which costs 4.72 -> 12.79 px
+BN_MOVING = "moving"
+
+
+def _make_divisible(v, divisor=8, min_value=None):
+    """Verbatim from nnets/conv_blocks.py."""
+    if min_value is None:
+        min_value = divisor
+    new_v = max(min_value, int(v + divisor / 2) // divisor * divisor)
+    if new_v < 0.9 * v:
+        new_v += divisor
+    return new_v
+
+
+#: depth multiplier and finegrain flag per net_type, matching nnets/mobilenet.py
+MOBILENET_VARIANTS = {
+    "mobilenet_v2_1.0": (1.0, False),
+    "mobilenet_v2_0.75": (0.75, True),
+    "mobilenet_v2_0.5": (0.5, True),
+    "mobilenet_v2_0.35": (0.35, True),
+}
+
+# Architecture: https://arxiv.org/abs/1801.04381, as spelled out by
+# mobilenet_v2.V2_DEF.  NOTE the stride of the 15th op is 1 and not 2: that is
+# DeepLabCut's change, to get an output stride of 16 instead of 32.
+V2_SPEC = (
+    {"op": "conv", "stride": 2, "num_outputs": 32, "kernel_size": 3},
+    {"op": "expanded_conv", "stride": 1, "num_outputs": 16, "expansion": 1, "expansion_divisible_by": 1},
+    {"op": "expanded_conv", "stride": 2, "num_outputs": 24},
+    {"op": "expanded_conv", "stride": 1, "num_outputs": 24},
+    {"op": "expanded_conv", "stride": 2, "num_outputs": 32},
+    {"op": "expanded_conv", "stride": 1, "num_outputs": 32},
+    {"op": "expanded_conv", "stride": 1, "num_outputs": 32},
+    {"op": "expanded_conv", "stride": 2, "num_outputs": 64},
+    {"op": "expanded_conv", "stride": 1, "num_outputs": 64},
+    {"op": "expanded_conv", "stride": 1, "num_outputs": 64},
+    {"op": "expanded_conv", "stride": 1, "num_outputs": 64},
+    {"op": "expanded_conv", "stride": 1, "num_outputs": 96},
+    {"op": "expanded_conv", "stride": 1, "num_outputs": 96},
+    {"op": "expanded_conv", "stride": 1, "num_outputs": 96},
+    {"op": "expanded_conv", "stride": 1, "num_outputs": 160},
+    {"op": "expanded_conv", "stride": 1, "num_outputs": 160},
+    {"op": "expanded_conv", "stride": 1, "num_outputs": 160},
+    {"op": "expanded_conv", "stride": 1, "num_outputs": 320},
+    {"op": "conv", "stride": 1, "num_outputs": 1280, "kernel_size": 1},
+)
+
+
+class SlimBatchNorm(tf.keras.layers.BatchNormalization):
+    """``slim.batch_norm`` with a selectable inference-time reduction.
+
+    ``training=True`` is ordinary Keras batch norm, which is what tf_slim does
+    while training, moving-average update and decay included.  With
+    ``training=False`` the reduction is chosen by ``mode``; see the module
+    docstring for why the default is not the moving averages.
+    """
+
+    def __init__(self, mode=BN_PER_IMAGE, **kwargs):
+        kwargs.setdefault("epsilon", MOBILENET_BN_EPSILON)
+        kwargs.setdefault("momentum", MOBILENET_BN_DECAY)
+        super().__init__(axis=-1, center=True, scale=MOBILENET_BN_SCALE, **kwargs)
+        self.mode = mode
+
+    def call(self, inputs, training=None):
+        if training:
+            return super().call(inputs, training=True)
+        if self.mode == BN_MOVING:
+            return super().call(inputs, training=False)
+        # BN_PER_IMAGE reduces over height and width only, which is what the
+        # tf_slim graph computes when it is given one image at a time.
+        axes = [1, 2] if self.mode == BN_PER_IMAGE else [0, 1, 2]
+        mean = tf.reduce_mean(inputs, axis=axes, keepdims=True)
+        variance = tf.reduce_mean(
+            tf.math.squared_difference(inputs, tf.stop_gradient(mean)),
+            axis=axes,
+            keepdims=True,
+        )
+        # Same association as tf.nn.fused_batch_norm: fold gamma into the scale
+        # and the mean into the offset, then a single multiply-add.
+        scale = tf.math.rsqrt(variance + self.epsilon) * self.gamma
+        return inputs * scale + (self.beta - mean * scale)
+
+
+class MobilenetConv(SlimConv):
+    """``slim.conv2d`` + ``slim.batch_norm`` with MobileNet's normalisation."""
+
+    def __init__(self, slim_scope, filters, kernel_size, strides=1, activation=None,
+                 weight_decay=MOBILENET_WEIGHT_DECAY, stddev=MOBILENET_STDDEV,
+                 bn_mode=BN_PER_IMAGE, **kwargs):
+        super().__init__(
+            slim_scope,
+            filters,
+            kernel_size,
+            strides=strides,
+            padding="same",
+            use_bn=True,
+            bn_scale=MOBILENET_BN_SCALE,
+            bn_decay=MOBILENET_BN_DECAY,
+            bn_epsilon=MOBILENET_BN_EPSILON,
+            activation=activation,
+            weight_decay=weight_decay,
+            kernel_initializer=_slim_initializer(stddev),
+            **kwargs,
+        )
+        # SlimConv builds a plain BatchNormalization; MobileNet needs the
+        # per-image reduction.  The layer being replaced has not been built, so
+        # it owns no weights and slim_weight_map() never sees it.
+        self.bn = SlimBatchNorm(mode=bn_mode)
+
+
+class SlimDepthwiseConv(tf.keras.layers.Layer):
+    """``slim.separable_conv2d(num_outputs=None)`` + ``slim.batch_norm``.
+
+    slim's ``separable_conv2d`` with ``num_outputs=None`` is depthwise ONLY --
+    it has no pointwise stage -- so this is ``DepthwiseConv2D`` and not
+    ``SeparableConv2D``.  ``depth_multiplier=1`` gives the same
+    ``[k, k, in, 1]`` kernel slim stores as ``depthwise_weights``.
+    ``training_scope()`` sets ``weights_regularizer=None`` for
+    ``separable_conv2d``, unlike ``conv2d``, so there is no regularizer here.
+    """
+
+    def __init__(self, slim_scope, kernel_size=3, strides=1, rate=1,
+                 activation=tf.nn.relu6, stddev=MOBILENET_STDDEV,
+                 bn_mode=BN_PER_IMAGE, **kwargs):
+        super().__init__(name=slim_scope.replace("/", "."), **kwargs)
+        self.slim_scope = slim_scope
+        self.activation = activation
+        self.conv = tf.keras.layers.DepthwiseConv2D(
+            kernel_size,
+            strides=strides,
+            dilation_rate=rate,
+            padding="same",
+            depth_multiplier=1,
+            use_bias=False,
+            depthwise_initializer=_slim_initializer(stddev),
+            depthwise_regularizer=None,
+        )
+        self.bn = SlimBatchNorm(mode=bn_mode)
+
+    def call(self, inputs, training=False):
+        x = self.bn(self.conv(inputs), training=training)
+        return self.activation(x) if self.activation is not None else x
+
+    def slim_weights(self):
+        """``{tf_slim variable name: tf.Variable}`` for this layer."""
+        return {
+            f"{self.slim_scope}/depthwise_weights": self.conv.depthwise_kernel,
+            f"{self.slim_scope}/BatchNorm/gamma": self.bn.gamma,
+            f"{self.slim_scope}/BatchNorm/beta": self.bn.beta,
+            f"{self.slim_scope}/BatchNorm/moving_mean": self.bn.moving_mean,
+            f"{self.slim_scope}/BatchNorm/moving_variance": self.bn.moving_variance,
+        }
+
+
+def _slim_initializer(stddev):
+    """``mobilenet.training_scope``'s weights_initializer."""
+    if stddev < 0:
+        return "glorot_uniform"
+    return tf.keras.initializers.TruncatedNormal(stddev=stddev)
+
+
+@KerasBackboneFactory.register("mobilenet")
+class MobilenetV2Keras(tf.keras.Model):
+    """``mobilenet_v2.mobilenet_base`` with tf_slim's exact layer semantics.
+
+    Takes raw images and subtracts ``cfg["mean_pixel"]`` itself, mirroring
+    ``PoseMobileNet.extract_features``.  Returns ``(net, end_points)``, whose
+    keys are the tf_slim ones: ``layer_1`` .. ``layer_19`` plus the
+    ``layer_N/expansion_output``, ``layer_N/depthwise_output`` and
+    ``layer_N/output`` tensors the tf_slim builder harvests from the graph.
+    """
+
+    def __init__(self, cfg, bn_mode=None, **kwargs):
+        super().__init__(**kwargs)
+        # Deliberately no reference to cfg: tf.keras.Model.__setattr__ rewrites
+        # the lists and dicts it is handed into trackable wrappers, in place,
+        # and DeepLabCut writes pose_cfg back out with yaml.dump.  Only scalars
+        # and fresh copies are kept here; see nnets/base.set_untracked.
+        depth_multiplier, finegrain = MOBILENET_VARIANTS[cfg["net_type"]]
+        if depth_multiplier <= 0:
+            raise ValueError("multiplier is not greater than zero.")
+        self.scope = "MobilenetV2"
+        self.mean_pixel = list(cfg["mean_pixel"])
+        self.depth_multiplier = depth_multiplier
+        # A diagnostic knob, not a tuning one: the shipped behaviour is
+        # BN_PER_IMAGE and the alternatives exist to reproduce the tf_slim bug
+        # and the moving-average variant that was measured and rejected.
+        if bn_mode is None:
+            bn_mode = cfg.get("mobilenet_bn_mode") or BN_PER_IMAGE
+        self.bn_mode = bn_mode
+
+        # mobilenet_v2.mobilenet(): finegrain mode keeps the embedding wide.
+        spec = [dict(entry) for entry in V2_SPEC]
+        if finegrain and depth_multiplier < 1:
+            spec[-1]["num_outputs"] = spec[-1]["num_outputs"] / depth_multiplier
+
+        def md(depth):
+            return _make_divisible(depth * depth_multiplier, 8, 8)
+
+        self.plan = []
+        self.layer_lookup = {}
+        prev_depth = 3
+        n_conv = n_expanded = 0
+        for index, opdef in enumerate(spec):
+            end_point = f"layer_{index + 1}"
+            num_outputs = md(opdef["num_outputs"])
+            if opdef["op"] == "conv":
+                slim_scope = f"{self.scope}/Conv" + (f"_{n_conv}" if n_conv else "")
+                n_conv += 1
+                self._add(slim_scope, MobilenetConv(
+                    slim_scope, num_outputs, opdef["kernel_size"],
+                    strides=opdef["stride"], activation=tf.nn.relu6, bn_mode=bn_mode,
+                ))
+                self.plan.append(("conv", end_point, slim_scope))
+            else:
+                slim_scope = f"{self.scope}/expanded_conv" + (f"_{n_expanded}" if n_expanded else "")
+                n_expanded += 1
+                inner = _make_divisible(
+                    prev_depth * opdef.get("expansion", 6),
+                    opdef.get("expansion_divisible_by", 8),
+                )
+                expand = inner > prev_depth
+                if expand:
+                    self._add(f"{slim_scope}/expand", MobilenetConv(
+                        f"{slim_scope}/expand", inner, 1,
+                        activation=tf.nn.relu6, bn_mode=bn_mode,
+                    ))
+                self._add(f"{slim_scope}/depthwise", SlimDepthwiseConv(
+                    f"{slim_scope}/depthwise", 3, strides=opdef["stride"], bn_mode=bn_mode,
+                ))
+                # the linear bottleneck: project_activation_fn is tf.identity
+                self._add(f"{slim_scope}/project", MobilenetConv(
+                    f"{slim_scope}/project", num_outputs, 1, activation=None, bn_mode=bn_mode,
+                ))
+                residual = opdef["stride"] == 1 and num_outputs == prev_depth
+                self.plan.append(("expanded_conv", end_point, slim_scope, expand, residual))
+            prev_depth = num_outputs
+        self.output_depth = prev_depth
+
+    def _add(self, slim_scope, layer):
+        self.layer_lookup[slim_scope] = layer
+        setattr(self, "_l_" + slim_scope.replace("/", "_").replace(".", "_"), layer)
+        return layer
+
+    def set_bn_mode(self, mode):
+        """Switch every batch norm's inference-time reduction (diagnostics)."""
+        for layer in self.layer_lookup.values():
+            layer.bn.mode = mode
+        self.bn_mode = mode
+
+    def call(self, inputs, training=False):
+        net = tf.cast(inputs, tf.float32) - tf.constant(
+            self.mean_pixel, dtype=tf.float32, shape=[1, 1, 1, 3]
+        )
+        end_points = {}
+        for entry in self.plan:
+            if entry[0] == "conv":
+                _, end_point, slim_scope = entry
+                net = self.layer_lookup[slim_scope](net, training=training)
+            else:
+                _, end_point, slim_scope, expand, residual = entry
+                shortcut = net
+                if expand:
+                    net = self.layer_lookup[f"{slim_scope}/expand"](net, training=training)
+                    end_points[f"{end_point}/expansion_output"] = net
+                net = self.layer_lookup[f"{slim_scope}/depthwise"](net, training=training)
+                end_points[f"{end_point}/depthwise_output"] = net
+                net = self.layer_lookup[f"{slim_scope}/project"](net, training=training)
+                if residual:
+                    net = net + shortcut
+                end_points[f"{end_point}/output"] = net
+            end_points[end_point] = net
+        return net, end_points
