+# ---------------------------------------------------------------------------
+# the caller's pose_cfg must come back exactly as it went in
+# ---------------------------------------------------------------------------
+def _trackable_values(cfg):
+    return {
+        key: type(value).__name__
+        for key, value in cfg.items()
+        if "Wrapper" in type(value).__name__
+    }
+
