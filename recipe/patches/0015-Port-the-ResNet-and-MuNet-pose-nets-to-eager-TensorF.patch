+"""The Keras pose nets must agree with the ``tf_slim`` ones tensor for tensor.
+
+``core/train.py`` calls ``tf.compat.v1.disable_eager_execution()`` at import,
+so the two engines cannot share a process.  Each side therefore runs in its own
+subprocess: ``slim`` writes a snapshot plus its outputs, ``keras`` loads that
+snapshot and compares.  Run this file directly to see the numbers:
+
+    python tests/test_nnets_keras_equivalence.py slim /tmp/out r50
+    python tests/test_nnets_keras_equivalence.py keras /tmp/out r50
+"""
+import json
+import os
+import subprocess
+import sys
+
+import pytest
+
+pytest.importorskip("tensorflow")
+pytest.importorskip("tf_slim")
+
+#: max |delta| accepted between the two engines, in the units of each tensor.
+#:
+#: The nets here are randomly initialised -- no project and no ImageNet
+#: download -- so their batch norms normalise with a moving_variance of 1 while
+#: the activations they see are far larger, and the values coming out of a
+#: 53-layer stack are enormous.  float32 keeps ~1e-7 of relative precision, so a
+#: relative bound is the meaningful one at that magnitude and the absolute bound
+#: is what applies to a normally-scaled tensor.  With real ImageNet weights
+#: restored, every tensor of every configuration agrees to 9.4e-06 absolute.
+ATOL = 2e-4
+#: max relative |delta| (against the largest reference value) accepted instead.
+RTOL = 1e-5
+#: see _slim_worker: keeps a randomly initialised net numerically sane.
+WEIGHT_SCALE = 0.05
+#: so the random weights, and therefore the score map, are the same every run.
+SEED = 20260905
+#: max |delta| accepted on a predicted keypoint, in pixels.
+POSE_ATOL = 1e-3
+
+
+def _pose_cfg(**kwargs):
+    cfg = {
+        "stride": 8.0,
+        "weigh_part_predictions": False,
+        "mean_pixel": [123.68, 116.779, 103.939],
+        "location_refinement": True,
+        "locref_stdev": 7.2801,
+        "locref_loss_weight": 1.0,
+        "locref_huber_loss": True,
+        "intermediate_supervision": False,
+        "intermediate_supervision_layer": 3,
+        "weight_decay": 0.0001,
+        "batch_size": 1,
+        "dataset_type": "imgaug",
+        "pairwise_huber_loss": True,
+        "pairwise_predict": False,
+        "partaffinityfield_predict": False,
+        "num_joints": 4,
+        "num_limbs": 0,
+        "net_type": "resnet_50",
+        "multi_stage": False,
+        "pairwise_loss_weight": 1.0,
+        "nmsradius": 5,
+        "minconfidence": 0.01,
+        "sigma": 1,
+        "locref_smooth": False,
+    }
+    cfg.update(kwargs)
+    return cfg
+
+
+def _multi_animal(**kwargs):
+    return _pose_cfg(
+        num_joints=6,
+        num_limbs=5,
+        dataset_type="multi-animal-imgaug",
+        partaffinityfield_predict=True,
+        pairwise_predict=True,
+        **kwargs,
+    )
+
+
+#: ``name -> (cfg, [(height, width), ...])``
+CASES = {
+    "resnet50": (_pose_cfg(), [(200, 168), (201, 169), (99, 101)]),
+    "resnet50_paf": (_multi_animal(), [(200, 168), (161, 129)]),
+    "resnet50_batch4": (_pose_cfg(batch_size=4), [(200, 168)]),
+    "munet_stride4": (_multi_animal(stride=4, multi_stage=True), [(200, 168), (201, 169)]),
+    "dual_fusion_stride4": (_multi_animal(stride=4), [(200, 168)]),
+}
+
+
+def _images(cfg, size):
+    import numpy as np
+
+    rng = np.random.RandomState(abs(hash((size, cfg["batch_size"], cfg["num_joints"]))) % (2**31 - 1))
+    return rng.uniform(0, 255, (cfg["batch_size"], size[0], size[1], 3))
+
+
+# ---------------------------------------------------------------------------
+# workers
+# ---------------------------------------------------------------------------
+def _slim_worker(outdir, case):
+    import numpy as np
+    import tensorflow as tf
+
+    from deeplabcut.pose_estimation_tensorflow.nnets.factory import PoseNetFactory
+
+    cfg, sizes = CASES[case]
+    os.makedirs(outdir, exist_ok=True)
+    graph = tf.Graph()
+    with graph.as_default():
+        tf.compat.v1.set_random_seed(SEED)
+        inputs = tf.compat.v1.placeholder(tf.float32, [cfg["batch_size"], None, None, 3])
+        heads = PoseNetFactory.create(cfg).get_net(inputs, is_training=False)
+        session = tf.compat.v1.Session(graph=graph)
+        session.run(tf.compat.v1.global_variables_initializer())
+        # No project and no ImageNet download here, so the weights are random.
+        # Left as initialised, every batch norm would normalise by a
+        # moving_variance of 1 while seeing far larger activations, and 53
+        # stacked layers would blow the outputs up to ~1e5, where float32 noise
+        # swamps an absolute comparison and the score map saturates.  Shrinking
+        # the kernels keeps the residual branches small, so the net stays
+        # well-conditioned and the comparison is meaningful in absolute terms.
+        session.run([
+            tf.compat.v1.assign(v, v * WEIGHT_SCALE)
+            for v in tf.compat.v1.global_variables()
+            if v.op.name.endswith("/weights")
+        ])
+        # ... and then rescale the last kernel of each head so its logits have
+        # unit spread.  Without that the score map is flat to within float32
+        # noise and argmax_pose_predict picks between ties, which says nothing
+        # about the two engines.  The biases are still zero, so this scales a
+        # head's output exactly linearly.
+        probe = _images(cfg, sizes[0])
+        for head, key in (("part_pred", "part_pred"), ("locref_pred", "locref")):
+            if key not in heads:
+                continue
+            spread = float(session.run(heads[key], feed_dict={inputs: probe}).std())
+            if not spread:
+                continue
+            final = [
+                v
+                for v in tf.compat.v1.global_variables()
+                if v.op.name.startswith(f"pose/{head}/") and v.op.name.endswith("/weights")
+            ]
+            session.run([tf.compat.v1.assign(v, v / spread) for v in final])
+        ckpt = tf.compat.v1.train.Saver().save(session, os.path.join(outdir, "snapshot"), global_step=7)
+        keys = sorted(k for k in heads if k != "features")
+        for size in sizes:
+            images = _images(cfg, size)
+            np.save(os.path.join(outdir, f"in_{size[0]}x{size[1]}.npy"), images)
+            result = session.run({k: heads[k] for k in keys}, feed_dict={inputs: images})
+            np.savez(os.path.join(outdir, f"out_{size[0]}x{size[1]}.npz"), **result)
+        variables = {v.op.name: [int(d) for d in v.shape] for v in tf.compat.v1.global_variables()}
+        session.close()
+    json.dump(
+        {"ckpt": ckpt, "keys": keys, "variables": variables},
+        open(os.path.join(outdir, "slim.json"), "w"),
+        indent=1,
+        sort_keys=True,
+    )
+
+
+def _keras_worker(outdir, case):
+    import numpy as np
+    import tensorflow as tf
+
+    from deeplabcut.pose_estimation_tensorflow.nnets import (
+        PoseNetFactory,
+        ensure_eager_execution,
+        load_tf1_checkpoint,
+    )
+    from deeplabcut.pose_estimation_tensorflow.nnets.factory import KERAS_ENGINE
+
+    ensure_eager_execution()
+    cfg, sizes = CASES[case]
+    reference = json.load(open(os.path.join(outdir, "slim.json")))
+
+    model = PoseNetFactory.create(cfg, engine=KERAS_ENGINE)
+    first = np.load(os.path.join(outdir, f"in_{sizes[0][0]}x{sizes[0][1]}.npy"))
+    model(tf.constant(first, dtype=tf.float32))
+
+    weight_map = model.slim_weight_map()
+    verdict = {
+        "n_slim_variables": len(reference["variables"]),
+        "n_mapped": len(weight_map),
+        "n_unmapped_keras_weights": len(model.unmapped_weights()),
+        "names_only_in_slim": sorted(set(reference["variables"]) - set(weight_map)),
+        "names_only_in_keras": sorted(set(weight_map) - set(reference["variables"])),
+        "shape_mismatches": sorted(
+            name
+            for name in set(weight_map) & set(reference["variables"])
+            if list(weight_map[name].shape) != reference["variables"][name]
+        ),
+        "sizes": {},
+    }
+    report = load_tf1_checkpoint(model, reference["ckpt"], allow_missing=True)
+    verdict["n_loaded"] = len(report.loaded)
+    verdict["n_checkpoint_tensors_unused"] = len(report.unused)
+
+    poses = []
+    for size in sizes:
+        images = np.load(os.path.join(outdir, f"in_{size[0]}x{size[1]}.npy"))
+        tensor = tf.constant(images, dtype=tf.float32)
+        got = model(tensor)
+        ref = dict(np.load(os.path.join(outdir, f"out_{size[0]}x{size[1]}.npz")))
+        errors = {}
+        for key in sorted(ref):
+            a, b = ref[key], got[key].numpy()
+            if a.shape != b.shape:
+                errors[key] = f"shape {a.shape} != {b.shape}"
+            else:
+                delta = float(np.abs(a - b).max())
+                errors[key] = [delta, delta / (float(np.abs(a).max()) + 1e-30)]
+        verdict["sizes"][f"{size[0]}x{size[1]}"] = errors
+        if cfg["batch_size"] == 1 and "locref" in ref:
+            poses.append(
+                (
+                    f"{size[0]}x{size[1]}",
+                    1.0 / (1.0 + np.exp(-ref["part_pred"])),
+                    ref["locref"],
+                    tf.sigmoid(got["part_pred"]).numpy(),
+                    got["locref"].numpy(),
+                )
+            )
+
+    # numpy only from here, so it is safe to pull in the rest of the engine
+    from deeplabcut.pose_estimation_tensorflow.core import predict as dlc_predict
+
+    verdict["pose"] = {}
+    for name, ref_scmap, ref_locref, got_scmap, got_locref in poses:
+        first_pose = dlc_predict.argmax_pose_predict(
+            *dlc_predict.extract_cnn_output([ref_scmap, ref_locref], cfg), cfg["stride"]
+        )
+        second_pose = dlc_predict.argmax_pose_predict(
+            *dlc_predict.extract_cnn_output([got_scmap, got_locref], cfg), cfg["stride"]
+        )
+        margins = []
+        for joint in range(ref_scmap.shape[-1]):
+            ordered = np.sort(ref_scmap[0, :, :, joint].ravel())[::-1]
+            margins.append(float(ordered[0] - ordered[1]))
+        verdict["pose"][name] = {
+            "max_delta_xy_px": float(np.abs(first_pose[:, :2] - second_pose[:, :2]).max()),
+            "max_delta_likelihood": float(np.abs(first_pose[:, 2] - second_pose[:, 2]).max()),
+            "n_joints": int(first_pose.shape[0]),
+            "smallest_peak_margin": min(margins),
+        }
+    json.dump(verdict, open(os.path.join(outdir, "verdict.json"), "w"), indent=1, sort_keys=True)
+
+
+# ---------------------------------------------------------------------------
+# the test
+# ---------------------------------------------------------------------------
+def _run(mode, outdir, case):
+    env = dict(os.environ, TF_CPP_MIN_LOG_LEVEL="3")
+    completed = subprocess.run(
+        [sys.executable, os.path.abspath(__file__), mode, outdir, case],
+        env=env,
+        capture_output=True,
+        text=True,
+    )
+    if completed.returncode:
+        raise AssertionError(f"{mode} worker for {case} failed:\n{completed.stdout}\n{completed.stderr}")
+
+
+@pytest.mark.parametrize("case", sorted(CASES))
+def test_keras_matches_tf_slim(tmp_path, case):
+    outdir = str(tmp_path / case)
+    _run("slim", outdir, case)
+    _run("keras", outdir, case)
+    verdict = json.load(open(os.path.join(outdir, "verdict.json")))
+
+    assert verdict["names_only_in_slim"] == []
+    assert verdict["names_only_in_keras"] == []
+    assert verdict["shape_mismatches"] == []
+    assert verdict["n_unmapped_keras_weights"] == 0
+    assert verdict["n_mapped"] == verdict["n_slim_variables"]
+    assert verdict["n_loaded"] == verdict["n_slim_variables"]
+    assert verdict["n_checkpoint_tensors_unused"] == 0
+
+    for size, errors in verdict["sizes"].items():
+        for key, error in errors.items():
+            assert isinstance(error, list), f"{case} {size} {key}: {error}"
+            absolute, relative = error
+            assert absolute < ATOL or relative < RTOL, (
+                f"{case} {size} {key}: max |delta| = {absolute} ({relative} relative)"
+            )
+
+    for size, pose in verdict["pose"].items():
+        # A peak is only well defined if it stands clear of the runner-up by more
+        # than the two engines disagree; otherwise argmax is a coin flip and
+        # comparing the keypoints would say nothing.
+        assert pose["smallest_peak_margin"] > 10 * max(pose["max_delta_likelihood"], 1e-9), (
+            f"{case} {size}: degenerate score map {pose}"
+        )
+        assert pose["max_delta_xy_px"] < POSE_ATOL, f"{case} {size}: {pose}"
+
+
+if __name__ == "__main__":
+    mode, outdir, case = sys.argv[1], sys.argv[2], sys.argv[3]
+    {"slim": _slim_worker, "keras": _keras_worker}[mode](outdir, case)
