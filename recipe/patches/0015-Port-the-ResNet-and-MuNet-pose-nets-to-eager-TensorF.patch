@@ -76,3 +82,187 @@ class PoseResnet(BasePoseNet):
     def get_net(self, inputs, is_training=False):
         net, end_points = self.extract_features(inputs)
         return self.prediction_layers(net, end_points)
+
+
+# ---------------------------------------------------------------------------
+# TensorFlow 2 / Keras implementation
+# ---------------------------------------------------------------------------
+
+#: ``resnet_arg_scope()`` is called with no arguments, so the backbone's weight
+#: decay is 1e-4 regardless of ``pose_cfg.yaml``'s ``weight_decay``.
+RESNET_ARG_SCOPE_WEIGHT_DECAY = 0.0001
+
+#: ``slim.variance_scaling_initializer()``, the ``resnet_arg_scope`` default.
+RESNET_KERNEL_INIT = dict(scale=2.0, mode="fan_in", distribution="truncated_normal")
+
+#: ``(base_depth, num_units, stride)`` per block, from ``resnet_v1.resnet_v1_50``
+#: and friends.  ``resnet_v1_block`` puts the stride on the LAST unit of a
+#: block; ``tf.keras.applications.ResNet50`` puts it on the first, which is why
+#: that model cannot be used here.
+RESNET_BLOCKS = {
+    "resnet_50": [(64, 3, 2), (128, 4, 2), (256, 6, 2), (512, 3, 1)],
+    "resnet_101": [(64, 3, 2), (128, 4, 2), (256, 23, 2), (512, 3, 1)],
+    "resnet_152": [(64, 3, 2), (128, 8, 2), (256, 36, 2), (512, 3, 1)],
+}
+
+
+def _resnet_conv(slim_scope, filters, kernel_size, strides=1, rate=1, activation=tf.nn.relu, explicit_pad=False):
+    return SlimConv(
+        slim_scope,
+        filters,
+        kernel_size,
+        strides=strides,
+        rate=rate,
+        explicit_pad=explicit_pad,
+        use_bn=True,
+        bn_scale=RESNET_BN_SCALE,
+        bn_decay=RESNET_BN_DECAY,
+        bn_epsilon=RESNET_BN_EPSILON,
+        activation=activation,
+        weight_decay=RESNET_ARG_SCOPE_WEIGHT_DECAY,
+        kernel_initializer=tf.keras.initializers.VarianceScaling(**RESNET_KERNEL_INIT),
+    )
+
+
+class BottleneckV1(tf.keras.layers.Layer):
+    """One ``resnet_v1.bottleneck`` unit."""
+
+    def __init__(self, slim_scope, depth, depth_bottleneck, stride, rate, depth_in, **kwargs):
+        super().__init__(name=slim_scope.replace("/", "."), **kwargs)
+        self.slim_scope = slim_scope
+        self.stride = stride
+        # slim only builds a projection shortcut when the depth changes;
+        # otherwise it subsamples with a 1x1 max pool (SAME, per resnet_arg_scope).
+        self.shortcut = (
+            None if depth == depth_in else _resnet_conv(f"{slim_scope}/shortcut", depth, 1, strides=stride, activation=None)
+        )
+        self.conv1 = _resnet_conv(f"{slim_scope}/conv1", depth_bottleneck, 1)
+        # conv2 is resnet_utils.conv2d_same: explicit pad + VALID once stride > 1
+        self.conv2 = _resnet_conv(
+            f"{slim_scope}/conv2",
+            depth_bottleneck,
+            3,
+            strides=stride,
+            rate=rate,
+            explicit_pad=stride > 1,
+        )
+        self.conv3 = _resnet_conv(f"{slim_scope}/conv3", depth, 1, activation=None)
+
+    def call(self, inputs, training=False):
+        if self.shortcut is not None:
+            shortcut = self.shortcut(inputs, training=training)
+        elif self.stride == 1:
+            shortcut = inputs
+        else:
+            shortcut = tf.nn.max_pool2d(inputs, 1, strides=self.stride, padding="SAME")
+        residual = self.conv1(inputs, training=training)
+        residual = self.conv2(residual, training=training)
+        residual = self.conv3(residual, training=training)
+        return tf.nn.relu(shortcut + residual)
+
+
+@KerasBackboneFactory.register("resnet")
+class SlimResNetV1(tf.keras.Model):
+    """``resnet_v1_{50,101,152}`` with ``tf_slim``'s exact layer semantics.
+
+    Takes raw images and subtracts ``cfg["mean_pixel"]`` itself, mirroring
+    ``PoseResnet.extract_features``.  Returns ``(net, end_points)``.
+    """
+
+    def __init__(self, cfg, output_stride=16, **kwargs):
+        super().__init__(**kwargs)
+        net_type = cfg["net_type"]
+        num_layers = re.findall("resnet_([0-9]*)", net_type)[0]
+        self.scope = f"resnet_v1_{num_layers}"
+        self.mean_pixel = list(cfg["mean_pixel"])
+        self.output_stride = output_stride
+        self.conv1 = _resnet_conv(f"{self.scope}/conv1", 64, 7, strides=2, explicit_pad=True)
+        # resnet_arg_scope() overrides slim's VALID default for max_pool2d.
+        self.pool1 = tf.keras.layers.MaxPool2D(3, strides=2, padding="same")
+
+        # stack_blocks_dense's stride/rate bookkeeping, done once at build time
+        current_stride, rate = 1, 1
+        target_stride = output_stride // 4
+        self.units = []
+        self.unit_names = []
+        depth_in = 64
+        for block_index, (base_depth, num_units, block_stride) in enumerate(
+            RESNET_BLOCKS[f"resnet_{num_layers}"], start=1
+        ):
+            for unit_index in range(1, num_units + 1):
+                unit_stride = block_stride if unit_index == num_units else 1
+                if current_stride == target_stride:
+                    effective_stride, effective_rate = 1, rate
+                    rate *= unit_stride
+                else:
+                    effective_stride, effective_rate = unit_stride, 1
+                    current_stride *= unit_stride
+                slim_scope = f"{self.scope}/block{block_index}/unit_{unit_index}/bottleneck_v1"
+                self.units.append(
+                    BottleneckV1(
+                        slim_scope,
+                        base_depth * 4,
+                        base_depth,
+                        effective_stride,
+                        effective_rate,
+                        depth_in,
+                    )
+                )
+                self.unit_names.append((slim_scope, block_index, unit_index == num_units))
+                depth_in = base_depth * 4
+
+    def call(self, inputs, training=False):
+        x = tf.cast(inputs, tf.float32) - tf.constant(
+            self.mean_pixel, dtype=tf.float32, shape=[1, 1, 1, 3]
+        )
+        x = self.conv1(x, training=training)
+        x = self.pool1(x)
+        end_points = {}
+        for unit, (slim_scope, block_index, is_last) in zip(self.units, self.unit_names):
+            x = unit(x, training=training)
+            end_points[slim_scope] = x
+            if is_last:
+                end_points[f"{self.scope}/block{block_index}"] = x
+        return x, end_points
+
+
+@PoseNetFactory.register("resnet", engine=KERAS_ENGINE)
+class PoseResnetKeras(BaseKerasPoseNet):
+    """Keras twin of :class:`PoseResnet`."""
+
+    def __init__(self, cfg):
+        super().__init__(cfg)
+        self.backbone = KerasBackboneFactory.create(cfg)
+        n_joints = cfg["num_joints"]
+        self._add_head("part_pred", "pose/part_pred/block4", n_joints + cfg.get("num_idchannel", 0))
+        if cfg["location_refinement"]:
+            self._add_head("locref", "pose/locref_pred/block4", n_joints * 2)
+        if cfg["pairwise_predict"] and "multi-animal" not in cfg["dataset_type"]:
+            self._add_head("pairwise_pred", "pose/pairwise_pred/block4", n_joints * (n_joints - 1) * 2)
+        if cfg["partaffinityfield_predict"] and "multi-animal" in cfg["dataset_type"]:
+            self._add_head("pairwise_pred", "pose/pairwise_pred/block4", cfg["num_limbs"] * 2)
+        if cfg["intermediate_supervision"]:
+            num_layers = re.findall("resnet_([0-9]*)", cfg["net_type"])[0]
+            self.interm_end_point = (
+                f"resnet_v1_{num_layers}/block3/unit_{cfg['intermediate_supervision_layer']}/bottleneck_v1"
+            )
+            self._add_head(
+                "part_pred_interm",
+                "pose/intermediate_supervision/block4",
+                n_joints + cfg.get("num_idchannel", 0),
+            )
+
+    def extract_features(self, inputs, is_training=False):
+        # PoseResnet passes is_training=False to resnet_v1 unconditionally, so
+        # the backbone's batch norm always uses its moving statistics and never
+        # updates them.  Reproduced here on purpose.
+        return self.backbone(inputs, training=False)
+
+    def prediction_layers(self, features, end_points, is_training=False):
+        out = {"features": features}
+        for key, layer in self._heads.items():
+            if key == "part_pred_interm":
+                out[key] = layer(end_points[self.interm_end_point], training=is_training)
+            else:
+                out[key] = layer(features, training=is_training)
+        return out
