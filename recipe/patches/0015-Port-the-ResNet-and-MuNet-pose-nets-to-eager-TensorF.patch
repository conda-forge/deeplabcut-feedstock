+"""Read and write TF1 (``tf_slim``) checkpoints from the Keras pose nets.
+
+Snapshots written by the ``tf_slim`` engine, and the ImageNet backbones
+DeepLabCut downloads, are name-based TF1 checkpoints.  The Keras pose nets keep
+the ``tf_slim`` name of every weight they own (see
+``BaseKerasPoseNet.slim_weight_map``), so conversion is a lookup in both
+directions and no re-training or graph surgery is involved:
+
+    load_tf1_checkpoint(model, "dlc-models/.../snapshot-10000")
+    save_tf1_checkpoint(model, "snapshot", global_step=10000)
+
+A checkpoint written here restores into the unmodified ``tf_slim`` graph with
+``tf.compat.v1.train.Saver().restore``, which is what keeps the two engines
+interchangeable while the migration is in progress.
+"""
+import os
+
+import numpy as np
+import tensorflow as tf
+
+#: Bookkeeping tensors a DeepLabCut snapshot carries that no layer owns.
+NON_WEIGHT_TENSORS = ("global_step", "save_counter", "_CHECKPOINTABLE_OBJECT_GRAPH")
+
+
+class CheckpointReport:
+    """What ``load_tf1_checkpoint`` did.
+
+    ``loaded`` are the ``tf_slim`` names assigned, ``missing`` the model
+    weights the checkpoint had nothing for, ``unused`` the checkpoint tensors
+    no weight claimed, and ``mismatched`` the ``(name, ckpt_shape,
+    model_shape)`` triples that could not be assigned.
+    """
+
+    def __init__(self, loaded, missing, unused, mismatched):
+        self.loaded = sorted(loaded)
+        self.missing = sorted(missing)
+        self.unused = sorted(unused)
+        self.mismatched = sorted(mismatched)
+
+    @property
+    def ok(self):
+        return not self.missing and not self.mismatched
+
+    def __repr__(self):
+        return (
+            f"<CheckpointReport loaded={len(self.loaded)} missing={len(self.missing)} "
+            f"unused={len(self.unused)} mismatched={len(self.mismatched)}>"
+        )
+
+
+def _weight_map(model, include_prefixes=None):
+    weights = model.slim_weight_map()
+    if include_prefixes is not None:
+        weights = {k: v for k, v in weights.items() if k.startswith(tuple(include_prefixes))}
+    return weights
+
+
+def load_tf1_checkpoint(model, ckpt_path, include_prefixes=None, allow_missing=False, verbose=False):
+    """Assign a TF1 checkpoint's tensors to a Keras pose net's weights.
+
+    ``include_prefixes`` restricts the load the way
+    ``slim.get_variables_to_restore(include=[...])`` does, which is how a bare
+    ImageNet backbone checkpoint is loaded into a full pose net.
+    """
+    reader = tf.train.load_checkpoint(ckpt_path)
+    available = reader.get_variable_to_shape_map()
+    weights = _weight_map(model, include_prefixes)
+
+    loaded, missing, mismatched = [], [], []
+    for name, variable in weights.items():
+        if name not in available:
+            missing.append(name)
+            continue
+        value = reader.get_tensor(name)
+        if tuple(value.shape) != tuple(variable.shape):
+            mismatched.append((name, tuple(value.shape), tuple(variable.shape)))
+            continue
+        variable.assign(value)
+        loaded.append(name)
+
+    unused = [
+        name
+        for name in available
+        if name not in weights and not name.startswith(NON_WEIGHT_TENSORS)
+    ]
+    report = CheckpointReport(loaded, missing, unused, mismatched)
+    if verbose:
+        print(f"[checkpoint] {ckpt_path}: {report}")
+    if not allow_missing and not report.ok:
+        raise ValueError(
+            f"{ckpt_path} does not match this model: {len(report.missing)} weights missing "
+            f"(e.g. {report.missing[:3]}), {len(report.mismatched)} shape mismatches "
+            f"(e.g. {report.mismatched[:3]})"
+        )
+    return report
+
+
+def tf1_weight_values(model):
+    """``{tf_slim variable name: numpy array}`` for every weight of the model."""
+    return {name: variable.numpy() for name, variable in model.slim_weight_map().items()}
+
+
+def save_tf1_checkpoint(model, prefix, global_step=None, extra=None, write_state=True):
+    """Write the model's weights as a name-based TF1 checkpoint.
+
+    Returns the checkpoint prefix actually written, i.e. ``prefix`` with
+    ``-<global_step>`` appended when a step is given, matching
+    ``tf.compat.v1.train.Saver.save``.
+    """
+    tensors = dict(tf1_weight_values(model))
+    if extra:
+        tensors.update(extra)
+    if global_step is not None:
+        tensors.setdefault("global_step", np.int64(global_step))
+        prefix = f"{prefix}-{int(global_step)}"
+
+    directory = os.path.dirname(os.path.abspath(prefix))
+    os.makedirs(directory, exist_ok=True)
+
+    names = sorted(tensors)
+    tf.raw_ops.SaveV2(
+        prefix=tf.constant(prefix),
+        tensor_names=tf.constant(names),
+        shape_and_slices=tf.constant([""] * len(names)),
+        tensors=[tf.convert_to_tensor(tensors[n]) for n in names],
+    )
+    if write_state:
+        base = os.path.basename(prefix)
+        with open(os.path.join(directory, "checkpoint"), "w") as handle:
+            handle.write(f'model_checkpoint_path: "{base}"\n')
+            handle.write(f'all_model_checkpoint_paths: "{base}"\n')
+    return prefix
+
+
+def compare_to_tf1_checkpoint(model, ckpt_path):
+    """Per-tensor max absolute difference between a model and a checkpoint."""
+    reader = tf.train.load_checkpoint(ckpt_path)
+    available = reader.get_variable_to_shape_map()
+    diffs = {}
+    for name, variable in model.slim_weight_map().items():
+        if name not in available:
+            diffs[name] = float("inf")
+            continue
+        diffs[name] = float(np.abs(reader.get_tensor(name) - variable.numpy()).max())
+    return diffs
