+def ensure_eager_execution():
+    """Make sure eager execution is on, and say so loudly when it cannot be.
+
+    ``pose_estimation_tensorflow/core/train.py`` calls
+    ``tf.compat.v1.disable_eager_execution()`` at import time, which turns
+    eager off for the whole process, including for code that never touches the
+    TF1 engine.  Until that call is gone the Keras pose nets have to turn it
+    back on.  That only works before any TF1 graph has been built, which is why
+    this raises instead of silently returning a graph-mode model.
+    """
+    if tf.executing_eagerly():
+        return
+    try:
+        tf.compat.v1.enable_eager_execution()
+    except ValueError as err:  # a TF1 graph already exists in this process
+        raise RuntimeError(
+            "The Keras pose nets need eager execution, but this process has "
+            "already built a TF1 graph. Run the TF1 and the Keras engine in "
+            "separate processes."
+        ) from err
+
+
+class BaseKerasPoseNet(tf.keras.Model, BasePoseNet):
+    """Eager TensorFlow 2 counterpart of :class:`BasePoseNet`.
+
+    Subclasses build their layers in ``__init__`` and implement
+    ``extract_features``.  Everything a caller needs is inherited or defined
+    here:
+
+    * ``extract_features(inputs, is_training=False) -> (net, end_points)``
+    * ``get_net(inputs, is_training=False) -> dict`` with the same keys the
+      ``tf_slim`` nets return (``part_pred``, ``locref``, ``features`` and,
+      where the config asks for them, ``pairwise_pred`` and
+      ``part_pred_interm``)
+    * ``__call__``/``call`` are the Keras entry points and forward to
+      ``get_net``
+    * ``slim_weight_map() -> {tf_slim variable name: tf.Variable}``, which is
+      what ``nnets/checkpoint.py`` uses to read and write TF1 checkpoints
+    * ``test``, ``inference``, ``add_inference_layers`` and ``train`` come
+      straight from :class:`BasePoseNet` and work unchanged in eager mode
+
+    There is no ``Session``, no placeholder, no ``variable_scope`` and no
+    ``arg_scope``: the ``tf_slim`` scope names survive only as strings, in the
+    ``slim_scope`` of each layer.
+    """
+
+    def __init__(self, cfg, **kwargs):
+        ensure_eager_execution()
+        tf.keras.Model.__init__(self, **kwargs)
+        self.cfg = cfg
+        self._heads = {}
+
+    # -- layer construction helpers ----------------------------------------
+    def _add_head(self, key, slim_scope, num_outputs, stage=False):
+        factory = keras_prediction_layer_stage if stage else keras_prediction_layer
+        layer = factory(self.cfg, slim_scope, num_outputs)
+        self._heads[key] = layer
+        setattr(self, "_head_" + slim_scope.replace("/", "_"), layer)
+        return layer
+
+    # -- the contract ------------------------------------------------------
+    def extract_features(self, inputs, is_training=False):
+        raise NotImplementedError
+
+    def prediction_layers(self, features, end_points, is_training=False):
+        raise NotImplementedError
+
+    def get_net(self, inputs, is_training=False):
+        features, end_points = self.extract_features(inputs, is_training=is_training)
+        return self.prediction_layers(features, end_points, is_training=is_training)
+
+    def call(self, inputs, training=False):
+        return self.get_net(inputs, is_training=training)
+
+    # -- checkpoint plumbing -----------------------------------------------
+    def slim_weight_map(self):
+        """Map every checkpointed weight to the ``tf_slim`` name it had.
+
+        Any submodule exposing ``slim_weights()`` contributes, so a backbone
+        added later only has to implement that one method to become
+        checkpoint-compatible.
+        """
+        if not self.built and not self.weights:
+            raise RuntimeError(
+                "Call the model once (or build_for(...)) before asking for its "
+                "weight map: Keras creates the weights lazily."
+            )
+        out = {}
+        for module in self.submodules:
+            fn = getattr(module, "slim_weights", None)
+            if fn is None:
+                continue
+            for name, variable in fn().items():
+                if name in out and out[name] is not variable:
+                    raise ValueError(f"two layers claim the tf_slim name {name!r}")
+                out[name] = variable
+        return out
+
+    def unmapped_weights(self):
+        """Variables of this model that ``slim_weight_map()`` does not cover."""
+        mapped = {id(v) for v in self.slim_weight_map().values()}
+        return [v for v in self.weights if id(v) not in mapped]
+
+    def build_for(self, input_shape):
+        """Create the weights by running one zero batch of ``input_shape``."""
+        self(tf.zeros(input_shape, dtype=tf.float32))
+        return self
