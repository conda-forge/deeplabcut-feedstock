+import os
 import warnings
 
+#: The graph-mode ``tf_slim`` implementation.  Still the default.
+TF1_ENGINE = "tf1"
+#: The eager ``tf.keras`` implementation.
+KERAS_ENGINE = "keras"
+DEFAULT_ENGINE = TF1_ENGINE
+#: Environment variable consulted when ``pose_cfg.yaml`` says nothing.
+ENGINE_ENV_VAR = "DLC_TF_ENGINE"
+
+
+def resolve_engine(cfg=None):
+    """Pick the pose-net implementation to build.
+
+    ``pose_cfg.yaml``'s ``tf_engine`` key wins; otherwise the ``DLC_TF_ENGINE``
+    environment variable; otherwise :data:`DEFAULT_ENGINE`.
+    """
+    engine = None
+    if cfg is not None:
+        engine = cfg.get("tf_engine")
+    if not engine:
+        engine = os.environ.get(ENGINE_ENV_VAR)
+    if not engine:
+        engine = DEFAULT_ENGINE
+    engine = str(engine).strip().lower()
+    if engine not in (TF1_ENGINE, KERAS_ENGINE):
+        raise ValueError(
+            f"Unknown pose-net engine {engine!r}; expected {TF1_ENGINE!r} or {KERAS_ENGINE!r}"
+        )
+    return engine
+
+
+class _PrefixRegistry:
+    """Registry keyed by a substring of ``net_type``, as DeepLabCut has always done."""
+
+    def __init__(self, what):
+        self._what = what
+        self._entries = {}
+
+    def register(self, type_):
+        def wrapper(obj):
+            if type_ in self._entries:
+                warnings.warn(f"Overwriting existing {self._what} {type_}.", stacklevel=2)
+            self._entries[type_] = obj
+            return obj
+
+        return wrapper
+
+    def lookup(self, net_type):
+        key = _find_matching_key(self._entries, net_type)
+        if key is None:
+            return None
+        return self._entries[key]
+
+    def __contains__(self, net_type):
+        return self.lookup(net_type) is not None
+
+    def keys(self):
+        return self._entries.keys()
+
+
+def _find_matching_key(dict_, key):
+    try:
+        match = next(k for k in dict_ if k in key)
+    except StopIteration:
+        match = None
+    return match
+
 
 class PoseNetFactory:
     _nets = dict()
+    _keras_nets = _PrefixRegistry("Keras network")
 
     @classmethod
-    def register(cls, type_):
+    def register(cls, type_, engine=TF1_ENGINE):
+        if engine == KERAS_ENGINE:
+            return cls._keras_nets.register(type_)
+
         def wrapper(net):
             if type_ in cls._nets:
                 warnings.warn(f"Overwriting existing network {type_}.", stacklevel=2)
