+            bank_3 = self.decoder_parallel_1(bank_3, training=is_training)
+            upsampled_features = self.upsample_block4(features, training=is_training)
+            net = tf.concat([bank_3, upsampled_features], 3)
+            out = {}
+            for key in ("part_pred", "locref", "pairwise_pred"):
+                if key in self._heads:
+                    out[key] = self._heads[key](net, training=is_training)
+            if "part_pred_interm" in self._heads:
+                out["part_pred_interm"] = self._heads["part_pred_interm"](
+                    end_points[self.interm_end_point], training=is_training
+                )
+        out["features"] = features
+        return out
