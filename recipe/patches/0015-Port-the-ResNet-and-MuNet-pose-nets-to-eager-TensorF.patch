+"""Tests for the eager TensorFlow 2 pose nets in ``nnets/``.
+
+These never build a TF1 graph.  The comparison against the ``tf_slim``
+implementation lives in ``test_nnets_keras_equivalence.py``, which has to run
+the two engines in separate processes.
+"""
+import numpy as np
+import pytest
+
+tf = pytest.importorskip("tensorflow")
+
+from deeplabcut.pose_estimation_tensorflow.nnets import (  # noqa: E402
+    KERAS_ENGINE,
+    TF1_ENGINE,
+    PoseNetFactory,
+    ensure_eager_execution,
+    load_tf1_checkpoint,
+    save_tf1_checkpoint,
+)
+from deeplabcut.pose_estimation_tensorflow.nnets.factory import (  # noqa: E402
+    ENGINE_ENV_VAR,
+    resolve_engine,
+)
+
+
+@pytest.fixture(scope="module", autouse=True)
+def eager():
+    """Turn eager on for this module only.
+
+    ``core/train.py`` disables it process-wide at import, and the TF1 tests
+    that run after this file need it left that way, so the flag is restored.
+    """
+    was_eager = tf.executing_eagerly()
+    try:
+        ensure_eager_execution()
+    except RuntimeError as err:  # a TF1 graph was built earlier in this process
+        pytest.skip(str(err))
+    yield
+    if not was_eager:
+        tf.compat.v1.disable_eager_execution()
+
+
+def pose_cfg(**kwargs):
+    cfg = {
+        "stride": 8.0,
+        "weigh_part_predictions": False,
+        "mean_pixel": [123.68, 116.779, 103.939],
+        "location_refinement": True,
+        "locref_stdev": 7.2801,
+        "locref_loss_weight": 1.0,
+        "locref_huber_loss": True,
+        "intermediate_supervision": False,
+        "intermediate_supervision_layer": 3,
+        "weight_decay": 0.0001,
+        "batch_size": 1,
+        "dataset_type": "imgaug",
+        "pairwise_huber_loss": True,
+        "pairwise_predict": False,
+        "partaffinityfield_predict": False,
+        "num_joints": 4,
+        "num_limbs": 0,
+        "net_type": "resnet_50",
+        "multi_stage": False,
+        "pairwise_loss_weight": 1.0,
+    }
+    cfg.update(kwargs)
+    return cfg
+
+
+def multi_animal_cfg(**kwargs):
+    return pose_cfg(
+        num_joints=6,
+        num_limbs=5,
+        dataset_type="multi-animal-imgaug",
+        partaffinityfield_predict=True,
+        pairwise_predict=True,
+        **kwargs,
+    )
+
+
+#: ``(name, cfg, number of tf_slim variables the tf_slim net creates)``.
+CONFIGS = [
+    ("resnet_50", pose_cfg(), 269),
+    ("resnet_50_multi_animal", multi_animal_cfg(), 271),
+    ("resnet_50_intermediate_supervision", pose_cfg(intermediate_supervision=True), 271),
+    ("munet_stride4", multi_animal_cfg(stride=4, multi_stage=True), 311),
+    ("munet_stride2", multi_animal_cfg(stride=2, multi_stage=True), 313),
+    ("dual_fusion_stride4", multi_animal_cfg(stride=4), 275),
+]
+
+
+def build(cfg, size=(200, 168), batch_size=None):
+    if batch_size is not None:
+        cfg = dict(cfg, batch_size=batch_size)
+    model = PoseNetFactory.create(cfg, engine=KERAS_ENGINE)
+    images = np.random.RandomState(0).uniform(
+        0, 255, (cfg["batch_size"], size[0], size[1], 3)
+    )
+    out = model(tf.constant(images, dtype=tf.float32))
+    return model, tf.constant(images, dtype=tf.float32), out
+
+
+# ---------------------------------------------------------------------------
+# engine selection
+# ---------------------------------------------------------------------------
+def test_tf1_is_the_default_engine(monkeypatch):
+    monkeypatch.delenv(ENGINE_ENV_VAR, raising=False)
+    assert resolve_engine(pose_cfg()) == TF1_ENGINE
+
+
+def test_engine_from_environment(monkeypatch):
+    monkeypatch.setenv(ENGINE_ENV_VAR, "keras")
+    assert resolve_engine(pose_cfg()) == KERAS_ENGINE
+
+
+def test_engine_from_config_wins_over_environment(monkeypatch):
+    monkeypatch.setenv(ENGINE_ENV_VAR, "keras")
+    assert resolve_engine(pose_cfg(tf_engine="tf1")) == TF1_ENGINE
+
+
+def test_unknown_engine_is_rejected():
+    with pytest.raises(ValueError):
+        resolve_engine(pose_cfg(tf_engine="torch"))
+
+
+def test_keras_engine_selects_a_keras_model():
+    model = PoseNetFactory.create(pose_cfg(tf_engine="keras"))
+    assert isinstance(model, tf.keras.Model)
+
+
+# ---------------------------------------------------------------------------
+# structure
+# ---------------------------------------------------------------------------
+@pytest.mark.parametrize("name,cfg,n_slim_variables", CONFIGS, ids=[c[0] for c in CONFIGS])
+def test_every_weight_carries_a_tf_slim_name(name, cfg, n_slim_variables):
+    model, _, _ = build(cfg)
+    weight_map = model.slim_weight_map()
+    assert model.unmapped_weights() == []
+    assert len(weight_map) == len(model.weights) == n_slim_variables
+
+
+@pytest.mark.parametrize("name,cfg,n_slim_variables", CONFIGS, ids=[c[0] for c in CONFIGS])
+def test_heads_are_the_documented_contract(name, cfg, n_slim_variables):
+    model, images, out = build(cfg)
+    assert "features" in out
+    if cfg["location_refinement"]:
+        assert out["locref"].shape[-1] == cfg["num_joints"] * 2
+    # get_net is the contract the rest of the engine calls
+    again = model.get_net(images, is_training=False)
+    assert set(again) == set(out)
+
+
+def test_no_variable_is_claimed_twice():
+    model, _, _ = build(multi_animal_cfg(stride=4, multi_stage=True))
+    weight_map = model.slim_weight_map()
+    assert len({id(v) for v in weight_map.values()}) == len(weight_map)
+
+
+@pytest.mark.parametrize("stride,cfg", [
+    (8, pose_cfg()),
+    (4, multi_animal_cfg(stride=4, multi_stage=True)),
+    (2, multi_animal_cfg(stride=2, multi_stage=True)),
+])
+@pytest.mark.parametrize("size", [160, 170, 194, 200, 208, 201])
+def test_output_size_is_ceil_over_16_times_16_over_stride(stride, cfg, size):
+    _, _, out = build(cfg, size=(size, size))
+    key = "part_pred" if "part_pred" in out else "locref"
+    expected = int(np.ceil(size / 16)) * (16 // stride)
+    assert tuple(out[key].shape[1:3]) == (expected, expected)
+
+
+def test_scoremap_size_matches_the_network():
+    """The dataset's score map size must be the size the network emits.
+
+    ``calc_target_and_scoremap_sizes`` is called on a stub so no project data
+    is needed; only ``cfg``, ``default_size`` and the two helpers it uses.
+    """
+    from deeplabcut.pose_estimation_tensorflow.datasets.pose_multianimal_imgaug import (
+        MAImgaugPoseDataset,
+    )
+
+    class Stub:
+        def __init__(self, cfg, size):
+            self.cfg = cfg
+            self.default_size = np.array(size)
+
+        def sample_scale(self):
+            return 1.0
+
+        def is_valid_size(self, target_size):
+            return True
+
+    for stride, cfg in (
+        (8, pose_cfg()),
+        (4, multi_animal_cfg(stride=4, multi_stage=True)),
+        (2, multi_animal_cfg(stride=2, multi_stage=True)),
+    ):
+        model = PoseNetFactory.create(cfg, engine=KERAS_ENGINE)
+        for size in (160, 170, 194, 200, 208, 226, 240):
+            out = model(tf.zeros((1, size, size, 3)))
+            key = "part_pred" if "part_pred" in out else "locref"
+            _, sm_size = MAImgaugPoseDataset.calc_target_and_scoremap_sizes(
+                Stub(dict(cfg, stride=stride), (size, size))
+            )
+            assert tuple(out[key].shape[1:3]) == tuple(sm_size), (stride, size)
+
+
+# ---------------------------------------------------------------------------
+# checkpoints
+# ---------------------------------------------------------------------------
+@pytest.mark.parametrize("name,cfg,n_slim_variables", CONFIGS, ids=[c[0] for c in CONFIGS])
+def test_checkpoint_round_trip(tmp_path, name, cfg, n_slim_variables):
+    model, images, out = build(cfg)
+    prefix = save_tf1_checkpoint(model, str(tmp_path / "snapshot"), global_step=42)
+    assert prefix.endswith("snapshot-42")
+
+    other = PoseNetFactory.create(cfg, engine=KERAS_ENGINE)
+    other(images)
+    report = load_tf1_checkpoint(other, prefix)
+    assert report.ok
+    assert len(report.loaded) == n_slim_variables
+    assert report.missing == []
+    assert report.unused == []
+
+    got = other(images)
+    for key in out:
+        np.testing.assert_allclose(out[key].numpy(), got[key].numpy(), rtol=0, atol=0)
+
+
+def test_load_rejects_a_checkpoint_that_does_not_fit(tmp_path):
+    model, _, _ = build(pose_cfg())
+    prefix = save_tf1_checkpoint(model, str(tmp_path / "snapshot"), global_step=1)
+    other, _, _ = build(pose_cfg(num_joints=9))
+    with pytest.raises(ValueError):
+        load_tf1_checkpoint(other, prefix)
+    report = load_tf1_checkpoint(other, prefix, allow_missing=True)
+    assert report.mismatched  # the heads have a different number of channels
+
+
+# ---------------------------------------------------------------------------
+# batch norm
+# ---------------------------------------------------------------------------
+def test_resnet_backbone_batch_norm_is_batch_independent():
+    cfg = pose_cfg(batch_size=2)
+    model = PoseNetFactory.create(cfg, engine=KERAS_ENGINE)
+    rng = np.random.RandomState(0)
+    a = rng.uniform(0, 255, (200, 168, 3))
+    b1 = rng.uniform(0, 255, (200, 168, 3))
+    b2 = rng.uniform(0, 255, (200, 168, 3)) * 0.2 + 40.0
+    first = model(tf.constant(np.stack([a, b1]), tf.float32))["part_pred"].numpy()
+    second = model(tf.constant(np.stack([a, b2]), tf.float32))["part_pred"].numpy()
+    np.testing.assert_array_equal(first[0], second[0])
+
+
+def test_munet_decoder_uses_moving_averages_at_inference():
+    """Patch 0013's behaviour: no batch-composition dependence at inference."""
+    cfg = multi_animal_cfg(stride=4, multi_stage=True, batch_size=2)
+    model = PoseNetFactory.create(cfg, engine=KERAS_ENGINE)
+    rng = np.random.RandomState(0)
+    a = rng.uniform(0, 255, (200, 168, 3))
+    b1 = rng.uniform(0, 255, (200, 168, 3))
+    b2 = rng.uniform(0, 255, (200, 168, 3)) * 0.2 + 40.0
+    model(tf.constant(np.stack([a, b1]), tf.float32))
+    # give the decoder batch norms statistics that differ from a batch's own
+    for name, variable in model.slim_weight_map().items():
+        if "decoder_filters" in name and name.endswith("moving_mean"):
+            variable.assign(np.full(variable.shape, 0.3, dtype="float32"))
+        elif "decoder_filters" in name and name.endswith("moving_variance"):
+            variable.assign(np.full(variable.shape, 2.0, dtype="float32"))
+
+    infer1 = model(tf.constant(np.stack([a, b1]), tf.float32), training=False)["part_pred"].numpy()
+    infer2 = model(tf.constant(np.stack([a, b2]), tf.float32), training=False)["part_pred"].numpy()
+    np.testing.assert_array_equal(infer1[0], infer2[0])
+
+    train1 = model(tf.constant(np.stack([a, b1]), tf.float32), training=True)["part_pred"].numpy()
+    assert np.abs(infer1 - train1).max() > 1e-3, "training mode should use the batch statistics"
+
+
+def test_munet_decoder_updates_its_moving_averages_only_in_training_mode():
+    cfg = multi_animal_cfg(stride=4, multi_stage=True)
+    model, images, _ = build(cfg)
+    means = [
+        v for k, v in model.slim_weight_map().items()
+        if "decoder_filters" in k and k.endswith("moving_mean")
+    ]
+    before = [v.numpy().copy() for v in means]
+    model(images, training=False)
+    for variable, value in zip(means, before):
+        np.testing.assert_array_equal(variable.numpy(), value)
+    model(images, training=True)
+    assert any(not np.array_equal(v.numpy(), value) for v, value in zip(means, before))
+
+
+# ---------------------------------------------------------------------------
+# training
+# ---------------------------------------------------------------------------
+def test_gradients_reach_every_trainable_weight():
+    cfg = multi_animal_cfg(stride=4, multi_stage=True)
+    model, images, out = build(cfg)
+    with tf.GradientTape() as tape:
+        heads = model(images, training=True)
+        loss = sum(tf.reduce_mean(tf.square(heads[k])) for k in ("part_pred", "locref", "pairwise_pred"))
+    grads = tape.gradient(loss, model.trainable_variables)
+    assert all(g is not None for g in grads)
+
+
+def test_a_few_sgd_steps_lower_the_loss():
+    cfg = pose_cfg()
+    model, images, out = build(cfg)
+    rng = np.random.RandomState(7)
+    target = tf.constant(rng.randint(0, 2, out["part_pred"].shape).astype("float32"))
+    # Adam, not SGD: this model is randomly initialised rather than restored
+    # from ImageNet, so the raw gradient magnitudes are meaningless.
+    optimizer = tf.keras.optimizers.legacy.Adam(learning_rate=1e-3)
+    losses = []
+    for _ in range(8):
+        with tf.GradientTape() as tape:
+            heads = model(images, training=True)
+            loss = tf.reduce_mean(
+                tf.nn.sigmoid_cross_entropy_with_logits(labels=target, logits=heads["part_pred"])
+            )
+        optimizer.apply_gradients(zip(tape.gradient(loss, model.trainable_variables), model.trainable_variables))
+        losses.append(float(loss))
+    assert losses[-1] < losses[0]
