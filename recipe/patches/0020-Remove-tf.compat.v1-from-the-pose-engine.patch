+"""The (sess, inputs, outputs) contract, without a Session.
+
+Everything downstream of ``core/predict.py`` -- predict_videos.py,
+core/evaluate.py, core/evaluate_multianimal.py, visualizemaps.py, export.py --
+uses exactly one interface::
+
+    sess, inputs, outputs = predict.setup_pose_prediction(cfg)
+    arrays = sess.run(outputs, feed_dict={inputs: batch})
+    sess.close()
+
+That is a duck type, not a Session: DeepLabCut already ships a second,
+non-TensorFlow implementation of it in ``core/openvino/session.py``.
+:class:`EagerSession` is the eager one.  It owns a ``tf.function``, traced once
+per input shape, and turns ``run(fetches, feed_dict)`` into a call, so none of
+those callers has to change.
+"""
+
+import numpy as np
+import tensorflow as tf
+
+
+def plain(value):
+    """Strip Keras's attribute-tracking wrappers out of a config.
+
+    ``BaseKerasPoseNet.__init__`` assigns ``cfg`` to an attribute of a
+    ``tf.keras.Model``, which replaces its lists and dicts with ``ListWrapper``
+    and ``_DictWrapper``.  Those are not YAML serialisable, so writing the
+    exported pose_cfg.yaml fails.  Networks are handed a plain copy and
+    anything on its way back out to YAML is converted back.
+    """
+    if isinstance(value, dict):
+        return {k: plain(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        converted = [plain(v) for v in value]
+        return tuple(converted) if isinstance(value, tuple) else converted
+    return value
+
+
+class Fetch:
+    """Stands in for a graph tensor in the (sess, inputs, outputs) contract."""
+
+    __slots__ = ("name",)
+
+    def __init__(self, name):
+        self.name = name
+
+    def __repr__(self):
+        return f"<Fetch {self.name}>"
+
+    def __hash__(self):
+        return hash(self.name)
+
+    def __eq__(self, other):
+        return isinstance(other, Fetch) and other.name == self.name
+
+
+class EagerSession:
+    """Session-shaped facade over an eager ``tf.function``.
+
+    Only what the code base actually uses is provided: ``run``, ``close`` and
+    the context-manager protocol.  ``net`` and ``cfg`` are there for the
+    exporter, which needs to re-trace the network under the TF1 node names.
+    """
+
+    def __init__(self, fn, feed, outputs, net, cfg):
+        self._fn = fn
+        self.inputs = feed
+        self.outputs = outputs
+        self.net = net
+        self.cfg = cfg
+        self._closed = False
+
+    def run(self, fetches, feed_dict=None):
+        if self._closed:
+            raise RuntimeError("this pose-prediction session has been closed")
+        if not feed_dict:
+            raise ValueError("an eager pose-prediction session needs a feed_dict")
+        (value,) = feed_dict.values()
+        out = self._fn(tf.convert_to_tensor(np.asarray(value, dtype=np.float32)))
+        single = isinstance(fetches, Fetch)
+        wanted = [fetches] if single else list(fetches)
+        result = [out[f.name].numpy() for f in wanted]
+        return result[0] if single else result
+
+    def close(self):
+        self._closed = True
+        self._fn = None
+        self.net = None
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        self.close()
diff --git a/deeplabcut/pose_estimation_tensorflow/core/legacy_tf1.py b/deeplabcut/pose_estimation_tensorflow/core/legacy_tf1.py
new file mode 100644
index 0000000..53d91f2
--- /dev/null
+++ b/deeplabcut/pose_estimation_tensorflow/core/legacy_tf1.py
@@ -0,0 +1,397 @@
+#
+# DeepLabCut Toolbox (deeplabcut.org)
+# © A. & M.W. Mathis Labs
+# https://github.com/DeepLabCut/DeepLabCut
+#
+# Please see AUTHORS for contributors.
+# https://github.com/DeepLabCut/DeepLabCut/blob/master/AUTHORS
+#
+# Adapted from DeeperCut by Eldar Insafutdinov
+# https://github.com/eldar/pose-tensorflow
+#
+# Licensed under GNU Lesser General Public License v3.0
+#
+"""The TF1 graph-mode pose engine, kept until every network is ported.
+
+This module exists so that the rest of the TensorFlow engine can be written in
+plain TensorFlow 2.  Every remaining ``tf.compat.v1`` construct in
+core/predict.py, core/train.py, predict_videos.py and export.py has been moved
+here unchanged; those four files now contain none.  The file is reached only
+when the tf1 engine is selected (see ``nnets.factory.resolve_engine``),
+and it is meant to be deleted, whole, once they are the only implementation.
+
+Nothing in here is new code -- it is the DeepLabCut 3.0.1 implementation,
+moved.
+"""
+
+import logging
+import os
+import threading
+import warnings
+from pathlib import Path
+
+import tensorflow as tf
+import tf_slim as slim
+
+from deeplabcut.pose_estimation_tensorflow.config import load_config
+from deeplabcut.pose_estimation_tensorflow.datasets import PoseDatasetFactory
+from deeplabcut.pose_estimation_tensorflow.nnets.factory import TF1_ENGINE, PoseNetFactory
+from deeplabcut.pose_estimation_tensorflow.util.logging import setup_logging
+from deeplabcut.utils import auxfun_models
+
+_GRAPH_MODE = False
+
+
+def ensure_graph_mode():
+    """Switch TensorFlow to graph mode, once.
+
+    In DeepLabCut 3.0.1 this ran at import of core/train.py, so merely
+    importing ``deeplabcut`` disabled eager execution process-wide and made it
+    impossible for TF1 and TF2 code to share a process.  It now runs only when
+    a TF1 graph is about to be built.
+    """
+    global _GRAPH_MODE
+    if not _GRAPH_MODE:
+        tf.compat.v1.disable_eager_execution()
+        _GRAPH_MODE = True
+
+
+def reset_default_graph():
+    """``tf.compat.v1.reset_default_graph()``; a no-op outside graph mode."""
+    if _GRAPH_MODE:
+        tf.compat.v1.reset_default_graph()
+
+
+def graph_input_name(sess):
+    """The name of the input node of a frozen TF1 pose graph."""
+    return sess.graph.get_operations()[0].name
+
+
+def freeze_graph(sess, output, pbtxt_file, pb_file):
+    """Write the pbtxt and the frozen protobuf of a TF1 session's graph."""
+    tf.io.write_graph(sess.graph.as_graph_def(), "", pbtxt_file, as_text=True)
+    frozen = tf.compat.v1.graph_util.convert_variables_to_constants(
+        sess,
+        sess.graph_def,
+        output,
+    )
+    with Path(pb_file).open("wb") as file:
+        file.write(frozen.SerializeToString())
+
+
+class LearningRate:
+    def __init__(self, cfg):
+        self.steps = cfg["multi_step"]
+        self.current_step = 0
+
+    def get_lr(self, iteration):
+        lr = self.steps[self.current_step][0]
+        if iteration == self.steps[self.current_step][1]:
+            self.current_step += 1
+
+        return lr
+
+
+def get_batch_spec(cfg):
+    from deeplabcut.pose_estimation_tensorflow.datasets import Batch
+
+    num_joints = cfg["num_joints"]
+    batch_size = cfg["batch_size"]
+    return {
+        Batch.inputs: [batch_size, None, None, 3],
+        Batch.part_score_targets: [batch_size, None, None, num_joints],
+        Batch.part_score_weights: [batch_size, None, None, num_joints],
+        Batch.locref_targets: [batch_size, None, None, num_joints * 2],
+        Batch.locref_mask: [batch_size, None, None, num_joints * 2],
+    }
+
+
+def setup_pose_prediction(cfg, allow_growth=False, collect_extra=False):
+    ensure_graph_mode()
+    tf.compat.v1.reset_default_graph()
+    inputs = tf.compat.v1.placeholder(tf.float32, shape=[cfg["batch_size"], None, None, 3])
+    net_heads = PoseNetFactory.create(cfg, engine=TF1_ENGINE).test(inputs)
+    extra_dict = {}
+    outputs = [net_heads["part_prob"]]
+    if cfg["location_refinement"]:
+        outputs.append(net_heads["locref"])
+
+    if ("multi-animal" in cfg["dataset_type"]) and cfg["partaffinityfield_predict"]:
+        print("Activating extracting of PAFs")
+        outputs.append(net_heads["pairwise_pred"])
+
+    outputs.append(net_heads["peak_inds"])
+
+    if collect_extra:
+        extra_dict["features"] = net_heads["features"]
+
+    restorer = tf.compat.v1.train.Saver()
+
+    if allow_growth:
+        config = tf.compat.v1.ConfigProto()
+        config.gpu_options.allow_growth = True
+        sess = tf.compat.v1.Session(config=config)
+    else:
+        sess = tf.compat.v1.Session()
+    sess.run(tf.compat.v1.global_variables_initializer())
+    sess.run(tf.compat.v1.local_variables_initializer())
+
+    # Restore variables from disk.
+    restorer.restore(sess, cfg["init_weights"])
+
+    if collect_extra:
+        return sess, inputs, outputs, extra_dict
+    else:
+        return sess, inputs, outputs
+
+def setup_GPUpose_prediction(cfg, allow_growth=False):
+    ensure_graph_mode()
+    tf.compat.v1.reset_default_graph()
+    inputs = tf.compat.v1.placeholder(tf.float32, shape=[cfg["batch_size"], None, None, 3])
+    net_heads = PoseNetFactory.create(cfg, engine=TF1_ENGINE).inference(inputs)
+    outputs = [net_heads["pose"]]
+
+    restorer = tf.compat.v1.train.Saver()
+
+    if allow_growth:
+        config = tf.compat.v1.ConfigProto()
+        config.gpu_options.allow_growth = True
+        sess = tf.compat.v1.Session(config=config)
+    else:
+        sess = tf.compat.v1.Session()
+
+    sess.run(tf.compat.v1.global_variables_initializer())
+    sess.run(tf.compat.v1.local_variables_initializer())
+
+    # Restore variables from disk.
+    restorer.restore(sess, cfg["init_weights"])
+
+    return sess, inputs, outputs
+
+def setup_preloading(batch_spec):
+    placeholders = {name: tf.compat.v1.placeholder(tf.float32, shape=spec) for (name, spec) in batch_spec.items()}
+    names = placeholders.keys()
+    placeholders_list = list(placeholders.values())
+
+    QUEUE_SIZE = 20
+    q = tf.queue.FIFOQueue(QUEUE_SIZE, [tf.float32] * len(batch_spec))
+    enqueue_op = q.enqueue(placeholders_list)
+    batch_list = q.dequeue()
+
+    batch = {}
+    for idx, name in enumerate(names):
+        batch[name] = batch_list[idx]
+        batch[name].set_shape(batch_spec[name])
+    return batch, enqueue_op, placeholders
+
+
+def load_and_enqueue(sess, enqueue_op, coord, dataset, placeholders):
+    while not coord.should_stop():
+        batch_np = dataset.next_batch()
+        food = {pl: batch_np[name] for (name, pl) in placeholders.items()}
+        sess.run(enqueue_op, feed_dict=food)
+
+
+def start_preloading(sess, enqueue_op, dataset, placeholders):
+    coord = tf.compat.v1.train.Coordinator()
+    t = threading.Thread(
+        target=load_and_enqueue,
+        args=(sess, enqueue_op, coord, dataset, placeholders),
+    )
+    t.start()
+    return coord, t
+
+def get_optimizer(loss_op, cfg):
+    tstep = tf.compat.v1.placeholder(tf.int32, shape=[], name="tstep")
+    if "efficientnet" in cfg["net_type"]:
+        print("Switching to cosine decay schedule with adam!")
+        cfg["optimizer"] = "adam"
+        learning_rate = tf.compat.v1.train.cosine_decay(cfg["lr_init"], tstep, cfg["decay_steps"], alpha=cfg["alpha_r"])
+    else:
+        learning_rate = tf.compat.v1.placeholder(tf.float32, shape=[])
+
+    if cfg["optimizer"] == "sgd":
+        optimizer = tf.compat.v1.train.MomentumOptimizer(learning_rate=learning_rate, momentum=0.9)
+    elif cfg["optimizer"] == "adam":
+        optimizer = tf.compat.v1.train.AdamOptimizer(learning_rate)
+    else:
+        raise ValueError("unknown optimizer {}".format(cfg["optimizer"]))
+    train_op = slim.learning.create_train_op(loss_op, optimizer)
+
+    return learning_rate, train_op, tstep
+
+
+def get_optimizer_with_freeze(loss_op, cfg):
+    learning_rate = tf.compat.v1.placeholder(tf.float32, shape=[])
+
+    if cfg["optimizer"] == "sgd":
+        optimizer = tf.compat.v1.train.MomentumOptimizer(learning_rate=learning_rate, momentum=0.9)
+    elif cfg["optimizer"] == "adam":
+        optimizer = tf.compat.v1.train.AdamOptimizer(learning_rate)
+    else:
+        raise ValueError("unknown optimizer {}".format(cfg["optimizer"]))
+
+    train_unfrozen_op = slim.learning.create_train_op(loss_op, optimizer)
+    variables_unfrozen = tf.compat.v1.get_collection(tf.compat.v1.GraphKeys.TRAINABLE_VARIABLES, "pose")
+
+    train_frozen_op = slim.learning.create_train_op(loss_op, optimizer, variables_to_train=variables_unfrozen)
+
+    return learning_rate, train_unfrozen_op, train_frozen_op
+
+def train(
+    config_yaml,
+    displayiters,
+    saveiters,
+    maxiters,
+    max_to_keep=5,
+    keepdeconvweights=True,
+    allow_growth=True,
+):
+    ensure_graph_mode()
+    start_path = Path.cwd()
+    os.chdir(str(Path(config_yaml).parents[0]))  # switch to folder of config_yaml (for logging)
+    setup_logging()
+
+    cfg = load_config(config_yaml)
+    net_type = cfg["net_type"]
+    if cfg["dataset_type"] in ("scalecrop", "tensorpack", "deterministic"):
+        print(
+            "Switching batchsize to 1, as tensorpack/scalecrop/deterministic loaders "
+            "do not support batches >1. Use imgaug/default loader."
+        )
+        cfg["batch_size"] = 1  # in case this was edited for analysis.-
+
+    dataset = PoseDatasetFactory.create(cfg)
+    batch_spec = get_batch_spec(cfg)
+    batch, enqueue_op, placeholders = setup_preloading(batch_spec)
+
+    losses = PoseNetFactory.create(cfg, engine=TF1_ENGINE).train(batch)
+    total_loss = losses["total_loss"]
+
+    for k, t in losses.items():
+        tf.compat.v1.summary.scalar(k, t)
+    merged_summaries = tf.compat.v1.summary.merge_all()
+
+    stem = Path(cfg["init_weights"]).stem
+    if "snapshot" in stem and keepdeconvweights:
+        print("Loading already trained DLC with backbone:", net_type)
+        variables_to_restore = slim.get_variables_to_restore()
+        start_iter = int(stem.split("-")[1])
+    else:
+        print("Loading ImageNet-pretrained", net_type)
+        # loading backbone from ResNet, MobileNet etc.
+        if "resnet" in net_type:
+            variables_to_restore = slim.get_variables_to_restore(include=["resnet_v1"])
+        elif "mobilenet" in net_type:
+            variables_to_restore = slim.get_variables_to_restore(include=["MobilenetV2"])
+        elif "efficientnet" in net_type:
+            variables_to_restore = slim.get_variables_to_restore(include=["efficientnet"])
+            variables_to_restore = {
+                var.op.name.replace("efficientnet/", "") + "/ExponentialMovingAverage": var
+                for var in variables_to_restore
+            }
+        else:
+            print("Wait for DLC 2.3.")
+        start_iter = 0
+
+    restorer = tf.compat.v1.train.Saver(variables_to_restore)
+    saver = tf.compat.v1.train.Saver(
+        max_to_keep=max_to_keep
+    )  # selects how many snapshots are stored, see https://github.com/DeepLabCut/DeepLabCut/issues/8#issuecomment-387404835
+
