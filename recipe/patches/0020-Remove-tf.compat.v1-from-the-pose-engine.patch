+def build_serving_function(net, cfg, output):
+    """A ``tf.function`` whose frozen graph carries the TF1 node names.
+
+    Freezing an eager model names its nodes after Keras layers, so none of the
+    names DLC-Live loads by survive -- of 3796 TF1 op names exactly one does.
+    Wrapping each output in ``tf.identity`` with its old name inside the traced
+    function restores all of them; the input node is already "Placeholder".
+    """
+    wanted = list(output)
+    unknown = [name for name in wanted if name not in EXPORT_NODES]
+    if unknown:
+        raise ValueError(f"cannot export unknown output node(s) {unknown}")
+    shape = [cfg.get("batch_size") or None, None, None, 3]
+
+    @tf.function(input_signature=[tf.TensorSpec(shape, tf.float32, name="Placeholder")])
+    def serve(x):
+        heads = net.get_net(x, is_training=False)
+        available = dict(heads)
+        if any(EXPORT_NODES[n] in ("part_prob", "peak_inds") for n in wanted):
+            available.update(net.add_inference_layers(heads))
+        if "concat_1" in wanted:
+            available.update(net.inference(x))
+        return tuple(tf.identity(available[EXPORT_NODES[n]], name=n) for n in wanted)
+
+    return serve
