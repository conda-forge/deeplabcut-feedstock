+"""Image augmentation for the PyTorch engine.
+
+This module provides the small augmentation pipeline DeepLabCut needs, so that the
+training data pipeline does not depend on a third-party augmentation library whose
+transform API, parameter names and annotation semantics have repeatedly changed
+underneath it.
+
+Conventions used throughout, chosen to be explicit rather than clever:
+
+* images are ``(H, W, C)`` arrays;
+* keypoints are ``(N, C)`` float arrays whose first two columns are ``x`` and ``y``;
+  any further columns (DeepLabCut passes a visibility flag) are carried through
+  untouched. Keypoints are never dropped, only moved;
+* bounding boxes are ``(M, 4)`` float arrays. They are given to and returned from
+  :class:`Compose` in COCO layout ``(x_min, y_min, width, height)`` and held
+  internally in absolute ``(x_min, y_min, x_max, y_max)`` corners;
+* every transform draws from an explicit :class:`numpy.random.Generator` so a
+  pipeline can be made reproducible.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Sequence
+
+import cv2
+import numpy as np
+from numpy.typing import NDArray
+
+__all__ = [
+    "Affine",
+    "BaseCompose",
+    "BasicTransform",
+    "BboxParams",
+    "CoarseDropout",
+    "Compose",
+    "DualTransform",
+    "ElasticTransform",
+    "Equalize",
+    "GaussNoise",
+    "HorizontalFlip",
+    "ImageOnlyTransform",
+    "KeypointParams",
+    "LongestMaxSize",
+    "MotionBlur",
+    "Normalize",
+    "PadIfNeeded",
+    "RandomCrop",
+    "Resize",
+    "ToGray",
+    "keypoints_scale",
+]
+
+# Padding positions accepted by PadIfNeeded.
+PAD_POSITIONS = ("center", "top_left", "top_right", "bottom_left", "bottom_right", "random")
+
+
+def keypoints_scale(keypoints: NDArray, scale_x: float, scale_y: float) -> NDArray:
+    """Scale the coordinates of keypoints, leaving trailing columns untouched."""
+    keypoints = np.asarray(keypoints, dtype=float).copy()
+    if len(keypoints):
+        keypoints[:, 0] *= scale_x
+        keypoints[:, 1] *= scale_y
+    return keypoints
+
+
+def bboxes_scale(bboxes: NDArray, scale_x: float, scale_y: float) -> NDArray:
+    """Scale corner-format bounding boxes."""
+    bboxes = np.asarray(bboxes, dtype=float).copy()
+    if len(bboxes):
+        bboxes[:, [0, 2]] *= scale_x
+        bboxes[:, [1, 3]] *= scale_y
+    return bboxes
+
+
+def bboxes_shift(bboxes: NDArray, dx: float, dy: float) -> NDArray:
+    """Translate corner-format bounding boxes."""
+    bboxes = np.asarray(bboxes, dtype=float).copy()
+    if len(bboxes):
+        bboxes[:, [0, 2]] += dx
+        bboxes[:, [1, 3]] += dy
+    return bboxes
+
+
+def coco_to_corners(bboxes: Sequence) -> NDArray:
+    """Convert ``(x_min, y_min, width, height)`` boxes to corner layout."""
+    bboxes = np.asarray(bboxes, dtype=float).reshape(-1, 4).copy()
+    bboxes[:, 2] += bboxes[:, 0]
+    bboxes[:, 3] += bboxes[:, 1]
+    return bboxes
+
+
+def corners_to_coco(bboxes: NDArray) -> NDArray:
+    """Convert corner-layout boxes back to ``(x_min, y_min, width, height)``."""
+    bboxes = np.asarray(bboxes, dtype=float).reshape(-1, 4).copy()
+    bboxes[:, 2] -= bboxes[:, 0]
+    bboxes[:, 3] -= bboxes[:, 1]
+    return bboxes
+
+
+def _as_keypoints(keypoints: Any) -> NDArray:
+    keypoints = np.asarray(keypoints, dtype=float)
+    if keypoints.size == 0:
+        return np.zeros((0, 2), dtype=float)
+    return keypoints.reshape(len(keypoints), -1)
+
+
+def _as_bboxes(bboxes: Any) -> NDArray:
+    bboxes = np.asarray(bboxes, dtype=float)
+    if bboxes.size == 0:
+        return np.zeros((0, 4), dtype=float)
+    return bboxes.reshape(len(bboxes), -1)[:, :4]
+
+
+class BasicTransform:
+    """Base class for a transform applied with probability ``p``.
+
+    Subclasses override :meth:`get_params` to sample whatever the transform needs
+    once per call, then :meth:`apply`, :meth:`apply_to_keypoints` and
+    :meth:`apply_to_bboxes` to transform each target consistently with those params.
+    """
+
+    def __init__(self, p: float = 0.5) -> None:
+        self.p = p
+
+    def get_params(
+        self, image: NDArray, keypoints: NDArray, bboxes: NDArray, rng: np.random.Generator
+    ) -> dict[str, Any]:
+        return {}
+
+    def apply(self, image: NDArray, **params: Any) -> NDArray:
+        return image
+
+    def apply_to_keypoints(self, keypoints: NDArray, **params: Any) -> NDArray:
+        return keypoints
+
+    def apply_to_bboxes(self, bboxes: NDArray, **params: Any) -> NDArray:
+        return bboxes
+
+    def __call__(
+        self,
+        image: NDArray,
+        keypoints: NDArray,
+        bboxes: NDArray,
+        rng: np.random.Generator,
+    ) -> tuple[NDArray, NDArray, NDArray]:
+        if self.p < 1.0 and rng.random() >= self.p:
+            return image, keypoints, bboxes
+        params = self.get_params(image, keypoints, bboxes, rng)
+        return (
+            self.apply(image, **params),
+            self.apply_to_keypoints(keypoints, **params),
+            self.apply_to_bboxes(bboxes, **params),
+        )
+
+
+class ImageOnlyTransform(BasicTransform):
+    """A transform that changes pixels but leaves the geometry alone."""
+
+
+class DualTransform(BasicTransform):
+    """A transform that changes the image geometry and therefore the annotations."""
+
+
+class BaseCompose:
+    """Base class for transform pipelines."""
+
+    def __init__(self, transforms: Sequence[BasicTransform]) -> None:
+        self.transforms = list(transforms)
+
+    def __len__(self) -> int:
+        return len(self.transforms)
+
+    def __iter__(self):
+        return iter(self.transforms)
+
+    def __getitem__(self, item):
+        return self.transforms[item]
+
+
+class KeypointParams:
+    """Keypoint handling options.
+
+    Only the ``"xy"`` format DeepLabCut uses is supported. ``remove_invisible`` is
+    accepted for call compatibility but keypoints are never dropped: a keypoint that
+    leaves the image keeps its coordinates and the caller decides what to do with it.
+    """
+
+    def __init__(
+        self,
+        format: str = "xy",
+        remove_invisible: bool = False,
+        label_fields: Sequence[str] | None = None,
+    ) -> None:
+        if format != "xy":
+            raise ValueError(f"Only the 'xy' keypoint format is supported, not {format!r}.")
+        self.format = format
+        self.remove_invisible = remove_invisible
+        self.label_fields = list(label_fields or [])
+
+
+class BboxParams:
+    """Bounding box handling options.
+
+    Only the ``"coco"`` format DeepLabCut uses is supported. After the pipeline runs,
+    boxes are clipped to the image and any box left without area is dropped, together
+    with its entries in ``label_fields``.
+    """
+
+    def __init__(
+        self,
+        format: str = "coco",
+        label_fields: Sequence[str] | None = None,
+        min_area: float = 0.0,
+        min_visibility: float = 0.0,
+    ) -> None:
+        if format != "coco":
+            raise ValueError(f"Only the 'coco' bounding box format is supported, not {format!r}.")
+        self.format = format
+        self.label_fields = list(label_fields or [])
+        self.min_area = min_area
+        self.min_visibility = min_visibility
+
+
+class Compose(BaseCompose):
+    """Apply a sequence of transforms to an image and its annotations.
+
+    The call signature mirrors what the rest of the data pipeline already used::
+
+        transformed = pipeline(
+            image=image,
+            keypoints=keypoints,
+            class_labels=class_labels,
+            bboxes=bboxes,
+            bbox_labels=bbox_labels,
+        )
+
+    ``bboxes`` are given and returned in COCO layout. Boxes that end up outside the
+    image are dropped along with their labels, so callers must use the labels to map
+    outputs back onto their inputs.
+    """
+
+    def __init__(
+        self,
+        transforms: Sequence[BasicTransform],
+        keypoint_params: KeypointParams | None = None,
+        bbox_params: BboxParams | None = None,
+        seed: int | None = None,
+    ) -> None:
+        super().__init__(transforms)
+        self.keypoint_params = keypoint_params
+        self.bbox_params = bbox_params
+        self.seed = seed
+
+    def __call__(self, image: NDArray, **data: Any) -> dict[str, Any]:
+        rng = np.random.default_rng(self.seed) if self.seed is not None else np.random.default_rng()
+
+        image = np.asarray(image)
+        keypoints = _as_keypoints(data.get("keypoints", []))
+        bboxes_coco = _as_bboxes(data.get("bboxes", []))
+        bboxes = coco_to_corners(bboxes_coco) if len(bboxes_coco) else np.zeros((0, 4), dtype=float)
+
+        labels = {}
+        if self.bbox_params is not None:
+            for field in self.bbox_params.label_fields:
+                labels[field] = list(data.get(field, []))
+
+        for transform in self.transforms:
+            image, keypoints, bboxes = transform(image, keypoints, bboxes, rng)
+            keypoints = _as_keypoints(keypoints)
+            bboxes = np.asarray(bboxes, dtype=float).reshape(-1, 4) if len(bboxes) else np.zeros((0, 4), dtype=float)
+
+        result = dict(data)
+        result["image"] = image
+        result["keypoints"] = keypoints
+
+        if len(bboxes):
+            height, width = image.shape[:2]
+            clipped = bboxes.copy()
+            clipped[:, [0, 2]] = np.clip(clipped[:, [0, 2]], 0, width)
+            clipped[:, [1, 3]] = np.clip(clipped[:, [1, 3]], 0, height)
+            areas = (clipped[:, 2] - clipped[:, 0]) * (clipped[:, 3] - clipped[:, 1])
+            keep = areas > self.bbox_params.min_area if self.bbox_params else areas > 0
+            bboxes = clipped[keep]
+            for field, values in labels.items():
+                labels[field] = [value for value, keep_it in zip(values, keep) if keep_it]
+
+        result["bboxes"] = corners_to_coco(bboxes) if len(bboxes) else np.zeros((0, 4), dtype=float)
+        result.update(labels)
+        return result
+
+
+class HorizontalFlip(DualTransform):
+    """Mirror the image left-to-right."""
+
+    def apply(self, image: NDArray, **params: Any) -> NDArray:
+        return np.ascontiguousarray(image[:, ::-1])
+
+    def get_params(
+        self, image: NDArray, keypoints: NDArray, bboxes: NDArray, rng: np.random.Generator
+    ) -> dict[str, Any]:
+        return {"width": image.shape[1]}
+
+    def apply_to_keypoints(self, keypoints: NDArray, width: int = 0, **params: Any) -> NDArray:
+        keypoints = keypoints.copy()
+        if len(keypoints):
+            keypoints[:, 0] = (width - 1) - keypoints[:, 0]
+        return keypoints
+
+    def apply_to_bboxes(self, bboxes: NDArray, width: int = 0, **params: Any) -> NDArray:
+        bboxes = bboxes.copy()
+        if len(bboxes):
+            x_min = width - bboxes[:, 2]
+            x_max = width - bboxes[:, 0]
+            bboxes[:, 0], bboxes[:, 2] = x_min, x_max
+        return bboxes
+
+
+class Resize(DualTransform):
+    """Resize to a fixed height and width, ignoring the aspect ratio."""
+
+    def __init__(self, height: int, width: int, interpolation: int = cv2.INTER_LINEAR, p: float = 1.0) -> None:
+        super().__init__(p=p)
+        self.height = height
+        self.width = width
+        self.interpolation = interpolation
+
+    def get_params(
+        self, image: NDArray, keypoints: NDArray, bboxes: NDArray, rng: np.random.Generator
+    ) -> dict[str, Any]:
+        h, w = image.shape[:2]
+        return {"scale_x": self.width / w, "scale_y": self.height / h}
+
+    def apply(self, image: NDArray, **params: Any) -> NDArray:
+        return cv2.resize(image, (self.width, self.height), interpolation=self.interpolation)
+
+    def apply_to_keypoints(self, keypoints: NDArray, scale_x: float = 1.0, scale_y: float = 1.0, **params: Any) -> NDArray:
+        return keypoints_scale(keypoints, scale_x, scale_y)
+
+    def apply_to_bboxes(self, bboxes: NDArray, scale_x: float = 1.0, scale_y: float = 1.0, **params: Any) -> NDArray:
+        return bboxes_scale(bboxes, scale_x, scale_y)
+
+
+class LongestMaxSize(DualTransform):
+    """Scale the image so that its longest side equals ``max_size``."""
+
+    def __init__(self, max_size: int, interpolation: int = cv2.INTER_LINEAR, p: float = 1.0) -> None:
+        super().__init__(p=p)
+        self.max_size = max_size
+        self.interpolation = interpolation
+
+    def get_params(
+        self, image: NDArray, keypoints: NDArray, bboxes: NDArray, rng: np.random.Generator
+    ) -> dict[str, Any]:
+        h, w = image.shape[:2]
+        return {"scale": self.max_size / max(h, w)}
+
+    def apply(self, image: NDArray, scale: float = 1.0, **params: Any) -> NDArray:
+        h, w = image.shape[:2]
+        # round() rather than int(): matches the sizing used by the reference
+        # implementation this replaces, and keeps the longest side exactly max_size.
+        return cv2.resize(image, (int(round(w * scale)), int(round(h * scale))), interpolation=self.interpolation)
+
+    def apply_to_keypoints(self, keypoints: NDArray, scale: float = 1.0, **params: Any) -> NDArray:
+        return keypoints_scale(keypoints, scale, scale)
+
+    def apply_to_bboxes(self, bboxes: NDArray, scale: float = 1.0, **params: Any) -> NDArray:
+        return bboxes_scale(bboxes, scale, scale)
+
+
+class PadIfNeeded(DualTransform):
+    """Pad the image up to a minimum size, or up to a multiple of a divisor.
+
+    Annotations are only translated by the padding offset. They are never mirrored
+    into a reflected border, which would turn one annotated instance into several.
+    """
+
+    def __init__(
+        self,
+        min_height: int | None = None,
+        min_width: int | None = None,
+        pad_height_divisor: int | None = None,
+        pad_width_divisor: int | None = None,
+        position: str = "center",
+        border_mode: int = cv2.BORDER_REFLECT_101,
+        value: float | Sequence[float] | None = None,
+        mask_value: float | Sequence[float] | None = None,
+        p: float = 1.0,
+    ) -> None:
+        super().__init__(p=p)
+        if min_height is not None and pad_height_divisor is not None:
+            raise ValueError("Only one of min_height and pad_height_divisor may be set.")
+        if min_width is not None and pad_width_divisor is not None:
+            raise ValueError("Only one of min_width and pad_width_divisor may be set.")
+        if position not in PAD_POSITIONS:
+            raise ValueError(f"Unknown padding position {position!r} (valid values are: {PAD_POSITIONS}).")
+        self.min_height = min_height
+        self.min_width = min_width
+        self.pad_height_divisor = pad_height_divisor
+        self.pad_width_divisor = pad_width_divisor
+        self.position = position
+        self.border_mode = border_mode
+        self.value = value
+        self.mask_value = mask_value
+
+    @staticmethod
+    def _extent(size: int, minimum: int | None, divisor: int | None) -> int:
+        if minimum is not None:
+            return max(0, minimum - size)
+        if divisor is not None and size % divisor:
+            return divisor - (size % divisor)
+        return 0
+
+    def get_params(
+        self, image: NDArray, keypoints: NDArray, bboxes: NDArray, rng: np.random.Generator
+    ) -> dict[str, Any]:
+        h, w = image.shape[:2]
+        pad_h = self._extent(h, self.min_height, self.pad_height_divisor)
+        pad_w = self._extent(w, self.min_width, self.pad_width_divisor)
+
+        position = self.position
+        if position == "random":
+            top = int(rng.integers(0, pad_h + 1))
+            left = int(rng.integers(0, pad_w + 1))
+        elif position == "center":
+            top, left = pad_h // 2, pad_w // 2
+        elif position == "top_left":
+            top, left = 0, 0
+        elif position == "top_right":
+            top, left = 0, pad_w
+        elif position == "bottom_left":
+            top, left = pad_h, 0
+        else:  # bottom_right
+            top, left = pad_h, pad_w
+        return {"pad_top": top, "pad_bottom": pad_h - top, "pad_left": left, "pad_right": pad_w - left}
+
+    def apply(self, image: NDArray, pad_top: int = 0, pad_bottom: int = 0, pad_left: int = 0, pad_right: int = 0, **params: Any) -> NDArray:
+        if not (pad_top or pad_bottom or pad_left or pad_right):
+            return image
+        value = self.value
+        if self.border_mode == cv2.BORDER_CONSTANT and value is None:
+            value = 0
+        return cv2.copyMakeBorder(
+            image, pad_top, pad_bottom, pad_left, pad_right, self.border_mode,
+            value=value if self.border_mode == cv2.BORDER_CONSTANT else None,
+        )
+
+    def apply_to_keypoints(self, keypoints: NDArray, pad_top: int = 0, pad_left: int = 0, **params: Any) -> NDArray:
+        keypoints = keypoints.copy()
+        if len(keypoints):
+            keypoints[:, 0] += pad_left
+            keypoints[:, 1] += pad_top
+        return keypoints
+
+    def apply_to_bboxes(self, bboxes: NDArray, pad_top: int = 0, pad_left: int = 0, **params: Any) -> NDArray:
+        return bboxes_shift(bboxes, pad_left, pad_top)
+
+
+class RandomCrop(DualTransform):
+    """Crop a fixed-size window from a random position."""
+
+    def __init__(self, height: int, width: int, p: float = 1.0) -> None:
+        super().__init__(p=p)
+        self.height = height
+        self.width = width
+
+    def get_params(
+        self, image: NDArray, keypoints: NDArray, bboxes: NDArray, rng: np.random.Generator
+    ) -> dict[str, Any]:
+        return self.crop_coords(image.shape[:2], rng.random(), rng.random())
+
+    def crop_coords(self, image_shape: tuple[int, int], h_start: float, w_start: float) -> dict[str, Any]:
+        """Return the crop window for fractional start positions in ``[0, 1)``."""
+        h, w = image_shape
+        y1 = int((h - self.height + 1) * h_start)
+        x1 = int((w - self.width + 1) * w_start)
+        return {"x_min": x1, "y_min": y1}
+
+    def apply(self, image: NDArray, x_min: int = 0, y_min: int = 0, **params: Any) -> NDArray:
+        return image[y_min : y_min + self.height, x_min : x_min + self.width]
+
+    def apply_to_keypoints(self, keypoints: NDArray, x_min: int = 0, y_min: int = 0, **params: Any) -> NDArray:
+        keypoints = keypoints.copy()
+        if len(keypoints):
+            keypoints[:, 0] -= x_min
+            keypoints[:, 1] -= y_min
+        return keypoints
+
+    def apply_to_bboxes(self, bboxes: NDArray, x_min: int = 0, y_min: int = 0, **params: Any) -> NDArray:
+        return bboxes_shift(bboxes, -x_min, -y_min)
+
+
+class Affine(DualTransform):
+    """Rotate, scale and translate about the image centre.
+
+    Bounding boxes are transformed by mapping their four corners and taking the
+    enclosing axis-aligned box, which is what a rotated box degrades to without a
+    rotated-box representation.
+    """
+
+    def __init__(
+        self,
+        scale: tuple[float, float] | float = 1.0,
+        rotate: tuple[float, float] | float = 0.0,
+        translate_px: tuple[int, int] | int = 0,
+        interpolation: int = cv2.INTER_LINEAR,
+        border_mode: int = cv2.BORDER_CONSTANT,
+        value: float | Sequence[float] = 0,
+        p: float = 0.5,
+    ) -> None:
+        super().__init__(p=p)
+        self.scale = scale if isinstance(scale, (tuple, list)) else (scale, scale)
+        self.rotate = rotate if isinstance(rotate, (tuple, list)) else (-rotate, rotate)
+        self.translate_px = translate_px if isinstance(translate_px, (tuple, list)) else (-translate_px, translate_px)
+        self.interpolation = interpolation
+        self.border_mode = border_mode
+        self.value = value
+
+    def get_params(
+        self, image: NDArray, keypoints: NDArray, bboxes: NDArray, rng: np.random.Generator
+    ) -> dict[str, Any]:
+        h, w = image.shape[:2]
+        scale = float(rng.uniform(*self.scale)) if self.scale[0] != self.scale[1] else float(self.scale[0])
+        angle = float(rng.uniform(*self.rotate)) if self.rotate[0] != self.rotate[1] else float(self.rotate[0])
+        if self.translate_px[0] != self.translate_px[1]:
+            dx = int(rng.integers(self.translate_px[0], self.translate_px[1] + 1))
+            dy = int(rng.integers(self.translate_px[0], self.translate_px[1] + 1))
+        else:
+            dx = dy = int(self.translate_px[0])
+
+        matrix = cv2.getRotationMatrix2D(((w - 1) * 0.5, (h - 1) * 0.5), angle, scale)
+        matrix[0, 2] += dx
+        matrix[1, 2] += dy
+        return {"matrix": matrix, "shape": (h, w)}
+
+    def apply(self, image: NDArray, matrix: NDArray | None = None, shape: tuple[int, int] = (0, 0), **params: Any) -> NDArray:
+        h, w = shape
+        return cv2.warpAffine(
+            image, matrix, (w, h), flags=self.interpolation,
+            borderMode=self.border_mode, borderValue=self.value,
+        )
+
+    @staticmethod
+    def _transform_points(points: NDArray, matrix: NDArray) -> NDArray:
+        points = np.asarray(points, dtype=float)
+        return points @ matrix[:, :2].T + matrix[:, 2]
+
+    def apply_to_keypoints(self, keypoints: NDArray, matrix: NDArray | None = None, **params: Any) -> NDArray:
+        keypoints = keypoints.copy()
+        if len(keypoints):
+            keypoints[:, :2] = self._transform_points(keypoints[:, :2], matrix)
+        return keypoints
+
+    def apply_to_bboxes(self, bboxes: NDArray, matrix: NDArray | None = None, **params: Any) -> NDArray:
+        if not len(bboxes):
+            return bboxes
+        x_min, y_min, x_max, y_max = bboxes[:, 0], bboxes[:, 1], bboxes[:, 2], bboxes[:, 3]
+        corners = np.stack(
+            [
+                np.stack([x_min, y_min], axis=1),
+                np.stack([x_max, y_min], axis=1),
+                np.stack([x_max, y_max], axis=1),
+                np.stack([x_min, y_max], axis=1),
+            ],
+            axis=1,
+        )
+        warped = self._transform_points(corners.reshape(-1, 2), matrix).reshape(-1, 4, 2)
+        out = bboxes.copy()
+        out[:, 0] = warped[:, :, 0].min(axis=1)
+        out[:, 1] = warped[:, :, 1].min(axis=1)
+        out[:, 2] = warped[:, :, 0].max(axis=1)
+        out[:, 3] = warped[:, :, 1].max(axis=1)
+        return out
+
+
+class Normalize(ImageOnlyTransform):
+    """Scale to ``[0, 1]`` then standardise with a per-channel mean and std."""
+
+    def __init__(
+        self,
+        mean: Sequence[float] = (0.485, 0.456, 0.406),
+        std: Sequence[float] = (0.229, 0.224, 0.225),
+        max_pixel_value: float = 255.0,
+        p: float = 1.0,
+    ) -> None:
+        super().__init__(p=p)
+        self.mean = np.asarray(mean, dtype=np.float32)
+        self.std = np.asarray(std, dtype=np.float32)
+        self.max_pixel_value = max_pixel_value
+
+    def apply(self, image: NDArray, **params: Any) -> NDArray:
+        image = image.astype(np.float32)
+        denominator = 1.0 / (self.std * self.max_pixel_value)
+        return (image - self.mean * self.max_pixel_value) * denominator
+
+
+class ScaleTo01(ImageOnlyTransform):
+    """Scale an 8-bit image into ``[0, 1]`` without standardising it."""
+
+    def __init__(self, p: float = 1.0) -> None:
+        super().__init__(p=p)
+
+    def apply(self, image: NDArray, **params: Any) -> NDArray:
+        return image.astype(np.float32) / 255.0
+
+
+class Equalize(ImageOnlyTransform):
+    """Equalise the histogram of each channel independently."""
+
+    def apply(self, image: NDArray, **params: Any) -> NDArray:
+        if image.ndim == 2:
+            return cv2.equalizeHist(image)
+        return np.stack([cv2.equalizeHist(image[..., c]) for c in range(image.shape[2])], axis=-1)
+
+
+class ToGray(ImageOnlyTransform):
+    """Convert to greyscale, keeping the original number of channels."""
+
+    def apply(self, image: NDArray, **params: Any) -> NDArray:
+        if image.ndim == 2 or image.shape[2] == 1:
+            return image
+        gray = cv2.cvtColor(image[..., :3], cv2.COLOR_RGB2GRAY)
+        return np.repeat(gray[..., None], image.shape[2], axis=2)
+
+
+class MotionBlur(ImageOnlyTransform):
+    """Blur along a random straight line."""
+
+    def __init__(self, blur_limit: int | tuple[int, int] = (3, 7), p: float = 0.5) -> None:
+        super().__init__(p=p)
+        limit = blur_limit if isinstance(blur_limit, (tuple, list)) else (3, blur_limit)
+        self.blur_limit = (max(3, limit[0]), max(3, limit[1]))
+
+    def get_params(
+        self, image: NDArray, keypoints: NDArray, bboxes: NDArray, rng: np.random.Generator
+    ) -> dict[str, Any]:
+        low, high = self.blur_limit
+        ksize = int(rng.integers(low, high + 1))
+        if ksize % 2 == 0:
+            ksize += 1
+        kernel = np.zeros((ksize, ksize), dtype=np.float32)
+        # a random straight line through the kernel centre
+        x1, x2 = rng.integers(0, ksize, size=2).tolist()
+        if x1 == x2:
+            y1, y2 = rng.choice(np.arange(ksize), size=2, replace=False).tolist()
+        else:
+            y1, y2 = rng.integers(0, ksize, size=2).tolist()
+        cv2.line(kernel, (x1, y1), (x2, y2), 1, thickness=1)
+        total = kernel.sum()
+        if total == 0:
+            kernel[ksize // 2, ksize // 2] = 1
+            total = 1
+        return {"kernel": kernel / total}
+
+    def apply(self, image: NDArray, kernel: NDArray | None = None, **params: Any) -> NDArray:
+        return cv2.filter2D(image, ddepth=-1, kernel=kernel)
+
+
+class GaussNoise(ImageOnlyTransform):
+    """Add zero-mean Gaussian noise.
+
+    ``std_range`` is the standard deviation as a fraction of the 0-255 intensity
+    range, so 0.05 means a standard deviation of about 12.75 grey levels.
+    """
+
+    def __init__(
+        self,
+        std_range: tuple[float, float] = (0.0, 0.05),
+        mean_range: tuple[float, float] = (0.0, 0.0),
+        per_channel: bool = True,
+        p: float = 0.5,
+    ) -> None:
+        super().__init__(p=p)
+        self.std_range = std_range
+        self.mean_range = mean_range
+        self.per_channel = per_channel
+
+    def get_params(
+        self, image: NDArray, keypoints: NDArray, bboxes: NDArray, rng: np.random.Generator
+    ) -> dict[str, Any]:
+        std = float(rng.uniform(*self.std_range)) * 255.0
+        mean = float(rng.uniform(*self.mean_range)) * 255.0
+        shape = image.shape if self.per_channel else (*image.shape[:2], 1)
+        return {"noise": rng.normal(mean, std, size=shape).astype(np.float32)}
+
+    def apply(self, image: NDArray, noise: NDArray | None = None, **params: Any) -> NDArray:
+        noisy = image.astype(np.float32) + noise
+        if np.issubdtype(image.dtype, np.integer):
+            info = np.iinfo(image.dtype)
+            return np.clip(noisy, info.min, info.max).astype(image.dtype)
+        return noisy.astype(image.dtype)
+
+
+class ElasticTransform(DualTransform):
+    """Warp the image with a smoothed random displacement field.
+
+    The same field is exposed through the transform parameters so that annotations
+    can be moved with exactly the field the image was warped by.
+    """
+
+    def __init__(
+        self,
+        alpha: float = 1.0,
+        sigma: float = 50.0,
+        interpolation: int = cv2.INTER_LINEAR,
+        border_mode: int = cv2.BORDER_CONSTANT,
+        value: float | Sequence[float] = 0,
+        approximate: bool = False,
+        same_dxdy: bool = False,
+        p: float = 0.5,
+    ) -> None:
+        super().__init__(p=p)
+        self.alpha = alpha
+        self.sigma = sigma
+        self.interpolation = interpolation
+        self.border_mode = border_mode
+        self.value = value
+        self.approximate = approximate
+        self.same_dxdy = same_dxdy
+
+    def _displacement(self, shape: tuple[int, int], rng: np.random.Generator) -> NDArray:
+        h, w = shape
+        field = rng.random((h, w), dtype=np.float32) * 2 - 1
+        # A large kernel is what makes the field smooth, and therefore the warp
+        # locally rigid; `approximate` trades exactness for a fixed 17x17 kernel.
+        ksize = (17, 17) if self.approximate else (0, 0)
+        cv2.GaussianBlur(field, ksize, self.sigma, dst=field)
+        return field * self.alpha
+
+    def get_params(
+        self, image: NDArray, keypoints: NDArray, bboxes: NDArray, rng: np.random.Generator
+    ) -> dict[str, Any]:
+        h, w = image.shape[:2]
+        dx = self._displacement((h, w), rng)
+        dy = dx if self.same_dxdy else self._displacement((h, w), rng)
+        y, x = np.meshgrid(np.arange(h, dtype=np.float32), np.arange(w, dtype=np.float32), indexing="ij")
+        return {"map_x": np.float32(x + dx), "map_y": np.float32(y + dy)}
+
+    def apply(self, image: NDArray, map_x: NDArray | None = None, map_y: NDArray | None = None, **params: Any) -> NDArray:
+        return cv2.remap(
+            image, map_x, map_y, interpolation=self.interpolation,
+            borderMode=self.border_mode, borderValue=self.value,
+        )
+
+    def apply_to_keypoints(self, keypoints: NDArray, map_x: NDArray | None = None, map_y: NDArray | None = None, **params: Any) -> NDArray:
+        """Move keypoints by inverting the displacement field at their location.
+
+        ``map_x``/``map_y`` say where each output pixel reads from, so the shift a
+        point at ``(x, y)`` undergoes is the negation of the field sampled there.
+        """
+        keypoints = keypoints.copy()
+        if not len(keypoints):
+            return keypoints
+        h, w = map_x.shape
+        xs = np.clip(np.round(keypoints[:, 0]).astype(int), 0, w - 1)
+        ys = np.clip(np.round(keypoints[:, 1]).astype(int), 0, h - 1)
+        keypoints[:, 0] -= map_x[ys, xs] - xs
+        keypoints[:, 1] -= map_y[ys, xs] - ys
+        return keypoints
+
+
+class CoarseDropout(DualTransform):
+    """Blank out rectangular regions of the image.
+
+    Annotations are deliberately left in place: a dropped-out region hides evidence
+    but does not mean the animal is absent. Callers that need keypoints inside holes
+    marked invisible do so themselves.
+    """
+
+    def __init__(
+        self,
+        num_holes_range: tuple[int, int] = (1, 1),
+        hole_height_range: tuple[int, int] = (8, 8),
+        hole_width_range: tuple[int, int] = (8, 8),
+        fill_value: float | Sequence[float] = 0,
+        p: float = 0.5,
+    ) -> None:
+        super().__init__(p=p)
+        self.num_holes_range = num_holes_range
+        self.hole_height_range = hole_height_range
+        self.hole_width_range = hole_width_range
+        self.fill_value = fill_value
+
+    @staticmethod
+    def _size(bounds: tuple[int, int], extent: int, rng: np.random.Generator) -> int:
+        low, high = bounds
+        if isinstance(low, float) or isinstance(high, float):
+            low, high = int(low * extent), int(high * extent)
+        return int(rng.integers(low, high + 1)) if high > low else int(low)
+
+    def get_params(
+        self, image: NDArray, keypoints: NDArray, bboxes: NDArray, rng: np.random.Generator
+    ) -> dict[str, Any]:
+        h, w = image.shape[:2]
+        low, high = self.num_holes_range
+        count = int(rng.integers(low, high + 1)) if high > low else int(low)
+        holes = []
+        for _ in range(count):
+            hole_h = self._size(self.hole_height_range, h, rng)
+            hole_w = self._size(self.hole_width_range, w, rng)
+            y1 = int(rng.integers(0, max(1, h - hole_h + 1)))
+            x1 = int(rng.integers(0, max(1, w - hole_w + 1)))
+            holes.append((x1, y1, min(x1 + hole_w, w), min(y1 + hole_h, h)))
+        return {"holes": holes}
+
+    def apply(self, image: NDArray, holes: Sequence[tuple[int, int, int, int]] = (), **params: Any) -> NDArray:
+        image = image.copy()
+        for x1, y1, x2, y2 in holes:
+            image[y1:y2, x1:x2] = self.fill_value
+        return image
