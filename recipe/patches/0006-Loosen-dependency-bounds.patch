From dc7100f848352a2bb1d45c0ceafc458d7ebc6a45 Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Fri, 4 Sep 2026 12:59:26 -0400
Subject: [PATCH] Loosen dependency bounds

DeepLabCut caps several widely used dependencies more tightly than the code
requires, which needlessly holds back the whole environment:

* numpy: drop the `<2` cap. The three upstream commits backported ahead of
  this patch are what make that safe; the floor is raised to 1.22.4 to match
  the np.percentile(method=) spelling they introduce.
* filelock, matplotlib, pandas, pydantic: drop the upper caps. Nothing in the
  code depends on the capped majors being absent.
* packaging: `>=26` is far in excess of what is used -- only Version and
  InvalidVersion from packaging.version, both long-standing API.

The albumentations cap is deliberately left alone. DeepLabCut subclasses
albumentations transforms and overrides apply_to_bbox()/apply_to_keypoint(),
uses A.keypoint_scale(), and relies on targets_as_params /
get_params_dependent_on_targets(). albumentations 1.4.15 replaced all of that
with a batched API, so anything newer would silently stop transforming
keypoints rather than fail loudly. That cap is a real incompatibility, not a
defensive pin.
---
 pyproject.toml | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 6e49bfb..598a7cf 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -32,21 +32,21 @@ dependencies = [
   "albumentations<=1.4.3",
   "dlclibrary>=0.0.12",
   "einops",
-  "filelock>=3.12,<3.16",
+  "filelock>=3.12",
   "filterpy>=1.4.4",
   "h5py>=3.15.1; platform_system=='Darwin'",
   "huggingface-hub>=0.23",
   "imageio-ffmpeg",
-  "matplotlib>=3.3,<3.9,!=3.7,!=3.7.1",
+  "matplotlib>=3.3,!=3.7,!=3.7.1",
   "networkx>=2.6",
   "numba>=0.54",
-  "numpy>=1.18.5,<2",
-  "packaging>=26",
+  "numpy>=1.22.4",
+  "packaging>=20",
   # Migration to pandas 3.0 is tracked in https://github.com/DeepLabCut/DeepLabCut/issues/3362.
-  "pandas[hdf5,performance]>=2.2,<3",
+  "pandas[hdf5,performance]>=2.2",
   "pillow>=7.1",
   "pycocotools",
-  "pydantic>=2,<3",
+  "pydantic>=2",
   "pyyaml",
   "ruamel-yaml>=0.15",
   "scikit-image>=0.17",
