+"""The pandas call sites that pandas 3.0 changed under DeepLabCut.
+
+Three of them, and they fail in three different ways:
+
+* ``DataFrame.groupby(axis=1)`` and ``DataFrame.stack(dropna=...)`` were
+  deprecated in pandas 2.1/2.2 and deleted in 3.0, so they raise.  A test that
+  runs the call site catches those -- but only on pandas >= 3, so each is
+  paired with an AST check that is red on any pandas version.
+* ``DataFrame.stack()`` swapping to the ``future_stack`` implementation is
+  *silent*: it no longer drops the rows that are entirely NA.  Nothing raises;
+  the caller simply gets rows it used to be shielded from.  Only a test that
+  asserts the value catches that one, so the ``SkeletonBuilder`` tests below
+  assert which frame is picked, not that picking did not blow up.
+
+Every assertion here is the pandas 2.2 result, i.e. an oracle from the
+behaviour that upstream's ``pandas<3`` cap used to guarantee.
+"""
+
+from __future__ import annotations
+
+import ast
+import types
+from pathlib import Path
+
+import matplotlib
+
+matplotlib.use("Agg")
+
+import numpy as np
+import pandas as pd
+import pytest
+
+import deeplabcut
+from deeplabcut.utils.skeleton import SkeletonBuilder
+
+PACKAGE_ROOT = Path(deeplabcut.__file__).parent
+
+SCORER = "sc"
+INDIVIDUALS = ["ind1", "ind2", "ind3", "ind4"]
+BODYPARTS = ["snout", "tail", "left", "right"]
+
+
+def _multi_animal_frame(n_frames: int = 6, seed: int = 0) -> pd.DataFrame:
+    """Only ``(img0, ind1)`` is fully labelled; ``ind4`` never is."""
+    columns = pd.MultiIndex.from_product(
+        [[SCORER], INDIVIDUALS, BODYPARTS, ["x", "y"]],
+        names=["scorer", "individuals", "bodyparts", "coords"],
+    )
+    index = pd.MultiIndex.from_tuples(
+        [("labeled-data", "vid", f"img{i}.png") for i in range(n_frames)]
+    )
+    rng = np.random.default_rng(seed)
+    df = pd.DataFrame(rng.uniform(10, 90, (n_frames, len(columns))), index=index, columns=columns)
+    for i in range(n_frames):
+        for j, individual in enumerate(INDIVIDUALS):
+            if i == 0 and j == 0:
+                continue
+            if individual == "ind4":
+                df.loc[index[i], (SCORER, individual)] = np.nan
+            else:
+                df.loc[index[i], (SCORER, individual, BODYPARTS[(i + j) % len(BODYPARTS)])] = np.nan
+    return df
+
+
+def _single_animal_frame(n_frames: int = 6, seed: int = 0) -> pd.DataFrame:
+    """Only ``img5`` is fully labelled."""
+    columns = pd.MultiIndex.from_product(
+        [[SCORER], BODYPARTS, ["x", "y"]],
+        names=["scorer", "bodyparts", "coords"],
+    )
+    index = pd.MultiIndex.from_tuples(
+        [("labeled-data", "vid", f"img{i}.png") for i in range(n_frames)]
+    )
+    rng = np.random.default_rng(seed)
+    df = pd.DataFrame(rng.uniform(10, 90, (n_frames, len(columns))), index=index, columns=columns)
+    for i in range(n_frames - 1):
+        df.loc[index[i], (SCORER, BODYPARTS[i % len(BODYPARTS)])] = np.nan
+    return df
+
+
+# --------------------------------------------------------------------------- #
+# deeplabcut/utils/skeleton.py -- SkeletonBuilder.pick_labeled_frame
+# --------------------------------------------------------------------------- #
+def test_pick_labeled_frame_only_ever_returns_a_maximally_labeled_animal():
+    """``pick_labeled_frame`` docstring: "Find the most 'complete' animal"."""
+    df = _multi_animal_frame()
+    builder = types.SimpleNamespace(df=df)
+    picks = set()
+    for seed in range(40):
+        np.random.seed(seed)
+        picks.add(SkeletonBuilder.pick_labeled_frame(builder))
+
+    # (img0, ind1) is the only animal without a missing bodypart.
+    assert picks == {(("labeled-data", "vid", "img0.png"), "ind1")}
+
+    for row, col in picks:
+        xy = df.xs(col, axis=1, level="individuals").loc[row].to_numpy().reshape((-1, 2))
+        assert not np.isnan(xy).any()
+
+
+def test_pick_labeled_frame_single_animal_branch():
+    df = _single_animal_frame()
+    builder = types.SimpleNamespace(df=df)
+    picks = set()
+    for seed in range(40):
+        np.random.seed(seed)
+        picks.add(SkeletonBuilder.pick_labeled_frame(builder))
+
+    assert picks == {(("labeled-data", "vid", "img5.png"), 0)}
+
+    for row, _ in picks:
+        assert not np.isnan(df.loc[row].to_numpy()).any()
+
+
+def test_skeleton_builder_constructs_on_a_mostly_unlabeled_project(tmp_path):
+    """The crash the silent ``stack`` change produces two lines further down.
+
+    ``__init__`` feeds the picked animal's coordinates to ``scipy.spatial.KDTree``,
+    which rejects NaN, so picking an incompletely labelled animal is not a
+    degradation but a hard failure.
+    """
+    iio = pytest.importorskip("imageio.v3")
+
+    labeled = tmp_path / "labeled-data" / "vid"
+    labeled.mkdir(parents=True)
+    df = _multi_animal_frame()
+    df.to_hdf(labeled / f"CollectedData_{SCORER}.h5", key="df_with_missing", mode="w")
+    for i in range(len(df)):
+        iio.imwrite(labeled / f"img{i}.png", np.zeros((100, 100, 3), np.uint8))
+
+    config = tmp_path / "config.yaml"
+    config.write_text(
+        "Task: t\n"
+        f"scorer: {SCORER}\n"
+        "date: d\n"
+        f"project_path: {tmp_path}\n"
+        "individuals:\n" + "".join(f"- {i}\n" for i in INDIVIDUALS) + "multianimalbodyparts:\n"
+        + "".join(f"- {b}\n" for b in BODYPARTS)
+        + "uniquebodyparts: []\n"
+        "bodyparts: MULTI!\n"
+        "skeleton: []\n"
+        "skeleton_color: black\n"
+        "dotsize: 8\n"
+        "alphavalue: 0.7\n"
+        "colormap: rainbow\n"
+        "video_sets: {}\n"
+        "iteration: 0\n"
+    )
+
+    np.random.seed(0)
+    builder = SkeletonBuilder(str(config))
+    assert not np.isnan(builder.xy).any()
+
+
+# --------------------------------------------------------------------------- #
+# deeplabcut/benchmark/metrics.py -- _format_gt_data
+# --------------------------------------------------------------------------- #
+def test_format_gt_data_keeps_a_row_for_every_animal(tmp_path):
+    from deeplabcut.benchmark import metrics
+
+    df = _multi_animal_frame(n_frames=3)
+    h5 = tmp_path / "CollectedData_sc.h5"
+    df.to_hdf(h5, key="df_with_missing", mode="w")
+
+    out = metrics._format_gt_data(str(h5))
+    assert out["metadata"]["animals"] == INDIVIDUALS
+    assert out["metadata"]["keypoints"] == BODYPARTS
+    assert len(out["annotations"]) == 3
+    for arr in out["annotations"].values():
+        # (n_animals, n_bodyparts, 2) -- ind4 is all NaN but must still be there.
+        assert arr.shape == (len(INDIVIDUALS), len(BODYPARTS), 2)
+    first = out["annotations"][Path("labeled-data", "vid", "img0.png")]
+    assert not np.isnan(first[0]).any()
+    assert np.isnan(first[3]).all()
+
+
+# --------------------------------------------------------------------------- #
+# deeplabcut/gui/tracklet_toolbox.py -- TrackletVisualizer.export_to_training_data
+# --------------------------------------------------------------------------- #
+def _export_to_training_data_filter():
+    """Compile the keypoint filter out of ``tracklet_toolbox.py``.
+
+    The statement lives inside a Qt widget method, so it is read from the
+    source rather than imported: the test must not need a Qt binding to run.
+    """
+    source = (PACKAGE_ROOT / "gui" / "tracklet_toolbox.py").read_text()
+    tree = ast.parse(source)
+    (visualizer,) = [
+        node
+        for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == "TrackletVisualizer"
+    ]
+    (export,) = [
+        node
+        for node in visualizer.body
+        if isinstance(node, ast.FunctionDef) and node.name == "export_to_training_data"
+    ]
+    body = []
+    for node in export.body:
+        if isinstance(node, ast.FunctionDef) and node.name == "filter_low_prob":
+            body.append(node)
+        elif body and isinstance(node, ast.Assign):
+            body.append(node)
+            break
+    assert len(body) == 2, "the keypoint filter moved; update this test"
+
+    module = ast.Module(body=body, type_ignores=[])
+    ast.fix_missing_locations(module)
+    code = compile(module, "<tracklet_toolbox>", "exec")
+
+    def run(df, pcutoff):
+        namespace = {"np": np, "pd": pd, "df": df, "pcutoff": pcutoff}
+        exec(code, namespace)
+        return namespace["df"]
+
+    return run
+
+
+def test_export_to_training_data_blanks_uncertain_keypoints():
+    """Runs the shipped statement; on pandas >= 3 ``axis=1`` raises TypeError."""
+    columns = pd.MultiIndex.from_product(
+        [[SCORER], ["ind2", "ind1"], ["tail", "snout"], ["x", "y", "likelihood"]],
+        names=["scorer", "individuals", "bodyparts", "coords"],
+    )
+    rng = np.random.default_rng(3)
+    df = pd.DataFrame(rng.random((4, len(columns))), columns=columns)
+
+    out = _export_to_training_data_filter()(df.copy(), 0.5)
+
+    # Column order and identity survive the grouping.
+    assert out.columns.equals(df.columns)
+
+    # pandas 2.2 reference: within each bodypart group the rows whose *first*
+    # likelihood column is below the cutoff are blanked across the group.
+    expected = df.copy()
+    for bodypart in df.columns.get_level_values("bodyparts").unique():
+        group = df.loc[:, df.columns.get_level_values("bodyparts") == bodypart]
+        mask = group.iloc[:, 2] < 0.5
+        expected.loc[mask, group.columns] = np.nan
+    pd.testing.assert_frame_equal(out, expected)
+    assert out.isna().to_numpy().any(), "the fixture must exercise the cutoff"
+
+
+# --------------------------------------------------------------------------- #
+# Package-wide: the two keywords pandas 3.0 deleted
+# --------------------------------------------------------------------------- #
+def _calls(name):
+    for path in sorted(PACKAGE_ROOT.rglob("*.py")):
+        try:
+            tree = ast.parse(path.read_text())
+        except SyntaxError:  # pragma: no cover - not our source
+            continue
+        for node in ast.walk(tree):
+            if (
+                isinstance(node, ast.Call)
+                and isinstance(node.func, ast.Attribute)
+                and node.func.attr == name
+            ):
+                yield path, node
+
+
+def test_no_call_passes_axis_to_groupby():
+    """``DataFrame.groupby(axis=...)`` was deleted in pandas 3.0."""
+    offenders = [
+        f"{path.relative_to(PACKAGE_ROOT)}:{node.lineno}"
+        for path, node in _calls("groupby")
+        if any(kw.arg == "axis" for kw in node.keywords)
+    ]
+    assert offenders == []
+
+
+def test_no_call_passes_dropna_to_stack():
+    """``DataFrame.stack(dropna=...)`` was deleted in pandas 3.0."""
+    offenders = [
+        f"{path.relative_to(PACKAGE_ROOT)}:{node.lineno}"
+        for path, node in _calls("stack")
+        if any(kw.arg == "dropna" for kw in node.keywords)
+    ]
+    assert offenders == []
