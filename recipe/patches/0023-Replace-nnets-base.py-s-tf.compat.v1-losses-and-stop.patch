+# Licensed under GNU Lesser General Public License v3.0
+#
+"""The three losses ``BasePoseNet.train`` uses, without ``tf.compat.v1``.
+
+``tf.compat.v1.losses.*`` reduce with ``Reduction.SUM_BY_NONZERO_WEIGHTS``,
+which is **not** ``tf.reduce_mean``: it divides by the number of elements the
+weight tensor is non-zero at, after broadcasting, rather than by the number of
+elements.  DeepLabCut passes a 0/1 mask as ``weights`` for its locref and
+pairwise terms, so for those the denominator is the count of *unmasked*
+elements.
+
+That distinction is invisible on a stock multi-animal project and severe on a
+single-animal one.  ``pose_multianimal_imgaug`` builds ``np.ones(locref_size)``
+unless ``weigh_only_present_joints`` is set, and that key defaults to False, so
+maDLC masks are dense and ``reduce_mean`` happens to agree exactly.  The
+single-animal loaders mask down to the labelled keypoints, where the mask is
+non-zero on well under 1% of elements, and ``reduce_mean`` is then several
+hundred times too small -- which rescales the locref term against the
+part-detection term without making training visibly fail.
+"""
+import tensorflow as tf
+
+
+def sum_by_nonzero_weights(losses, weights):
+    """``tf.compat.v1.losses.Reduction.SUM_BY_NONZERO_WEIGHTS``.
+
+    ``sum(losses * weights) / count(broadcast weights != 0)``, and 0.0 rather
+    than nan when nothing is weighted -- a batch can carry an all-zero mask
+    when it holds no labelled keypoint of some type.
+    """
+    weights = tf.convert_to_tensor(weights, dtype=losses.dtype)
+    broadcast = tf.broadcast_to(weights, tf.shape(losses))
+    count = tf.reduce_sum(tf.cast(tf.not_equal(broadcast, 0.0), losses.dtype))
+    return tf.math.divide_no_nan(tf.reduce_sum(losses * broadcast), count)
+
+
+def sigmoid_cross_entropy(multi_class_labels, logits, weights=1.0):
+    """``tf.compat.v1.losses.sigmoid_cross_entropy`` with ``label_smoothing=0``.
+
+    ``BasePoseNet.train`` never passes a smoothing, so the labels are used as
+    they are; the v1 helper would otherwise rewrite them as
+    ``labels * (1 - s) + 0.5 * s``.
+    """
+    losses = tf.nn.sigmoid_cross_entropy_with_logits(
+        labels=tf.cast(multi_class_labels, logits.dtype), logits=logits
+    )
+    return sum_by_nonzero_weights(losses, weights)
+
+
+def huber_loss(labels, predictions, weights=1.0, delta=1.0):
+    """``tf.compat.v1.losses.huber_loss``, whose ``delta`` also defaults to 1.0.
+
+    The argument order is the v1 one, ``(labels, predictions, weights)``, since
+    ``train()`` calls it as ``loss_func(locref_targets, locref_pred, mask)``.
+    """
+    error = tf.cast(labels, predictions.dtype) - predictions
+    absolute = tf.abs(error)
+    delta = tf.convert_to_tensor(delta, dtype=predictions.dtype)
+    quadratic = tf.minimum(absolute, delta)
+    linear = absolute - quadratic
+    return sum_by_nonzero_weights(0.5 * quadratic**2 + delta * linear, weights)
+
+
+def mean_squared_error(labels, predictions, weights=1.0):
+    """``tf.compat.v1.losses.mean_squared_error``.
+
+    Despite the name this reduces by ``SUM_BY_NONZERO_WEIGHTS`` as well, so it
+    is neither ``tf.keras.losses.MeanSquaredError`` nor ``reduce_mean``.
+    Reached only when ``locref_huber_loss`` or ``pairwise_huber_loss`` is off.
+    """
+    losses = tf.math.squared_difference(tf.cast(labels, predictions.dtype), predictions)
+    return sum_by_nonzero_weights(losses, weights)
