+@pytest.mark.parametrize("huber", [True, False])
+@pytest.mark.parametrize("weigh_parts", [False, True])
+@pytest.mark.parametrize("interm", [False, True])
+def test_train_matches_tf_compat_v1_losses(huber, weigh_parts, interm):
+    """The real train() body, run twice on the same heads, old losses vs new."""
+    rng = np.random.RandomState(4)
+    cfg = _train_cfg(
+        locref_huber_loss=huber,
+        pairwise_huber_loss=huber,
+        weigh_part_predictions=weigh_parts,
+        intermediate_supervision=interm,
+    )
+    heads = {
+        "part_pred": tf.constant((rng.normal(size=SHAPE) * 3).astype("float32")),
+        "locref": tf.constant(rng.normal(size=WIDE).astype("float32")),
+        "pairwise_pred": tf.constant(rng.normal(size=WIDE).astype("float32")),
+    }
+    if interm:
+        heads["part_pred_interm"] = tf.constant(rng.normal(size=SHAPE).astype("float32"))
+    batch = {
+        Batch.inputs: tf.zeros([1, 1, 1, 3]),
+        Batch.part_score_targets: tf.constant((rng.uniform(size=SHAPE) < 0.1).astype("float32")),
+        Batch.part_score_weights: tf.constant((rng.uniform(size=SHAPE) < 0.08).astype("float32")),
+        Batch.locref_targets: tf.constant(rng.normal(size=WIDE).astype("float32")),
+        Batch.locref_mask: tf.constant((rng.uniform(size=WIDE) < 0.02).astype("float32")),
+        Batch.pairwise_targets: tf.constant(rng.normal(size=WIDE).astype("float32")),
+        Batch.pairwise_mask: tf.constant((rng.uniform(size=WIDE) < 0.02).astype("float32")),
+    }
+    net = _FixedHeads(cfg, heads)
+
+    got = {k: float(v) for k, v in net.train(batch).items()}
+
+    saved = {name: getattr(nnets_base, name) for name in
+             ("sigmoid_cross_entropy", "huber_loss", "mean_squared_error")}
+    try:
+        nnets_base.sigmoid_cross_entropy = tf.compat.v1.losses.sigmoid_cross_entropy
+        nnets_base.huber_loss = tf.compat.v1.losses.huber_loss
+        nnets_base.mean_squared_error = tf.compat.v1.losses.mean_squared_error
+        expected = {k: float(v) for k, v in net.train(batch).items()}
+    finally:
+        for name, fn in saved.items():
+            setattr(nnets_base, name, fn)
+
+    assert set(got) == set(expected)
+    expected_terms = {"part_loss", "locref_loss", "pairwise_loss", "total_loss"}
+    if interm:
+        expected_terms.add("part_loss_interm")
+    assert set(got) == expected_terms
+    for key in expected:
