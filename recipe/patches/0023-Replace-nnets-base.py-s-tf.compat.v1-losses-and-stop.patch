diff --git a/tests/test_nnets_losses.py b/tests/test_nnets_losses.py
new file mode 100644
index 00000000..218dbb18
--- /dev/null
+++ b/tests/test_nnets_losses.py
@@ -0,0 +1,230 @@
+#
+# DeepLabCut Toolbox (deeplabcut.org)
+# © A. & M.W. Mathis Labs
+# https://github.com/DeepLabCut/DeepLabCut
+#
+# Please see AUTHORS for contributors.
+# https://github.com/DeepLabCut/DeepLabCut/blob/master/AUTHORS
+#
+# Licensed under GNU Lesser General Public License v3.0
+#
+"""nnets/losses.py must equal the tf.compat.v1.losses helpers it replaced.
+
+The reduction is the whole point: tf.compat.v1.losses.* use
+SUM_BY_NONZERO_WEIGHTS, which divides by the number of non-zero broadcast
+weights rather than by the number of elements.  DeepLabCut passes a 0/1 mask
+for its locref and pairwise terms, so on a single-animal project -- where the
+mask is non-zero on well under 1% of elements -- tf.reduce_mean is hundreds of
+times too small.  On a stock multi-animal project the mask is all ones and
+reduce_mean happens to agree exactly, which is what makes the mistake easy to
+make and hard to notice.
+"""
+import numpy as np
+import pytest
+
+tf = pytest.importorskip("tensorflow")
+
+from deeplabcut.pose_estimation_tensorflow.datasets import Batch  # noqa: E402
+from deeplabcut.pose_estimation_tensorflow.nnets import base as nnets_base  # noqa: E402
+from deeplabcut.pose_estimation_tensorflow.nnets.losses import (  # noqa: E402
+    huber_loss,
+    mean_squared_error,
+    sigmoid_cross_entropy,
+    sum_by_nonzero_weights,
+)
+
+
+@pytest.fixture(scope="module", autouse=True)
+def eager():
+    """Same contract as the other Keras test modules: turn eager on, leave it on."""
+    try:
+        nnets_base.ensure_eager_execution()
+    except RuntimeError as err:
+        pytest.skip(str(err))
+    yield
+
+
+SHAPE = (2, 9, 7, 4)
+WIDE = (2, 9, 7, 8)
+
+
+def _weights(kind, shape, rng):
+    if kind == "scalar_one":
+        return 1.0
+    if kind == "dense_mask":
+        return np.ones(shape, "float32")
+    if kind == "sparse_mask":
+        return (rng.uniform(size=shape) < 0.02).astype("float32")
+    if kind == "fractional":
+        return (rng.uniform(size=shape) * 3.0).astype("float32")
+    if kind == "broadcast":
+        return (rng.uniform(size=shape[:-1] + (1,)) < 0.3).astype("float32")
+    if kind == "all_zero":
+        return np.zeros(shape, "float32")
+    raise AssertionError(kind)
+
+
+WEIGHTS = ["scalar_one", "dense_mask", "sparse_mask", "fractional", "broadcast", "all_zero"]
+
+
+@pytest.mark.parametrize("kind", WEIGHTS)
+def test_sigmoid_cross_entropy_matches_tf_compat_v1(kind):
+    rng = np.random.RandomState(0)
+    labels = (rng.uniform(size=SHAPE) < 0.1).astype("float32")
+    logits = (rng.normal(size=SHAPE) * 3).astype("float32")
+    weights = _weights(kind, SHAPE, rng)
+    expected = tf.compat.v1.losses.sigmoid_cross_entropy(labels, logits, weights)
+    got = sigmoid_cross_entropy(labels, logits, weights)
+    assert float(got) == float(expected)
+
+
+@pytest.mark.parametrize("kind", WEIGHTS)
+@pytest.mark.parametrize("fn,reference", [
+    (huber_loss, tf.compat.v1.losses.huber_loss),
+    (mean_squared_error, tf.compat.v1.losses.mean_squared_error),
+])
+def test_regression_losses_match_tf_compat_v1(kind, fn, reference):
+    rng = np.random.RandomState(1)
+    labels = rng.normal(size=WIDE).astype("float32")
+    predictions = rng.normal(size=WIDE).astype("float32")
+    weights = _weights(kind, WIDE, rng)
+    assert float(fn(labels, predictions, weights)) == float(reference(labels, predictions, weights))
+
+
+def test_huber_delta_is_one_and_the_knee_is_in_the_right_place():
+    labels = tf.constant([0.0, 0.0, 0.0], tf.float32)
+    predictions = tf.constant([0.5, 1.0, 3.0], tf.float32)
+    expected = tf.compat.v1.losses.huber_loss(
+        labels, predictions, reduction=tf.compat.v1.losses.Reduction.NONE
+    )
+    got = 0.5 * tf.minimum(tf.abs(predictions), 1.0) ** 2 + 1.0 * (
+        tf.abs(predictions) - tf.minimum(tf.abs(predictions), 1.0)
+    )
+    np.testing.assert_array_equal(got.numpy(), expected.numpy())
+    # quadratic below the knee, linear above it
+    np.testing.assert_allclose(expected.numpy(), [0.125, 0.5, 2.5], rtol=0, atol=0)
+
+
+def test_an_all_zero_mask_gives_zero_not_nan():
+    rng = np.random.RandomState(2)
+    labels = rng.normal(size=WIDE).astype("float32")
+    predictions = rng.normal(size=WIDE).astype("float32")
+    zero = np.zeros(WIDE, "float32")
+    for fn in (huber_loss, mean_squared_error):
+        value = float(fn(labels, predictions, zero))
+        assert value == 0.0
+        assert np.isfinite(value)
+
+
+def test_reduce_mean_is_not_the_same_reduction():
+    """Guards the whole point of nnets/losses.py against a later simplification.
+
+    On a sparse mask -- what a single-animal project produces -- reduce_mean is
+    hundreds of times smaller; on a dense one it coincides, which is the trap.
+    """
+    rng = np.random.RandomState(3)
+    labels = rng.normal(size=WIDE).astype("float32")
+    predictions = rng.normal(size=WIDE).astype("float32")
+    elementwise = tf.abs(labels - predictions)  # any elementwise loss will do
+
+    sparse = (rng.uniform(size=WIDE) < 0.01).astype("float32")
+    correct = float(sum_by_nonzero_weights(elementwise, sparse))
+    naive = float(tf.reduce_mean(elementwise * sparse))
+    assert correct > 50 * naive
+
+    dense = np.ones(WIDE, "float32")
+    assert float(sum_by_nonzero_weights(elementwise, dense)) == float(tf.reduce_mean(elementwise))
+
+
+def test_sum_by_nonzero_weights_counts_after_broadcasting():
+    losses = tf.ones((2, 4, 4, 3), tf.float32)
+    weights = np.zeros((2, 4, 4, 1), "float32")
+    weights[0, 0, 0, 0] = 1.0  # one position, three channels once broadcast
+    assert float(sum_by_nonzero_weights(losses, weights)) == 1.0
+    assert float(tf.reduce_sum(tf.broadcast_to(tf.constant(weights), tf.shape(losses)))) == 3.0
+
+
+# ---------------------------------------------------------------------------
+# through BasePoseNet.train()
+# ---------------------------------------------------------------------------
+class _FixedHeads(nnets_base.BasePoseNet):
+    """A pose net with given heads, so train() is the only thing under test."""
+
+    def __init__(self, cfg, heads):
+        super().__init__(cfg)
+        self._fixed_heads = heads
+
+    def extract_features(self, inputs):
+        raise NotImplementedError
+
+    def get_net(self, inputs, is_training=False):
+        return self._fixed_heads
+
+
+def _train_cfg(**kwargs):
+    cfg = {
+        "weigh_part_predictions": False,
