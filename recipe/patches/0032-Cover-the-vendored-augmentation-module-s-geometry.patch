+def test_normalize_uses_the_imagenet_statistics(value, expected):
+    """(x - 255 * mean) / (255 * std), per channel, in float32."""
+    image = np.full((4, 6, 3), value, np.uint8)
+    out = aug.Normalize().apply(image)
+    assert out.dtype == np.float32
+    assert out.shape == (4, 6, 3)
+    np.testing.assert_allclose(out[0, 0], expected, rtol=1e-6)
