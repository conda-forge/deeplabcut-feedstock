+"""Geometry contract for the vendored augmentation module.
+
+Every expected value below was measured on albumentations 1.4.1 -- the version the
+PyTorch data pipeline depended on before it was vendored -- driven through
+``Compose`` the way ``deeplabcut.pose_estimation_pytorch.data.utils.apply_transform``
+drives it: image, keypoints, bounding boxes and label fields together.
+
+These are the numbers that decide where a keypoint lands in a training batch. An
+error here does not raise, it silently degrades every model trained afterwards, so
+the values are written out literally rather than recomputed from the same formulas
+the implementation uses.
+"""
+from __future__ import annotations
+
+import cv2
+import numpy as np
+import pytest
+
+from deeplabcut.pose_estimation_pytorch.data import augmentation as aug
+from deeplabcut.pose_estimation_pytorch.data import transforms as T
+
+
+# --------------------------------------------------------------------------------
+# helpers
+# --------------------------------------------------------------------------------
+def run(pipeline, image, keypoints, bboxes):
+    """Drive a pipeline exactly as ``utils.apply_transform`` does."""
+    keypoints = np.asarray(keypoints, dtype=float).reshape(-1, 3)
+    bboxes = np.asarray(bboxes, dtype=float).reshape(-1, 4)
+    out = pipeline(
+        image=image,
+        keypoints=keypoints,
+        class_labels=list(range(len(keypoints))),
+        bboxes=bboxes,
+        bbox_labels=np.arange(len(bboxes)),
+    )
+    return (
+        np.asarray(out["image"]),
+        np.asarray(out["keypoints"], dtype=float).reshape(-1, 3),
+        np.asarray(out["bboxes"], dtype=float).reshape(-1, 4),
+        list(out["bbox_labels"]),
+    )
+
+
+def build(cfg):
+    return T.build_transforms(cfg)
+
+
+IMAGE_H, IMAGE_W = 40, 60
+# three keypoints: an interior one, the top-left corner and the bottom-right corner
+KEYPOINTS = [(10.0, 20.0, 2.0), (0.0, 0.0, 2.0), (59.0, 39.0, 2.0)]
+BBOXES = [(10.0, 20.0, 20.0, 10.0)]  # COCO x, y, w, h -> corners (10, 20, 30, 30)
+
+
+@pytest.fixture
+def image():
+    # a gradient, so a wrongly placed crop or pad is visible in the pixels too
+    y, x = np.mgrid[:IMAGE_H, :IMAGE_W]
+    return np.stack([(x * 4) % 256, (y * 6) % 256, ((x + y) * 3) % 256], axis=-1).astype(np.uint8)
+
+
+# --------------------------------------------------------------------------------
+# Resize
+# --------------------------------------------------------------------------------
+def test_resize_isotropic_moves_keypoints_and_boxes(image):
+    """Resize(20, 30) halves both axes of a 40x60 image."""
+    img, kpts, boxes, _ = run(
+        build({"resize": {"height": 20, "width": 30, "keep_ratio": False}}), image, KEYPOINTS, BBOXES
+    )
+    assert img.shape == (20, 30, 3)
+    np.testing.assert_allclose(kpts[:, :2], [[5.0, 10.0], [0.0, 0.0], [29.5, 19.5]])
+    np.testing.assert_allclose(boxes, [[5.0, 10.0, 10.0, 5.0]])
+    # the visibility column is carried through untouched
+    np.testing.assert_array_equal(kpts[:, 2], [2.0, 2.0, 2.0])
+
+
+def test_resize_anisotropic_uses_a_separate_scale_per_axis(image):
+    """Resize(10, 30) on 40x60 scales x by 1/2 and y by 1/4; the two must not be swapped."""
+    img, kpts, boxes, _ = run(
+        build({"resize": {"height": 10, "width": 30, "keep_ratio": False}}), image, KEYPOINTS, BBOXES
+    )
+    assert img.shape == (10, 30, 3)
+    np.testing.assert_allclose(kpts[:, :2], [[5.0, 5.0], [0.0, 0.0], [29.5, 9.75]])
+    np.testing.assert_allclose(boxes, [[5.0, 5.0, 10.0, 2.5]])
+
+
+def test_resize_keep_ratio_pads_at_the_top_left(image):
+    """keep_ratio scales by min(H/h, W/w) and pads the remainder at the top left.
+
+    Padding anywhere else would move every annotation by half the padding.
+    """
+    img, kpts, boxes, _ = run(
+        build({"resize": {"height": 40, "width": 40, "keep_ratio": True}}), image, KEYPOINTS, BBOXES
+    )
+    assert img.shape == (40, 40, 3)
+    scale = 40 / 60
+    np.testing.assert_allclose(kpts[:, :2], np.array([[10.0, 20.0], [0.0, 0.0], [59.0, 39.0]]) * scale)
+    # the scaled image occupies rows 0..26 and columns 0..39; the rest is zero padding
+    assert img[:27, :40].any()
+    np.testing.assert_array_equal(img[27:, :], 0)
+
+
+# --------------------------------------------------------------------------------
+# LongestMaxSize
+# --------------------------------------------------------------------------------
+def test_longest_max_size_geometry(image):
+    img, kpts, boxes, _ = run(build({"longest_max_size": 30}), image, KEYPOINTS, BBOXES)
+    assert img.shape == (20, 30, 3)
+    np.testing.assert_allclose(kpts[:, :2], [[5.0, 10.0], [0.0, 0.0], [29.5, 19.5]])
+    np.testing.assert_allclose(boxes, [[5.0, 10.0, 10.0, 5.0]])
+
+
+# --------------------------------------------------------------------------------
+# HorizontalFlip
+# --------------------------------------------------------------------------------
+def test_hflip_keypoints_use_width_minus_one_and_boxes_use_width(image):
+    """Keypoints mirror about ``width - 1``, boxes about ``width``.
+
+    The two conventions really do differ by one pixel; using the same one for both
+    shifts every flipped keypoint or box by exactly 1 px.
+    """
+    img, kpts, boxes, _ = run(build({"hflip": 1.0}), image, KEYPOINTS, BBOXES)
+    assert img.shape == (40, 60, 3)
+    np.testing.assert_allclose(kpts[:, :2], [[49.0, 20.0], [59.0, 0.0], [0.0, 39.0]])
+    np.testing.assert_allclose(boxes, [[30.0, 20.0, 20.0, 10.0]])
+    np.testing.assert_array_equal(img, image[:, ::-1])
+
+
+def test_hflip_swaps_symmetric_keypoints(image):
+    """With symmetries, index i takes the flipped position of its partner j."""
+    kp = [(10.0, 1.0, 2.0), (20.0, 2.0, 2.0), (30.0, 3.0, 2.0)]
+    _, kpts, _, _ = run(
+        build({"hflip": {"p": 1.0, "symmetries": [[0, 1]]}}), image, kp, BBOXES
+    )
+    # keypoint 0 now holds the mirrored keypoint 1 and vice versa; 2 is unpaired
+    np.testing.assert_allclose(kpts[:, :2], [[59 - 20.0, 2.0], [59 - 10.0, 1.0], [59 - 30.0, 3.0]])
+
+
+# --------------------------------------------------------------------------------
+# PadIfNeeded
+# --------------------------------------------------------------------------------
+PAD_EXPECTED = {
+    # position: (keypoints, boxes)
+    "center": ([[28.0, 32.0], [18.0, 12.0], [77.0, 51.0]], [[28.0, 32.0, 20.0, 10.0]]),
+    "top_left": ([[10.0, 20.0], [0.0, 0.0], [59.0, 39.0]], [[10.0, 20.0, 20.0, 10.0]]),
+    "top_right": ([[46.0, 20.0], [36.0, 0.0], [95.0, 39.0]], [[46.0, 20.0, 20.0, 10.0]]),
+    "bottom_left": ([[10.0, 44.0], [0.0, 24.0], [59.0, 63.0]], [[10.0, 44.0, 20.0, 10.0]]),
+    "bottom_right": ([[46.0, 44.0], [36.0, 24.0], [95.0, 63.0]], [[46.0, 44.0, 20.0, 10.0]]),
+}
+
+
+@pytest.mark.parametrize("position", sorted(PAD_EXPECTED))
+@pytest.mark.parametrize("border_mode", ["constant", "reflect_101"])
+def test_auto_padding_shifts_annotations_by_the_top_left_padding(image, position, border_mode):
+    """40x60 padded to 64x96: 24 rows and 36 columns are added.
+
+    Annotations move by the *top left* padding only, never by half of it and never
+    with x and y transposed.
+    """
+    cfg = {
+        "auto_padding": {
+            "min_height": 64,
+            "min_width": 96,
+            "pad_height_divisor": None,
+            "pad_width_divisor": None,
+            "position": position,
+            "border_mode": border_mode,
+        }
+    }
+    img, kpts, boxes, _ = run(build(cfg), image, KEYPOINTS, BBOXES)
+    expected_kpts, expected_boxes = PAD_EXPECTED[position]
+    assert img.shape == (64, 96, 3)
+    np.testing.assert_allclose(kpts[:, :2], expected_kpts)
+    np.testing.assert_allclose(boxes, expected_boxes)
+
+
+def test_auto_padding_divisor_pads_up_to_the_next_multiple(image):
+    cfg = {
+        "auto_padding": {
+            "pad_height_divisor": 32,
+            "pad_width_divisor": 32,
+            "position": "center",
+            "border_mode": "constant",
+        }
+    }
+    img, kpts, boxes, _ = run(build(cfg), image, KEYPOINTS, BBOXES)
+    assert img.shape == (64, 64, 3)  # 40 -> 64 (pad 24), 60 -> 64 (pad 4)
+    # centred padding puts 12 rows above and 2 columns to the left
+    np.testing.assert_allclose(kpts[:, :2], [[12.0, 32.0], [2.0, 12.0], [61.0, 51.0]])
+    np.testing.assert_allclose(boxes, [[12.0, 32.0, 20.0, 10.0]])
+
+
+def test_auto_padding_centre_rounds_the_odd_pixel_to_the_bottom_right(image):
+    """40x60 padded to 65x97 leaves 25 rows and 37 columns: the extra pixel goes below/right.
+
+    Centring the other way round shifts every annotation by one pixel.
+    """
+    cfg = {
+        "auto_padding": {
+            "min_height": 65,
+            "min_width": 97,
+            "pad_height_divisor": None,
+            "pad_width_divisor": None,
+            "position": "center",
+            "border_mode": "constant",
+        }
+    }
+    img, kpts, boxes, _ = run(build(cfg), image, KEYPOINTS, BBOXES)
+    assert img.shape == (65, 97, 3)
+    np.testing.assert_allclose(kpts[:, :2], [[28.0, 32.0], [18.0, 12.0], [77.0, 51.0]])
+    np.testing.assert_allclose(boxes, [[28.0, 32.0, 20.0, 10.0]], atol=1e-9)
+
+
+def test_auto_padding_divisor_leaves_an_exact_multiple_alone():
+    """A size already divisible by the divisor must not gain a whole extra block."""
+    exact = np.zeros((64, 96, 3), np.uint8)
+    cfg = {
+        "auto_padding": {
+            "pad_height_divisor": 32,
+            "pad_width_divisor": 32,
+            "position": "center",
+            "border_mode": "constant",
+        }
+    }
+    img, kpts, _, _ = run(build(cfg), exact, KEYPOINTS, BBOXES)
+    assert img.shape == (64, 96, 3)
+    np.testing.assert_allclose(kpts[:, :2], [[10.0, 20.0], [0.0, 0.0], [59.0, 39.0]])
+
+
+# --------------------------------------------------------------------------------
+# Affine
+# --------------------------------------------------------------------------------
+AFFINE_IMAGE_H, AFFINE_IMAGE_W = 41, 61
+AFFINE_KP = [(10.0, 5.0, 2.0), (30.0, 20.0, 2.0)]  # the second one is the rotation centre
+AFFINE_BB = [(10.0, 5.0, 20.0, 10.0)]
+
+
+def affine_pipeline(rotate, scale, translate):
+    """A one-transform pipeline with the affine parameters pinned to a single value."""
+    pipeline = T.build_transforms(
+        {"affine": {"p": 1.0, "rotation": 0, "scaling": [scale, scale], "translation": 0}}
+    )
+    transform = pipeline.transforms[0]
+    transform.rotate = (rotate, rotate)
+    transform.scale = (scale, scale)
+    transform.translate_px = (translate, translate)
+    transform.p = 1.0
+    return pipeline
+
+
+@pytest.fixture
+def affine_image():
+    y, x = np.mgrid[:AFFINE_IMAGE_H, :AFFINE_IMAGE_W]
+    return np.stack([(x * 4) % 256, (y * 6) % 256, ((x + y) * 3) % 256], axis=-1).astype(np.uint8)
+
+
+def test_affine_rotates_about_the_pixel_centre(affine_image):
+    """90 degrees about ((w - 1) / 2, (h - 1) / 2) = (30, 20).
+
+    Rotating about (w / 2, h / 2) instead, or about the wrong sign of the angle,
+    moves every keypoint; the centre keypoint is the fixed point that pins it down.
+    """
+    _, kpts, boxes, _ = run(affine_pipeline(90, 1.0, 0), affine_image, AFFINE_KP, AFFINE_BB)
+    np.testing.assert_allclose(kpts[:, :2], [[15.0, 40.0], [30.0, 20.0]], atol=1e-9)
+    np.testing.assert_allclose(boxes, [[15.0, 20.0, 10.0, 20.0]], atol=1e-9)
+
+
+def test_affine_rotation_sign_matches_the_image(affine_image):
+    """30 degrees: a positive angle must move the annotations the same way as the pixels."""
+    img, kpts, boxes, _ = run(affine_pipeline(30, 1.0, 0), affine_image, AFFINE_KP, AFFINE_BB)
+    np.testing.assert_allclose(
+        kpts[:, :2], [[5.1794919243, 17.0096189432], [30.0, 20.0]], atol=1e-8
+    )
+    np.testing.assert_allclose(
+        boxes, [[5.1794919243, 7.0096189432, 22.3205080757, 18.6602540378]], atol=1e-8
+    )
+    # and the pixels agree: the colour at the moved keypoint is the colour it started on
+    src = affine_image[5, 10]
+    dst = img[int(round(17.0096189432)), int(round(5.1794919243))]
+    assert np.abs(src.astype(int) - dst.astype(int)).max() <= 8
+
+
+def test_affine_translation_is_in_pixels(affine_image):
+    _, kpts, boxes, _ = run(affine_pipeline(0, 1.0, 7), affine_image, AFFINE_KP, AFFINE_BB)
+    np.testing.assert_allclose(kpts[:, :2], [[17.0, 12.0], [37.0, 27.0]], atol=1e-9)
+    np.testing.assert_allclose(boxes, [[17.0, 12.0, 20.0, 10.0]], atol=1e-9)
+
+
+def test_affine_scales_about_the_centre(affine_image):
+    _, kpts, boxes, _ = run(affine_pipeline(0, 2.0, 0), affine_image, AFFINE_KP, AFFINE_BB)
+    # a keypoint may leave the image; it keeps its coordinates
+    np.testing.assert_allclose(kpts[:, :2], [[-10.0, -10.0], [30.0, 20.0]], atol=1e-9)
+    # boxes are clipped to the image at the end of the pipeline
+    np.testing.assert_allclose(boxes, [[0.0, 0.0, 30.0, 10.0]], atol=1e-9)
+
+
+# --------------------------------------------------------------------------------
+# crop_sampling
+# --------------------------------------------------------------------------------
+@pytest.mark.parametrize(
+    "h_start, w_start, expected",
+    [(0.0, 0.0, (0, 0)), (0.5, 0.5, (35, 30)), (0.99999, 0.99999, (70, 60))],
+)
+def test_random_crop_origin_formula(h_start, w_start, expected):
+    """int((size - crop + 1) * start), so the last valid origin is reachable."""
+    crop = aug.RandomCrop(height=40, width=50)
+    params = crop.crop_coords((100, 120), h_start, w_start)
+    assert (params["x_min"], params["y_min"]) == expected
+
+
+def test_keypoint_aware_crop_moves_and_masks_keypoints():
+    """Keypoints shift by the crop origin; those outside the crop become NaN.
+
+    A keypoint exactly on the far edge (x == width) is outside; one at x == width - 1
+    is inside.
+    """
+    crop = T.KeypointAwareCrop(width=50, height=40, max_shift=0.1, crop_sampling="uniform")
+    image = np.zeros((100, 120, 3), np.uint8)
+    params = crop.crop_coords((100, 120), 0.0, 0.0)
+    params = dict(params)
+    params.update({"x_min": 10, "y_min": 20})
+    kp = np.array(
+        [
+            [15.0, 25.0, 2.0],  # inside  -> (5, 5)
+            [10.0, 20.0, 2.0],  # the crop origin -> (0, 0), inside
+            [59.0, 59.0, 2.0],  # -> (49, 39), the last pixel, inside
+            [60.0, 60.0, 2.0],  # -> (50, 40), one past the crop, outside
+            [5.0, 25.0, 2.0],  # left of the crop -> (-5, 5), outside
+        ]
+    )
+    out = crop.apply_to_keypoints(kp.copy(), **params)
+    np.testing.assert_allclose(out[:3, :2], [[5.0, 5.0], [0.0, 0.0], [49.0, 39.0]])
+    assert np.isnan(out[3, :2]).all()
+    assert np.isnan(out[4, :2]).all()
+    cropped = crop.apply(image, **params)
+    assert cropped.shape == (40, 50, 3)
+
+
+@pytest.mark.parametrize("method", ["uniform", "keypoints", "density", "hybrid"])
+def test_crop_sampling_stays_inside_the_image(image, method):
+    """Whatever the sampling method, the crop window must lie inside the padded image."""
+    cfg = {
+        "crop_sampling": {"width": 32, "height": 24, "max_shift": 0.1, "method": method},
+    }
+    pipeline = build(cfg)
+    for _ in range(50):
+        img, kpts, _, _ = run(pipeline, image, KEYPOINTS, BBOXES)
+        assert img.shape == (24, 32, 3)
+        visible = kpts[~np.isnan(kpts[:, 0])]
+        assert ((visible[:, 0] >= 0) & (visible[:, 0] < 32)).all()
+        assert ((visible[:, 1] >= 0) & (visible[:, 1] < 24)).all()
+
+
+# --------------------------------------------------------------------------------
+# covering / CoarseDropout
+# --------------------------------------------------------------------------------
+def test_coarse_dropout_masks_covered_keypoints_but_keeps_boxes():
+    """A hole is half open: [x1, x2) x [y1, y2). Boxes are never dropped by a hole."""
+    dropout = T.CoarseDropout(max_holes=1, max_height=4, max_width=4, p=1.0)
+    holes = [(10, 20, 15, 25)]
+    kp = np.array(
+        [
+            [10.0, 20.0, 2.0],  # the inclusive corner -> covered
+            [14.9, 24.9, 2.0],  # just inside -> covered
+            [15.0, 25.0, 2.0],  # the exclusive corner -> not covered
+            [15.0, 22.0, 2.0],  # on the exclusive x edge, y inside -> not covered
+            [12.0, 25.0, 2.0],  # on the exclusive y edge, x inside -> not covered
+            [9.0, 20.0, 2.0],  # left of the hole -> not covered
+            [12.0, 19.0, 2.0],  # above the hole -> not covered
+        ]
+    )
+    out = dropout.apply_to_keypoints(kp.copy(), holes=holes)
+    assert np.isnan(out[0, :2]).all()
+    assert np.isnan(out[1, :2]).all()
+    assert not np.isnan(out[2:, :2]).any()
+    np.testing.assert_allclose(out[2:, :2], kp[2:, :2])
+    boxes = np.array([[0.0, 0.0, 30.0, 30.0]])
+    np.testing.assert_array_equal(dropout.apply_to_bboxes(boxes.copy(), holes=holes), boxes)
+    image = np.full((40, 40, 3), 200, np.uint8)
+    blanked = dropout.apply(image, holes=holes)
+    np.testing.assert_array_equal(blanked[20:25, 10:15], 0)
+    np.testing.assert_array_equal(blanked[25, 15], 200)
+
+
+# --------------------------------------------------------------------------------
+# elastic_transform
+# --------------------------------------------------------------------------------
+def test_elastic_transform_keypoints_follow_the_displacement_field():
+    """A constant field is a pure translation; keypoints must move with the pixels.
+
+    ``map_x``/``map_y`` say where each output pixel *reads from*, so a field of
+    ``x - 3`` shifts the image (and every keypoint) three pixels to the right.
+    """
+    elastic = T.ElasticTransform(p=1.0)
+    h, w = 60, 80
+    y, x = np.meshgrid(np.arange(h, dtype=np.float32), np.arange(w, dtype=np.float32), indexing="ij")
+    map_x, map_y = np.float32(x - 3), np.float32(y - 2)
+
+    image = np.zeros((h, w, 3), np.uint8)
+    image[30, 40] = 255
+    warped = elastic.apply(image, map_x=map_x, map_y=map_y)
+    assert tuple(np.argwhere(warped[:, :, 0] == 255)[0]) == (32, 43)
+
+    kp = np.array([[40.0, 30.0, 2.0]])
+    moved = elastic.apply_to_keypoints(kp.copy(), map_x=map_x, map_y=map_y)
+    np.testing.assert_allclose(moved[:, :2], [[43.0, 32.0]], atol=1e-6)
+
