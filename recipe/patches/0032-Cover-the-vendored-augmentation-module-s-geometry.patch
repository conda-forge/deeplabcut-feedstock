+@pytest.mark.xfail(strict=True, reason="sigma is drawn uniformly instead of as the root of a uniform variance")
+def test_gauss_noise_sigma_matches_the_reference_distribution():
+    """``gaussian_noise: 12.75`` meant sigma = sqrt(U(0, 12.75**2)), mean 8.5.
+
+    The vendored transform draws sigma = 255 * U(0, 0.05), mean 6.375 -- the same
+    support but about 24% less noise on average.
+    """
+    transform = aug.GaussNoise(std_range=(0.0, 12.75 / 255.0), p=1.0)
+    rng = np.random.default_rng(0)
+    # a large plane per draw, so the sample standard deviation is an unbiased read of sigma
+    image = np.zeros((96, 96, 1), np.uint8)
+    sigmas = np.array(
+        [transform.get_params(image, np.zeros((0, 2)), np.zeros((0, 4)), rng)["noise"].std()
+         for _ in range(300)]
+    )
+    assert abs(sigmas.mean() - (2 / 3) * 12.75) < 0.3, f"mean sigma = {sigmas.mean():.3f}"
