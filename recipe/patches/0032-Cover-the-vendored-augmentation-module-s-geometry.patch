+@pytest.mark.parametrize("n_keypoints, n_boxes", [(0, 1), (3, 0), (0, 0)])
+def test_empty_annotations_survive_the_pipeline(image, n_keypoints, n_boxes):
+    cfg = {
+        "resize": {"height": 32, "width": 32, "keep_ratio": False},
+        "auto_padding": {
+            "pad_height_divisor": 32,
+            "pad_width_divisor": 32,
+            "position": "center",
+            "border_mode": "constant",
+        },
+        "normalize_images": True,
+    }
+    kp = KEYPOINTS[:n_keypoints]
+    bb = BBOXES[:n_boxes]
+    raw = build(cfg)(
+        image=image,
+        keypoints=np.asarray(kp, dtype=float).reshape(-1, 3),
+        class_labels=list(range(len(kp))),
+        bboxes=np.asarray(bb, dtype=float).reshape(-1, 4),
+        bbox_labels=np.arange(len(bb)),
+    )
+    assert len(raw["keypoints"]) == n_keypoints
+    assert all(len(k) == 3 for k in raw["keypoints"])
+    img, kpts, boxes, labels = run(build(cfg), image, kp, bb)
+    assert img.shape == (32, 32, 3)
+    assert kpts.shape == (n_keypoints, 3)
+    assert boxes.shape == (n_boxes, 4)
+    assert len(labels) == n_boxes
