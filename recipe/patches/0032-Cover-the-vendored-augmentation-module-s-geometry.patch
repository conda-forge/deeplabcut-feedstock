+def test_labels_stay_aligned_with_the_surviving_boxes(image):
+    """``utils._apply_transform`` scatters boxes back by ``bbox_labels``.
+
+    If a dropped box does not drop its label too, every surviving box is written to
+    the wrong row of the output array.
+    """
+    pipeline = affine_pipeline(0, 1.0, 0)
+    pipeline.transforms[0].translate_px = (-45, -45)
+    boxes = [
+        (1.0, 1.0, 10.0, 10.0),  # -> corners (-44, -44, -35, -35): gone
+        (50.0, 50.0, 8.0, 8.0),  # -> (5, 5, 13, 13): survives
+        (2.0, 2.0, 6.0, 6.0),  # -> (-43, -43, -37, -37): gone
+    ]
+    _, _, out_boxes, labels = run(pipeline, image, KEYPOINTS, boxes)
+    assert labels == [1]
+    np.testing.assert_allclose(out_boxes, [[5.0, 5.0, 8.0, 8.0]], atol=1e-9)
+
