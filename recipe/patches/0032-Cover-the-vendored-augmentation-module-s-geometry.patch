+# --------------------------------------------------------------------------------
+# confirmed deviations from albumentations 1.4.1
+#
+# Each of these is a behaviour the reference implementation had and the vendored
+# module does not. They are recorded as strict xfails so that fixing one turns into
+# an XPASS and the marker has to be removed, rather than the deviation quietly
+# surviving another review.
+# --------------------------------------------------------------------------------
+@pytest.mark.xfail(strict=True, reason="vendored RandomCrop computes a negative origin instead of raising")
+def test_crop_larger_than_the_image_is_rejected():
+    """albumentations raised ValueError; the vendored crop returns a wrong-sized array.
+
+    ``build_transforms`` always pads to at least the crop size first, so the stock
+    pipeline cannot reach this -- but the class is also instantiated directly.
+    """
+    crop = aug.RandomCrop(height=60, width=80)
+    with pytest.raises(ValueError):
+        crop.crop_coords((40, 50), 0.0, 0.0)
+
+
+@pytest.mark.xfail(strict=True, reason="Compose re-seeds on every call, collapsing an epoch to one augmentation")
+def test_compose_seed_does_not_repeat_the_same_augmentation():
+    pipeline = aug.Compose(
+        [aug.GaussNoise(std_range=(0.01, 0.05), p=1.0)],
+        keypoint_params=aug.KeypointParams("xy", label_fields=["class_labels"]),
+        bbox_params=aug.BboxParams("coco", label_fields=["bbox_labels"]),
+        seed=1234,
+    )
+    image = np.full((8, 8, 3), 128, np.uint8)
+    outs = [
+        pipeline(image=image, keypoints=[], class_labels=[], bboxes=[], bbox_labels=[])["image"]
+        for _ in range(4)
+    ]
+    assert not all(np.array_equal(outs[0], other) for other in outs[1:])
+
