+def test_grayscale_blends_towards_the_luma_plane():
+    rng = np.random.default_rng(1)
+    image = rng.integers(0, 256, (20, 30, 3), dtype=np.uint8)
+    gray = cv2.cvtColor(image, cv2.COLOR_RGB2GRAY)
+    np.testing.assert_array_equal(T.Grayscale(alpha=1.0).apply(image), np.repeat(gray[..., None], 3, axis=2))
+    np.testing.assert_array_equal(T.Grayscale(alpha=0.0).apply(image), image)
