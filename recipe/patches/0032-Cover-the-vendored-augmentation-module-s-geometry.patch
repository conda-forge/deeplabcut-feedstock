+@pytest.mark.xfail(strict=True, reason="ksize is drawn from {3,4,5,6,7} then rounded up, so 3 is half as likely")
+def test_motion_blur_kernel_size_is_uniform_over_the_odd_sizes():
+    """albumentations drew uniformly from {3, 5, 7}; the vendored draw is 0.20/0.40/0.40."""
+    transform = aug.MotionBlur(blur_limit=(3, 7), p=1.0)
+    rng = np.random.default_rng(0)
+    image = np.zeros((16, 16, 3), np.uint8)
+    sizes = np.array(
+        [transform.get_params(image, np.zeros((0, 2)), np.zeros((0, 4)), rng)["kernel"].shape[0]
+         for _ in range(20000)]
+    )
+    for k in (3, 5, 7):
+        assert abs((sizes == k).mean() - 1 / 3) < 0.02, f"P(ksize={k}) = {(sizes == k).mean():.3f}"
+
