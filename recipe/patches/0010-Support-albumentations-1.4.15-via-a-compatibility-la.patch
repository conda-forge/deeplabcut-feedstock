+    @staticmethod
+    def _remap_heatmaps(heatmaps: NDArray, map_x: NDArray, map_y: NDArray, border_mode: int, border_value) -> NDArray:
+        """Apply an albumentations displacement field to a stack of heatmaps.
+
+        cv2.remap handles at most four channels at a time, and there is one heatmap
+        per keypoint, so the stack is remapped in chunks.
+        """
+        out = np.empty_like(heatmaps)
+        for start in range(0, heatmaps.shape[2], 4):
+            chunk = heatmaps[:, :, start : start + 4]
+            remapped = cv2.remap(
+                chunk,
+                map_x,
+                map_y,
+                interpolation=cv2.INTER_NEAREST,
+                borderMode=border_mode,
+                borderValue=0 if border_value is None else border_value,
+            )
+            out[:, :, start : start + 4] = remapped.reshape(chunk.shape)
+        return out
+
     def apply_to_keypoints(self, keypoints: Sequence[float], random_state: int | None = None, **params) -> list[float]:
