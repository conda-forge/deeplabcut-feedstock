     def apply_to_keypoints(
         self,
         keypoints,
         **params,
     ) -> list[tuple[float]]:
-        keypoints = super().apply_to_keypoints(keypoints, **params)
+        cropped = super().apply_to_keypoints(keypoints, **params)
         new_keypoints = []
-        for kp in keypoints:
+        for kp in _keypoints_to_tuples(cropped):
             x, y = kp[:2]
             if not (0 <= x < self.width and 0 <= y < self.height):
                 kp = list(kp)
                 kp[:2] = np.nan, np.nan
                 kp = tuple(kp)
             new_keypoints.append(kp)
-        return new_keypoints
+        return _keypoints_from_tuples(new_keypoints, cropped)
 
     def get_transform_init_args_names(self) -> tuple[str, ...]:
         return "width", "height", "max_shift", "crop_sampling"
@@ -368,22 +475,38 @@ class KeepAspectRatioResize(A.DualTransform):
         # Bounding box coordinates are scale invariant
         return bbox
 
+    def apply_to_bboxes(self, bboxes, **params):
+        # Bounding box coordinates are scale invariant
+        return bboxes
+
     def apply_to_keypoint(self, keypoint, scale=0, **params):
         keypoint = A.keypoint_scale(keypoint, scale, scale)
         return keypoint
 
+    def apply_to_keypoints(self, keypoints, scale=0, **params):
+        if not _ALBUMENTATIONS_BATCHED_TARGETS:
+            return super().apply_to_keypoints(keypoints, scale=scale, **params)
+
+        from albumentations.augmentations.geometric import functional as geometric_functional
+
+        return geometric_functional.keypoints_scale(np.asarray(keypoints, dtype=float), scale, scale)
+
     @property
     def targets_as_params(self) -> list[str]:
         return ["image"]
 
+    def _scale_for(self, height: int, width: int) -> float:
+        if self.mode == "pad":
+            return min(self.height / height, self.width / width)
+        return max(self.height / height, self.width / width)
+
     def get_params_dependent_on_targets(self, params: dict[str, Any]) -> dict[str, Any]:
         h, w, _ = params["image"].shape
-        if self.mode == "pad":
-            scale = min(self.height / h, self.width / w)
-        else:
-            scale = max(self.height / h, self.width / w)
+        return {"scale": self._scale_for(h, w)}
 
-        return {"scale": scale}
+    def get_params_dependent_on_data(self, params: dict[str, Any], data: dict[str, Any]) -> dict[str, Any]:
+        h, w = params["shape"][:2]
+        return {"scale": self._scale_for(h, w)}
 
