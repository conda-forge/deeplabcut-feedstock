+++ b/deeplabcut/pose_estimation_pytorch/data/transforms.py
@@ -17,11 +17,97 @@ from typing import Any
 import albumentations as A
 import cv2
 import numpy as np
-from albumentations.augmentations.geometric import functional as F
 from numpy.typing import NDArray
+from packaging.version import Version
 from scipy.spatial.distance import pdist, squareform
 from scipy.stats import truncnorm
 
+# albumentations 1.4.15 reworked the transform API: the per-item apply_to_bbox()
+# and apply_to_keypoint() hooks were replaced by batched apply_to_bboxes() and
+# apply_to_keypoints() taking NumPy arrays, ``targets_as_params`` together with
+# get_params_dependent_on_targets() became get_params_dependent_on_data(), and a
+# number of transform signatures were renamed. The transforms below are written
+# against the older API; every branch guarded by this flag adapts a newer
+# albumentations back to it, so augmentation results do not depend on which
+# version happens to be installed.
+_ALBUMENTATIONS_BATCHED_TARGETS = Version(A.__version__) >= Version("1.4.15")
+
+if _ALBUMENTATIONS_BATCHED_TARGETS:
+    _PAD_POSITION_TOP_LEFT = "top_left"
+else:
+    from albumentations.augmentations.geometric import functional as F
+
+    _PAD_POSITION_TOP_LEFT = A.PadIfNeeded.PositionType.TOP_LEFT
+
+
+def _keypoints_to_tuples(keypoints: Any) -> list[tuple]:
+    """Return keypoints as the list of tuples albumentations < 1.4.15 passed around."""
+    if not _ALBUMENTATIONS_BATCHED_TARGETS:
+        return list(keypoints)
+    return [tuple(row) for row in np.asarray(keypoints, dtype=float)]
+
+
+def _keypoints_from_tuples(keypoints: Sequence, template: Any) -> Any:
+    """Return keypoints in the layout the installed albumentations expects.
+
+    ``template`` is the value originally handed to the transform; it is only used to
+    recover the number of columns when ``keypoints`` is empty.
+    """
+    if not _ALBUMENTATIONS_BATCHED_TARGETS:
+        return keypoints
+    if len(keypoints):
+        return np.asarray([tuple(kp) for kp in keypoints], dtype=float)
+    template = np.asarray(template, dtype=float)
+    n_cols = template.shape[1] if template.ndim == 2 else 4
+    return np.zeros((0, n_cols), dtype=float)
+
+
+def _bboxes_from_sequence(bboxes: Sequence, template: Any) -> Any:
+    """Return bounding boxes in the layout the installed albumentations expects."""
+    if not _ALBUMENTATIONS_BATCHED_TARGETS:
+        return bboxes
+    if len(bboxes):
+        return np.asarray([tuple(bbox) for bbox in bboxes], dtype=float)
+    template = np.asarray(template, dtype=float)
+    n_cols = template.shape[1] if template.ndim == 2 else 4
+    return np.zeros((0, n_cols), dtype=float)
+
+
+def _target_shape(params: dict[str, Any]) -> tuple[int, int]:
+    """Return the (rows, cols) of the target being transformed."""
+    if _ALBUMENTATIONS_BATCHED_TARGETS:
+        return params["shape"][:2]
+    return params["rows"], params["cols"]
+
+
+if _ALBUMENTATIONS_BATCHED_TARGETS:
+
+    class PadIfNeeded(A.PadIfNeeded):
+        """PadIfNeeded that translates annotations rather than mirroring them.
+
+        With a reflecting border mode, albumentations >= 1.4.15 also reflects
+        bounding boxes and keypoints into the padded region, turning one annotated
+        instance into several. Earlier versions only shifted them by the padding
+        offset. Pad the annotations as if the border were constant so that only the
+        image content is reflected.
+        """
+
+        def _pad_targets(self, method, target, kwargs):
+            border_mode, self.border_mode = self.border_mode, cv2.BORDER_CONSTANT
+            try:
+                return method(target, **kwargs)
+            finally:
+                self.border_mode = border_mode
+
+        def apply_to_bboxes(self, bboxes, **params):
+            return self._pad_targets(super().apply_to_bboxes, bboxes, params)
+
+        def apply_to_keypoints(self, keypoints, **params):
+            return self._pad_targets(super().apply_to_keypoints, keypoints, params)
+
+else:
+    PadIfNeeded = A.PadIfNeeded
+
 
