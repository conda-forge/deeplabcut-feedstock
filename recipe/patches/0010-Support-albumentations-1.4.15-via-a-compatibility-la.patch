+        else:
+            swapped_keypoints = [keypoints[idx] for idx in order]
         return super().apply_to_keypoints(swapped_keypoints, **params)
 
 
@@ -259,7 +351,7 @@ class KeypointAwareCrop(A.RandomCrop):
         max_shift: float = 0.4,
