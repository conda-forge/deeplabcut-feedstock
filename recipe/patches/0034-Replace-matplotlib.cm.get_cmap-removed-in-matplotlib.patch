+def test_customized_colormap_matches_pre_39_colours(tmp_path):
+    """``modelzoo`` site, exercised end to end.
+
+    ``leftear``/``rightear`` are deliberately symmetric: the function makes them
+    share a colour, so the assertion covers both the colormap lookup and the
+    merging that consumes it.
+    """
+    from deeplabcut.modelzoo.generalized_data_converter.utils import customized_colormap
+
+    config = tmp_path / "config.yaml"
+    config.write_text("multianimalbodyparts:\n- snout\n- leftear\n- rightear\n- tail\n")
+
+    # plt.cm.get_cmap("rainbow", 4) on matplotlib 3.7.3, with index 2 replaced
+    # by index 1 the way customized_colormap pairs left/right bodyparts.
+    rainbow4 = (
+        (0.5, 0.0, 1.0, 1.0),
+        (0.16666666666666663, 0.8660254037844386, 0.8660254037844387, 1.0),
+        (0.16666666666666663, 0.8660254037844386, 0.8660254037844387, 1.0),
+        (1.0, 1.2246467991473532e-16, 6.123233995736766e-17, 1.0),
+    )
+    colour_of = customized_colormap(str(config))
+    np.testing.assert_array_equal(
+        np.asarray([colour_of(i) for i in range(4)], dtype=float),
+        np.asarray(rainbow4, dtype=float),
+    )
