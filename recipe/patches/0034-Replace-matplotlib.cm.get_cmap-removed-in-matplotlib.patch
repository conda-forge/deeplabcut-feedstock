+#: Every site that used to call ``plt.cm.get_cmap``, and whether it passed a
+#: count.  ``True`` means the colormap must be resampled, ``False`` means it
+#: must not be -- the silent failure mode above.
+EXPECTED_SITES = {
+    "core/visualization.py": (1, 0),
+    "gui/tracklet_toolbox.py": (1, 0),
+    "modelzoo/generalized_data_converter/utils.py": (1, 0),
+    "pose_estimation_3d/plotting3D.py": (2, 0),
+    "pose_estimation_pytorch/apis/visualization.py": (0, 1),
+    "pose_estimation_tensorflow/visualizemaps.py": (1, 0),
+    "utils/visualization.py": (1, 0),
+}
+
+#: Names matplotlib deleted in 3.9.  ``plt.cm.get_cmap`` is what this module is
+#: about; the others are here so a reintroduction is caught by the same sweep.
+REMOVED_MATPLOTLIB_NAMES = re.compile(
+    r"\bcm\s*\.\s*(get_cmap|register_cmap|unregister_cmap)\b"
+    r"|\bmatplotlib\s*\.\s*docstring\b"
+    r"|\bcbook\s*\.\s*is_string_like\b"
+    r"|\bdates\s*\.\s*(epoch2num|num2epoch)\b"
+)
+
+
+def _package_sources():
+    return sorted(PACKAGE_ROOT.rglob("*.py"))
+
+
+def test_package_does_not_use_matplotlib_names_removed_in_39():
+    """No source file may reach for an API matplotlib 3.9 deleted.
+
+    Version-independent: this is red the moment the fix is reverted, even on a
+    matplotlib old enough that the reverted code would still run.
+    """
+    offenders = []
+    for path in _package_sources():
+        for lineno, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
+            if REMOVED_MATPLOTLIB_NAMES.search(line):
+                offenders.append(f"{path.relative_to(PACKAGE_ROOT)}:{lineno}: {line.strip()}")
+    assert not offenders, "matplotlib APIs removed in 3.9 are still used:\n" + "\n".join(offenders)
+
+
+def _count_colormap_lookups(source):
+    """``(resampled, bare)`` counts of ``colormaps[...]`` in ``source``."""
+    resampled = bare = 0
+    tree = ast.parse(source)
+    # A lookup is resampled iff its Subscript is the receiver of `.resampled`.
+    resampled_receivers = {
+        id(node.func.value)
+        for node in ast.walk(tree)
+        if isinstance(node, ast.Call)
+        and isinstance(node.func, ast.Attribute)
+        and node.func.attr == "resampled"
+    }
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.Subscript):
+            continue
+        if not (isinstance(node.value, ast.Name) and node.value.id == "colormaps"):
+            continue
+        if id(node) in resampled_receivers:
+            resampled += 1
+        else:
+            bare += 1
+    return resampled, bare
+
+
+@pytest.mark.parametrize("relpath", sorted(EXPECTED_SITES))
+def test_call_sites_resample_exactly_where_get_cmap_used_to(relpath):
+    """Each site keeps the resampling it had, and only that.
+
+    ``get_cmap(name, n)`` resampled and ``get_cmap(name)`` did not; a site that
+    swaps one for the other plots different colours without raising.
+    """
+    source = (PACKAGE_ROOT / relpath).read_text(encoding="utf-8")
+    assert _count_colormap_lookups(source) == EXPECTED_SITES[relpath]
+
+
+def test_every_colormap_lookup_in_the_package_is_accounted_for():
+    """Guard the table above against a ninth site appearing untested."""
+    found = {}
+    for path in _package_sources():
+        counts = _count_colormap_lookups(path.read_text(encoding="utf-8"))
+        if counts != (0, 0):
+            found[str(path.relative_to(PACKAGE_ROOT))] = counts
+    assert found == EXPECTED_SITES
+
+
+@pytest.mark.parametrize(("name", "n"), sorted(RESAMPLED_GOLDEN))
+def test_get_cmap_helper_matches_pre_39_colours(name, n):
+    """``utils.visualization.get_cmap`` -- the site behind 15 callers."""
+    from deeplabcut.utils.visualization import get_cmap
+
+    cmap = get_cmap(n, name)
+    assert cmap.N == n
+    np.testing.assert_array_equal(
+        np.asarray(cmap(range(n)), dtype=float),
+        np.asarray(RESAMPLED_GOLDEN[(name, n)], dtype=float),
+    )
+
+
+@pytest.mark.parametrize("name", sorted(FULL_GOLDEN))
+def test_uncounted_lookup_matches_pre_39_colours(name):
+    """The un-counted form keeps all 256 entries.
+
+    Also asserts the golden values are *not* what a resampled map gives, so the
+    test above cannot pass by accident if a resampling is introduced here.
+    """
+    import matplotlib
+
+    cmap = matplotlib.colormaps[name]
+    assert cmap.N == 256
+    golden = np.asarray(FULL_GOLDEN[name], dtype=float)
+    np.testing.assert_array_equal(
+        np.asarray([cmap(p) for p in FULL_PROBES], dtype=float), golden
+    )
+    for n in (3, 5, 10):
+        resampled = matplotlib.colormaps[name].resampled(n)
+        assert not np.array_equal(
+            np.asarray([resampled(p) for p in FULL_PROBES], dtype=float), golden
+        ), f"resampling {name} to {n} would be indistinguishable -- test is not discriminating"
+
