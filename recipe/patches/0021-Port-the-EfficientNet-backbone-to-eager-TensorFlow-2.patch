+"""EfficientNet as an eager ``tf.keras.Model``.
+
+A drop-in replacement for ``backbones/efficientnet_model.py`` +
+``backbones/efficientnet_builder.py``, restricted to the configurations
+DeepLabCut actually builds: ``build_model_base``, i.e. ``features_only``, for
+``efficientnet-b0`` ... ``efficientnet-b6``.
+
+Contains none of the TF1 compatibility API, none of TensorFlow's private TPU
+modules, no ``variable_scope``, no placeholder and no Session.
+
+Variable naming is reproduced exactly rather than approximated.  Every layer
+knows the TF1 variable scope it stands in for, and ``slim_weights()`` reports
+it, so ``nnets/checkpoint.py`` moves weights in both directions and the
+published ``cloud-tpu-checkpoints`` ImageNet weights load unchanged.
+
+Three upstream details that are easy to get wrong:
+
+* The backbone carries **no** weight regularisation at all.  The original
+  TF1 ``layers.Conv2D`` calls pass no ``kernel_regularizer`` --
+  EfficientNet's weight decay lives in the optimizer, not in the graph -- and
+  the TF1 pose graph accordingly holds exactly two regularization losses, both
+  from the heads.  A ``keras.regularizers.l2`` here would be a change in
+  behaviour, not a translation, so there is none.
+
+* Batch norm normalises with the stored moving averages and never updates
+  them, at inference *and* while training: ``PoseEfficientNet.get_net``
+  ignores ``is_training`` and defaults ``use_batch_norm`` to ``False``.  The
+  TF1 graph has zero ``UPDATE_OPS`` to prove it.  That is why this port needs
+  none of the per-image batch-norm machinery the MobileNet one does.
+
+* ``momentum``/``epsilon`` are pinned to the values
+  ``efficientnet_builder.efficientnet`` puts in ``GlobalParams`` (0.99, 1e-3)
+  rather than left on the Keras defaults, which happen to agree today.
+"""
+
+import collections
+import math
+import re
+
+import numpy as np
+import tensorflow as tf
+
+from ..nnets.factory import KerasBackboneFactory
+
+#: ImageNet channel statistics, as in ``efficientnet_builder``.
+MEAN_RGB = [0.485 * 255, 0.456 * 255, 0.406 * 255]
+STDDEV_RGB = [0.229 * 255, 0.224 * 255, 0.225 * 255]
+
+#: ``efficientnet_builder.efficientnet``'s GlobalParams
+BN_MOMENTUM = 0.99
+BN_EPSILON = 1e-3
+DEPTH_DIVISOR = 8
+DROP_CONNECT_RATE = 0.2
+
+#: the variable scope ``PoseEfficientNet.extract_features`` opens
+SCOPE = "efficientnet"
+
+#: (width_coefficient, depth_coefficient, resolution, dropout_rate)
+EFFICIENTNET_PARAMS = {
+    "efficientnet-b0": (1.0, 1.0, 224, 0.2),
+    "efficientnet-b1": (1.0, 1.1, 240, 0.2),
+    "efficientnet-b2": (1.1, 1.2, 260, 0.3),
+    "efficientnet-b3": (1.2, 1.4, 300, 0.3),
+    "efficientnet-b4": (1.4, 1.8, 380, 0.4),
+    "efficientnet-b5": (1.6, 2.2, 456, 0.4),
+    "efficientnet-b6": (1.8, 2.6, 528, 0.5),
+    "efficientnet-b7": (2.0, 3.1, 600, 0.5),
+}
+
+#: NOTE the stride of the sixth entry is 11 and not 22: that is DeepLabCut's
+#: change, to get an output stride of 16 instead of 32.
+BLOCKS_ARGS = (
+    "r1_k3_s11_e1_i32_o16_se0.25",
+    "r2_k3_s22_e6_i16_o24_se0.25",
+    "r2_k5_s22_e6_i24_o40_se0.25",
+    "r3_k3_s22_e6_i40_o80_se0.25",
+    "r3_k5_s11_e6_i80_o112_se0.25",
+    "r4_k5_s11_e6_i112_o192_se0.25",
+    "r1_k3_s11_e6_i192_o320_se0.25",
+)
+
+BlockArgs = collections.namedtuple(
+    "BlockArgs",
+    [
+        "kernel_size",
+        "num_repeat",
+        "input_filters",
+        "output_filters",
+        "expand_ratio",
+        "id_skip",
+        "strides",
+        "se_ratio",
+        "conv_type",
+    ],
+)
+BlockArgs.__new__.__defaults__ = (None,) * len(BlockArgs._fields)
+
+
+def decode_block_string(block_string):
+    """``efficientnet_builder.BlockDecoder._decode_block_string``."""
+    options = {}
+    for op in block_string.split("_"):
+        splits = re.split(r"(\d.*)", op)
+        if len(splits) >= 2:
+            key, value = splits[:2]
+            options[key] = value
+    if "s" not in options or len(options["s"]) != 2:
+        raise ValueError("Strides options should be a pair of integers.")
+    return BlockArgs(
+        kernel_size=int(options["k"]),
+        num_repeat=int(options["r"]),
+        input_filters=int(options["i"]),
+        output_filters=int(options["o"]),
+        expand_ratio=int(options["e"]),
+        id_skip=("noskip" not in block_string),
+        se_ratio=float(options["se"]) if "se" in options else None,
+        strides=[int(options["s"][0]), int(options["s"][1])],
+        conv_type=int(options["c"]) if "c" in options else 0,
+    )
+
+
+def conv_kernel_initializer(shape, dtype=None):
+    """``efficientnet_model.conv_kernel_initializer``.
+
+    A normal distribution rather than the truncated one
+    ``tf.variance_scaling_initializer`` uses.  For a depthwise kernel the
+    shape is ``[k, k, in, 1]``, so ``out_filters`` is 1 -- that oddity is
+    upstream's and is reproduced rather than corrected.
+    """
+    kernel_height, kernel_width, _, out_filters = shape
+    fan_out = int(kernel_height * kernel_width * out_filters)
+    return tf.random.normal(shape, mean=0.0, stddev=np.sqrt(2.0 / fan_out), dtype=dtype)
+
+
+def dense_kernel_initializer(shape, dtype=None):
+    """``efficientnet_model.dense_kernel_initializer``."""
+    init_range = 1.0 / np.sqrt(shape[1])
+    return tf.random.uniform(shape, -init_range, init_range, dtype=dtype)
+
+
+def round_filters(filters, width_coefficient, depth_divisor=DEPTH_DIVISOR, min_depth=None):
+    """``efficientnet_model.round_filters``."""
+    if not width_coefficient:
+        return filters
+    filters *= width_coefficient
+    min_depth = min_depth or depth_divisor
+    new_filters = max(min_depth, int(filters + depth_divisor / 2) // depth_divisor * depth_divisor)
+    if new_filters < 0.9 * filters:  # do not round down by more than 10%
+        new_filters += depth_divisor
+    return int(new_filters)
+
+
+def round_repeats(repeats, depth_coefficient):
+    """``efficientnet_model.round_repeats``."""
+    if not depth_coefficient:
+        return repeats
+    return int(math.ceil(depth_coefficient * repeats))
+
+
+def drop_connect(inputs, is_training, drop_connect_rate):
+    """``efficientnet_model.drop_connect``, with ``tf.math.divide`` for TF1's ``div``."""
+    if not is_training:
+        return inputs
+    keep_prob = 1.0 - drop_connect_rate
+    batch_size = tf.shape(inputs)[0]
+    random_tensor = keep_prob + tf.random.uniform([batch_size, 1, 1, 1], dtype=inputs.dtype)
+    binary_tensor = tf.floor(random_tensor)
+    return tf.math.divide(inputs, keep_prob) * binary_tensor
+
+
+# ---------------------------------------------------------------------------
+# Layers that keep their TF1 variable names
+# ---------------------------------------------------------------------------
+
+
+class EffConv(tf.keras.layers.Layer):
+    """One TF1 ``layers.Conv2D`` of the original EfficientNet.
+
+    ``slim_scope`` is the TF1 variable scope this layer stands in for, e.g.
+    ``"efficientnet/efficientnet-b0/blocks_3/se/conv2d_1"``.  No
+    ``kernel_regularizer``: the layers it replaces have none.
+    """
+
+    def __init__(self, slim_scope, filters, kernel_size, strides=1, use_bias=False, **kwargs):
+        super().__init__(name=slim_scope.replace("/", "."), **kwargs)
+        self.slim_scope = slim_scope
+        self.conv = tf.keras.layers.Conv2D(
+            filters,
+            kernel_size=kernel_size,
+            strides=strides,
+            kernel_initializer=conv_kernel_initializer,
+            padding="same",
+            data_format="channels_last",
+            use_bias=use_bias,
+        )
+
+    def call(self, inputs):
+        return self.conv(inputs)
+
+    def slim_weights(self):
+        out = {f"{self.slim_scope}/kernel": self.conv.kernel}
+        if self.conv.use_bias:
+            out[f"{self.slim_scope}/bias"] = self.conv.bias
+        return out
+
+
+class EffDepthwiseConv(tf.keras.layers.Layer):
+    """``nnets/utils.DepthwiseConv2D``: a plain Keras depthwise convolution."""
+
+    def __init__(self, slim_scope, kernel_size, strides=1, **kwargs):
+        super().__init__(name=slim_scope.replace("/", "."), **kwargs)
+        self.slim_scope = slim_scope
+        self.conv = tf.keras.layers.DepthwiseConv2D(
+            kernel_size,
+            strides=strides,
+            depth_multiplier=1,
+            depthwise_initializer=conv_kernel_initializer,
+            padding="same",
+            data_format="channels_last",
+            use_bias=False,
+        )
+
+    def call(self, inputs):
+        return self.conv(inputs)
+
+    def slim_weights(self):
+        return {f"{self.slim_scope}/depthwise_kernel": self.conv.depthwise_kernel}
+
+
+class EffBatchNorm(tf.keras.layers.Layer):
+    """``nnets/utils.BatchNormalization``, i.e. the non-TPU branch.
+
+    The TF1 class is called ``tpu_batch_normalization`` only so that its
+    variable names match ``TpuBatchNormalization``'s; the computation is
+    the TF1 ``layers.BatchNormalization``'s and nothing more.
+    """
+
+    def __init__(self, slim_scope, **kwargs):
+        super().__init__(name=slim_scope.replace("/", "."), **kwargs)
+        self.slim_scope = slim_scope
+        self.bn = tf.keras.layers.BatchNormalization(
+            axis=-1,
+            momentum=BN_MOMENTUM,
+            epsilon=BN_EPSILON,
+            center=True,
+            scale=True,
+        )
+
+    def call(self, inputs, training=False):
+        return self.bn(inputs, training=training)
+
+    def slim_weights(self):
+        return {
+            f"{self.slim_scope}/gamma": self.bn.gamma,
+            f"{self.slim_scope}/beta": self.bn.beta,
+            f"{self.slim_scope}/moving_mean": self.bn.moving_mean,
+            f"{self.slim_scope}/moving_variance": self.bn.moving_variance,
+        }
+
+
+class EffDense(tf.keras.layers.Layer):
+    """The classification head's TF1 ``layers.Dense``."""
+
+    def __init__(self, slim_scope, units, **kwargs):
+        super().__init__(name=slim_scope.replace("/", "."), **kwargs)
+        self.slim_scope = slim_scope
+        self.dense = tf.keras.layers.Dense(units, kernel_initializer=dense_kernel_initializer)
+
+    def call(self, inputs):
+        return self.dense(inputs)
+
+    def slim_weights(self):
+        return {
+            f"{self.slim_scope}/kernel": self.dense.kernel,
+            f"{self.slim_scope}/bias": self.dense.bias,
+        }
+
+
+class _ScopeCounter:
+    """Reproduce TF1's per-variable-scope layer numbering.
+
+    The original layers take their names from the variable scope that is open
+    when they are first called -- ``conv2d``, ``conv2d_1``, ... -- with a
+    separate counter for the nested ``se`` scope.
+    """
+
+    def __init__(self, prefix):
+        self.prefix = prefix
+        self._counts = {}
+
+    def name(self, base, scope=""):
+        key = (scope, base)
+        n = self._counts.get(key, 0)
+        self._counts[key] = n + 1
+        suffix = "" if n == 0 else f"_{n}"
+        parts = [self.prefix] + ([scope] if scope else []) + [base + suffix]
+        return "/".join(parts)
+
+
+class MBConvBlock(tf.keras.layers.Layer):
+    """``efficientnet_model.MBConvBlock``: mobile inverted residual bottleneck."""
+
+    def __init__(self, block_args, slim_scope, relu_fn=tf.nn.swish, use_se=True, **kwargs):
+        super().__init__(name=slim_scope.replace("/", "."), **kwargs)
