+"""Tests for the eager EfficientNet pose net in ``nnets/efficientnet.py``.
+
+These never build a TF1 graph.  The numbers they assert -- weight counts,
+variable names, endpoint names -- are the ones the ``tf_slim`` graph produces,
+read off it once and pinned here.
+"""
+import numpy as np
+import pytest
+
+tf = pytest.importorskip("tensorflow")
+
+from deeplabcut.pose_estimation_tensorflow.datasets import Batch  # noqa: E402
+from deeplabcut.pose_estimation_tensorflow.nnets import (  # noqa: E402
+    KERAS_ENGINE,
+    KerasBackboneFactory,
+    PoseEfficientNetKeras,
+    PoseNetFactory,
+    ensure_eager_execution,
+    load_tf1_checkpoint,
+    save_tf1_checkpoint,
+)
+from deeplabcut.pose_estimation_tensorflow.nnets.checkpoint import (  # noqa: E402
+    compare_to_tf1_checkpoint,
+)
+from deeplabcut.pose_estimation_tensorflow.nnets import base as nnets_base  # noqa: E402
+from deeplabcut.pose_estimation_tensorflow.nnets.efficientnet import (  # noqa: E402
+    PoseEfficientNet,
+    imagenet_ckpt_name,
+)
+from deeplabcut.utils.auxiliaryfunctions import (  # noqa: E402
+    read_plainconfig,
+    write_plainconfig,
+)
+
+
+@pytest.fixture(scope="module", autouse=True)
+def eager():
+    """Turn eager on for this module.
+
+    ``core/train.py`` disables it process-wide at import.  Turning it back on
+    only works before the eager context has been touched, so a module that
+    turns it off again on the way out makes every later Keras test skip --
+    which is what happens when this file and ``test_nnets_keras.py`` run in the
+    same session.  Eager is therefore left on, and the TF1 tests that follow
+    build their graphs in subprocesses anyway.
+    """
+    try:
+        ensure_eager_execution()
+    except RuntimeError as err:  # a TF1 graph was built earlier in this process
+        pytest.skip(str(err))
+    yield
+
+
+def pose_cfg(**kwargs):
+    cfg = {
+        "stride": 8.0,
+        "weigh_part_predictions": False,
+        "mean_pixel": [123.68, 116.779, 103.939],
+        "location_refinement": True,
+        "locref_stdev": 7.2801,
+        "locref_loss_weight": 1.0,
+        "locref_huber_loss": True,
+        "intermediate_supervision": False,
+        "intermediate_supervision_layer": 3,
+        "weight_decay": 0.0001,
+        "batch_size": 1,
+        "dataset_type": "imgaug",
+        "pairwise_huber_loss": True,
+        "pairwise_predict": False,
+        "partaffinityfield_predict": False,
+        "pairwise_loss_weight": 1.0,
+        "num_joints": 4,
+        "num_limbs": 0,
+        "net_type": "efficientnet-b0",
+    }
+    cfg.update(kwargs)
+    return cfg
+
+
+#: ``net_type -> number of variables the tf_slim graph creates`` (304 backbone
+#: weights plus the four of the part_pred and locref heads).
+VARIABLE_COUNTS = {
+    "efficientnet-b0": 308,
+    "efficientnet-b1": 436,
+    "efficientnet-b2": 436,
+    "efficientnet-b3": 493,
+}
+
+SIZE = (128, 160)
+
+
+def build(cfg, batch_size=None):
+    if batch_size is not None:
+        cfg = dict(cfg, batch_size=batch_size)
+    model = PoseNetFactory.create(cfg, engine=KERAS_ENGINE)
+    model.build_for([cfg["batch_size"], SIZE[0], SIZE[1], 3])
+    return model
+
+
+def images(n, seed=0):
+    rng = np.random.RandomState(seed)
+    return tf.constant(rng.uniform(0, 255, (n, SIZE[0], SIZE[1], 3)), dtype=tf.float32)
+
+
+# ---------------------------------------------------------------------------
+# selection
+# ---------------------------------------------------------------------------
+def test_tf1_stays_the_default():
+    assert type(PoseNetFactory.create(pose_cfg())) is PoseEfficientNet
+
+
+def test_keras_engine_selects_the_keras_net():
+    net = PoseNetFactory.create(pose_cfg(tf_engine="keras"))
+    assert isinstance(net, PoseEfficientNetKeras)
+    assert isinstance(net, tf.keras.Model)
+
+
+def test_backbone_is_registered():
+    assert KerasBackboneFactory.supports("efficientnet-b0")
+
+
+# ---------------------------------------------------------------------------
+# structure
+# ---------------------------------------------------------------------------
+@pytest.mark.parametrize("net_type", sorted(VARIABLE_COUNTS))
+def test_weight_count_matches_the_tf_slim_graph(net_type):
+    model = build(pose_cfg(net_type=net_type))
+    assert len(model.weights) == VARIABLE_COUNTS[net_type]
+    assert len(model.slim_weight_map()) == VARIABLE_COUNTS[net_type]
+    assert model.unmapped_weights() == []
+
+
+def test_variable_names_are_the_tf1_ones():
+    model = build(pose_cfg())
+    names = set(model.slim_weight_map())
+    for name in (
+        "efficientnet/efficientnet-b0/stem/conv2d/kernel",
+        "efficientnet/efficientnet-b0/stem/tpu_batch_normalization/moving_variance",
+        "efficientnet/efficientnet-b0/blocks_0/depthwise_conv2d/depthwise_kernel",
+        "efficientnet/efficientnet-b0/blocks_0/se/conv2d/bias",
+        "efficientnet/efficientnet-b0/blocks_0/se/conv2d_1/kernel",
+        "efficientnet/efficientnet-b0/blocks_0/conv2d/kernel",
+        "efficientnet/efficientnet-b0/blocks_0/tpu_batch_normalization_1/gamma",
+        "efficientnet/efficientnet-b0/blocks_1/conv2d_1/kernel",
+        "efficientnet/efficientnet-b0/blocks_15/tpu_batch_normalization_2/beta",
+        "pose/part_pred/block4/weights",
+        "pose/locref_pred/block4/biases",
+    ):
+        assert name in names, name
+    # the head layers of the classifier are not built: build_model_base stops
+    # at the last block, so there is no head/ scope in the tf_slim graph either
+    assert not any("/head/" in name for name in names)
+
+
+def test_endpoints_are_the_tf1_ones():
+    model = build(pose_cfg())
+    _features, end_points = model.extract_features(images(1))
+    assert end_points["features"].shape == (1, 8, 10, 320)
+    assert end_points["stem"].shape == (1, 64, 80, 32)
+    assert set(end_points) == (
+        {"stem", "features"}
+        | {f"block_{i}" for i in range(16)}
+        | {f"block_{i}/expansion_output" for i in range(16)}
+        | {f"reduction_{i}" for i in range(1, 5)}
+        | {f"reduction_{i}/expansion_output" for i in range(1, 5)}
+    )
+
+
+def test_backbone_carries_no_weight_regularisation():
+    """EfficientNet's weight decay lives in the optimizer, not in the graph.
+
+    The tf_slim graph holds exactly two REGULARIZATION_LOSSES, both from the
+    heads; a regularizer on the backbone would be a change in behaviour.
+    """
+    model = build(pose_cfg())
+    assert model.backbone.losses == []
+    assert len(model.losses) == 2
+
+
+def test_heads_use_the_slim_weight_decay():
+    """``slim.l2_regularizer(s)`` is ``s*sum(w^2)/2``, ``keras.l2(s)`` is not."""
+    cfg = pose_cfg()
+    model = build(cfg)
+    head = model._heads["part_pred"]
+    kernel = head.conv.kernel
+    expected = 0.5 * cfg["weight_decay"] * float(tf.reduce_sum(kernel**2))
+    assert float(head.losses[0]) == pytest.approx(expected, rel=1e-6)
+
+
+# ---------------------------------------------------------------------------
+# behaviour
+# ---------------------------------------------------------------------------
+def test_heads_have_the_expected_shapes():
+    model = build(pose_cfg(), batch_size=2)
+    out = model.get_net(images(2))
+    assert out["part_pred"].shape == (2, 16, 20, 4)
+    assert out["locref"].shape == (2, 16, 20, 8)
+    assert out["features"].shape == (2, 8, 10, 320)
+
+
+def test_prediction_of_an_image_does_not_depend_on_its_companions():
+    """Batch norm uses the moving averages, so images cannot interact.
+
+    Only the batch *size* changes anything, and only because the convolution
+    kernels block differently: about 1e-6 relative, with the companions
+    themselves making no difference at all.
+    """
+    model = build(pose_cfg(), batch_size=1)
+    predict = tf.function(
+        model.get_net, input_signature=[tf.TensorSpec([None, *SIZE, 3], tf.float32)]
+    )
+    batch = images(8)
+    reference = predict(batch[:1])["part_pred"].numpy()
+    for n in (2, 4, 8):
+        same_size = predict(batch[:n])["part_pred"].numpy()[:1]
+        assert np.abs(same_size - reference).max() <= 1e-5 * np.abs(reference).max()
+        shuffled = tf.concat([batch[:1], batch[1:n][::-1]], axis=0)
+        assert np.array_equal(predict(shuffled)["part_pred"].numpy()[:1], same_size)
+
+
+def test_train_reaches_every_trainable_weight():
+    cfg = pose_cfg(batch_size=2)
+    model = build(cfg)
+    rng = np.random.RandomState(0)
+    n = cfg["num_joints"]
+    batch = {
+        Batch.inputs: images(2),
+        Batch.part_score_targets: tf.constant(rng.randint(0, 2, (2, 16, 20, n)), tf.float32),
+        Batch.part_score_weights: tf.ones((2, 16, 20, n)),
+        Batch.locref_targets: tf.constant(rng.normal(0, 1, (2, 16, 20, 2 * n)), tf.float32),
+        Batch.locref_mask: tf.ones((2, 16, 20, 2 * n)),
+    }
+    with tf.GradientTape() as tape:
+        loss = model.train(batch)
+    grads = tape.gradient(loss["total_loss"], model.trainable_weights)
+    assert all(g is not None for g in grads)
+    assert np.isfinite(float(loss["total_loss"]))
+
+
+def test_train_does_not_move_the_batch_norm_statistics():
+    """``PoseEfficientNet.get_net`` ignores ``is_training``, so nothing updates.
+
+    The tf_slim graph has zero ``UPDATE_OPS``; this is the same statement.
+    """
+    cfg = pose_cfg(batch_size=2)
+    model = build(cfg)
+    moving = {k: v for k, v in model.slim_weight_map().items() if "moving_" in k}
+    before = {k: v.numpy().copy() for k, v in moving.items()}
+    n = cfg["num_joints"]
+    model.train(
+        {
+            Batch.inputs: images(2, seed=1),
+            Batch.part_score_targets: tf.zeros((2, 16, 20, n)),
+            Batch.part_score_weights: tf.ones((2, 16, 20, n)),
+            Batch.locref_targets: tf.zeros((2, 16, 20, 2 * n)),
+            Batch.locref_mask: tf.ones((2, 16, 20, 2 * n)),
+        }
+    )
+    for name, variable in moving.items():
+        assert np.array_equal(before[name], variable.numpy()), name
+
+
+def test_test_and_inference_run():
+    model = build(pose_cfg())
+    out = model.test(images(1))
+    assert {"part_prob", "peak_inds", "locref", "features"} <= set(out)
+    pose = model.inference(images(1))["pose"]
+    assert pose.shape[1] == 3
+
+
+# ---------------------------------------------------------------------------
+# checkpoints
+# ---------------------------------------------------------------------------
+def test_checkpoint_round_trip(tmp_path):
+    model = build(pose_cfg())
+    prefix = save_tf1_checkpoint(model, str(tmp_path / "snapshot"), global_step=1000)
+    assert prefix.endswith("-1000")
+    other = build(pose_cfg())
+    report = load_tf1_checkpoint(other, prefix)
+    assert report.ok and not report.unused
+    assert len(report.loaded) == len(model.slim_weight_map())
+    assert max(compare_to_tf1_checkpoint(other, prefix).values()) == 0.0
+    before = {k: v.numpy() for k, v in model.slim_weight_map().items()}
+    for name, variable in other.slim_weight_map().items():
+        assert np.array_equal(before[name], variable.numpy()), name
+
+
+def multi_animal_cfg(**kwargs):
+    return pose_cfg(
+        num_joints=6,
+        num_limbs=5,
+        dataset_type="multi-animal-imgaug",
+        partaffinityfield_predict=True,
+        pairwise_predict=True,
+        **kwargs,
+    )
+
+
+def test_multi_animal_config_adds_the_pairwise_head():
+    model = build(multi_animal_cfg())
+    assert sorted(model._heads) == ["locref", "pairwise_pred", "part_pred"]
+    out = model.get_net(images(1))
+    assert out["pairwise_pred"].shape == (1, 16, 20, 10)
+    # 304 backbone weights, plus two each for part_pred, locref and pairwise
+    assert len(model.slim_weight_map()) == 310
+    assert model.unmapped_weights() == []
+
+
+# ---------------------------------------------------------------------------
+# the caller's pose_cfg must come back unharmed
+# ---------------------------------------------------------------------------
+CONFIG_LISTS = {
+    "mean_pixel": [123.68, 116.779, 103.939],
+    "all_joints": [[0], [1], [2], [3]],
+    "all_joints_names": ["a", "b", "c", "d"],
+    "multi_step": [[0.005, 10000], [0.02, 430000]],
+}
+
+
+def assert_config_survives(tmp_path, build_it):
+    """Build a net and check the caller's config is byte-identical after.
+
+    Assigning a structure to a ``tf.keras.Model`` attribute makes Keras replace
+    it with a ``ListWrapper`` in place, and DeepLabCut writes pose_cfg.yaml back
+    out with ``write_plainconfig``.
+    """
+    cfg = pose_cfg(**CONFIG_LISTS)
+    before, after = tmp_path / "before.yaml", tmp_path / "after.yaml"
+    write_plainconfig(str(before), cfg)
+    build_it(cfg)
+    write_plainconfig(str(after), cfg)
+    assert before.read_text() == after.read_text()
+    assert read_plainconfig(str(before)) == read_plainconfig(str(after))
+    for key in CONFIG_LISTS:
+        assert type(cfg[key]) is list, (key, type(cfg[key]))
+
+
+def test_backbone_leaves_the_caller_config_alone(tmp_path):
+    assert_config_survives(tmp_path, KerasBackboneFactory.create)
+
+
+@pytest.mark.skipif(
+    not hasattr(nnets_base, "set_untracked"),
+    reason="BaseKerasPoseNet still assigns cfg through Keras attribute tracking",
+)
+def test_pose_net_leaves_the_caller_config_alone(tmp_path):
+    assert_config_survives(tmp_path, lambda cfg: PoseNetFactory.create(cfg, engine=KERAS_ENGINE))
+
