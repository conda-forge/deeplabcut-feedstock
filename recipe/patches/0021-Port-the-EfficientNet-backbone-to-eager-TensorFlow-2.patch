+# --------------------------------------------------------------------------
+# TensorFlow 2 / Keras implementation
+# --------------------------------------------------------------------------
+
+
+@PoseNetFactory.register("efficientnet", engine=KERAS_ENGINE)
+class PoseEfficientNetKeras(BaseKerasPoseNet):
+    """Keras twin of :class:`PoseEfficientNet`.
+
+    ``use_batch_norm`` and ``use_drop_out`` are carried through instead of
+    ``is_training`` because that is what the TF1 class does: its ``get_net``
+    ignores ``is_training`` and defaults both to ``False``, so the backbone's
+    batch norm uses the stored moving averages and never updates them, while
+    training as much as at inference.  The TF1 graph holds zero ``UPDATE_OPS``,
+    which is the same statement.  ``test()`` is the one caller that overrides
+    them, from ``pose_cfg.yaml``.
+    """
+
+    def __init__(self, cfg):
+        super().__init__(cfg)
+        if "use_batch_norm" not in self.cfg:
+            self.cfg["use_batch_norm"] = False
+        if "use_drop_out" not in self.cfg:
+            self.cfg["use_drop_out"] = False
+        self.backbone = KerasBackboneFactory.create(cfg)
+        n_joints = cfg["num_joints"]
+        self._add_head("part_pred", "pose/part_pred/block4", n_joints + cfg.get("num_idchannel", 0))
+        if cfg["location_refinement"]:
+            self._add_head("locref", "pose/locref_pred/block4", n_joints * 2)
+        if cfg["pairwise_predict"] and "multi-animal" not in cfg["dataset_type"]:
+            self._add_head("pairwise_pred", "pose/pairwise_pred/block4", n_joints * (n_joints - 1) * 2)
+        if cfg["partaffinityfield_predict"] and "multi-animal" in cfg["dataset_type"]:
+            self._add_head("pairwise_pred", "pose/pairwise_pred/block4", cfg["num_limbs"] * 2)
+        # No intermediate-supervision head: BasePoseNet.train() skips it for
+        # efficientnet and PoseEfficientNet never built one.
+
+    def extract_features(self, inputs, is_training=False, use_batch_norm=False, use_drop_out=False):
+        return self.backbone(inputs, training=use_batch_norm, drop_out=use_drop_out)
+
+    def prediction_layers(self, features, end_points, is_training=False):
+        out = {"features": features}
+        for key, layer in self._heads.items():
+            out[key] = layer(features, training=is_training)
+        return out
+
+    def get_net(self, inputs, use_batch_norm=False, use_drop_out=False, is_training=False):
+        features, end_points = self.extract_features(
+            inputs, use_batch_norm=use_batch_norm, use_drop_out=use_drop_out
+        )
+        return self.prediction_layers(features, end_points, is_training=is_training)
+
+    def call(self, inputs, training=False):
+        return self.get_net(inputs, is_training=training)
+
+    def test(self, inputs):
+        heads = self.get_net(inputs, self.cfg["use_batch_norm"], self.cfg["use_drop_out"])
+        return self.add_inference_layers(heads)
+
+
+#: How the published ``cloud-tpu-checkpoints`` weights are stored.  DeepLabCut
+#: restores the shadow copies rather than the raw variables -- ``core/train.py``
+#: does the same rename for the TF1 graph.
+EMA_SUFFIX = "/ExponentialMovingAverage"
+
+
+def imagenet_ckpt_name(slim_name, scope=BACKBONE_SCOPE):
+    """The ImageNet checkpoint's name for one of this net's weights.
+
+    ``None`` for the heads, which those checkpoints do not carry.
+    """
+    prefix = scope + "/"
+    if not slim_name.startswith(prefix):
+        return None
+    return slim_name[len(prefix) :] + EMA_SUFFIX
+
+
+def load_imagenet_checkpoint(model, ckpt_path, **kwargs):
+    """Load the published ``cloud-tpu-checkpoints`` EfficientNet weights.
+
+    Only the backbone is restored; the heads keep their initial values.
+    """
+    return load_tf1_checkpoint(model, ckpt_path, rename=imagenet_ckpt_name, **kwargs)
