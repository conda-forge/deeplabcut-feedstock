+            full = (bboxes[:, 2] - bboxes[:, 0]) * (bboxes[:, 3] - bboxes[:, 1])
+            visible = np.divide(areas, full, out=np.zeros_like(areas), where=full > 0)
+            keep &= visible >= min_visibility
