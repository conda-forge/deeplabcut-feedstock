+# --------------------------------------------------------------------------------
+# sampled parameters
+#
+# These two transforms only touch pixels, so there is no geometry to pin; what has
+# to match the reference is the distribution the parameter is drawn from. Both
+# alternatives below have the right support and the wrong density, which is exactly
+# the kind of difference that never raises and changes every batch.
+# --------------------------------------------------------------------------------
+def test_motion_blur_kernel_size_is_uniform_over_the_odd_sizes():
+    """albumentations drew uniformly from ``range(3, 8, 2)`` -- {3, 5, 7}, 1/3 each.
+
+    Drawing from every integer in [3, 7] and rounding even sizes up instead gives
+    0.20 / 0.40 / 0.40 and a mean kernel of 5.40 rather than 4.99: an 8% wider blur
+    on every image the transform fires on.
+    """
+    transform = aug.MotionBlur(blur_limit=(3, 7), p=1.0)
+    rng = np.random.default_rng(0)
+    image = np.zeros((16, 16, 3), np.uint8)
+    sizes = np.array(
+        [transform.get_params(image, np.zeros((0, 2)), np.zeros((0, 4)), rng)["kernel"].shape[0]
+         for _ in range(20000)]
+    )
+    assert set(np.unique(sizes)) == {3, 5, 7}
+    for k in (3, 5, 7):
+        assert abs((sizes == k).mean() - 1 / 3) < 0.02, f"P(ksize={k}) = {(sizes == k).mean():.3f}"
+    assert abs(sizes.mean() - 5.0) < 0.06, f"mean ksize = {sizes.mean():.3f}"
+
+
+def test_motion_blur_blur_limit_bounds_the_kernel():
+    """The limits are inclusive and the step is 2, so (3, 5) never yields 7."""
+    rng = np.random.default_rng(0)
+    image = np.zeros((16, 16, 3), np.uint8)
+    transform = aug.MotionBlur(blur_limit=(3, 5), p=1.0)
+    sizes = {transform.get_params(image, np.zeros((0, 2)), np.zeros((0, 4)), rng)["kernel"].shape[0]
+             for _ in range(200)}
+    assert sizes == {3, 5}
+
+
+def test_gauss_noise_sigma_is_the_root_of_a_uniform_variance():
+    """``gaussian_noise: 12.75`` becomes ``var_limit=(0, 12.75 ** 2)``.
+
+    The standard deviation of a draw is then ``sqrt(U(0, 12.75 ** 2))``, whose mean
+    is ``2 * 12.75 / 3 = 8.5`` and whose standard deviation is ``12.75 / sqrt(18) =
+    3.01``. Drawing the standard deviation uniformly over the same support instead
+    gives mean 6.375 and standard deviation 3.68 -- the same strongest and weakest
+    noise, about a quarter less of it on average, on every image the transform
+    fires on.
+    """
+    from scipy import stats
+
+    var_limit = 12.75 ** 2
+    transform = aug.GaussNoise(var_limit=(0.0, var_limit), mean=0.0, per_channel=True, p=1.0)
+    rng = np.random.default_rng(0)
+    # 16k samples per draw, so the sample standard deviation reads sigma back to
+    # about 0.6% and the comparison is against the drawn value, not an estimate of it
+    image = np.zeros((128, 128, 1), np.uint8)
+    sigmas = np.array(
+        [transform.get_params(image, np.zeros((0, 2)), np.zeros((0, 4)), rng)["noise"].std()
+         for _ in range(400)]
+    )
+    assert abs(sigmas.mean() - (2 / 3) * 12.75) < 0.25, f"mean sigma = {sigmas.mean():.3f}"
+    assert abs(sigmas.std() - 12.75 / np.sqrt(18)) < 0.25, f"std of sigma = {sigmas.std():.3f}"
+    assert sigmas.max() <= 12.75 * 1.02, f"max sigma = {sigmas.max():.3f}"
+    # P(sigma <= s) = s**2 / var_limit on [0, sqrt(var_limit)]
+    result = stats.kstest(sigmas, lambda s: np.clip(np.asarray(s, float) ** 2 / var_limit, 0.0, 1.0))
+    assert result.pvalue > 0.01, f"KS D = {result.statistic:.4f}, p = {result.pvalue:.4f}"
+
+
+def test_gaussian_noise_config_value_is_the_upper_standard_deviation():
+    """``gaussian_noise: 12.75`` is a standard deviation, so the variance limit is its square.
+
+    Passing the value through as a variance, or as a fraction of 255, silently
+    changes how much noise every image gets.
+    """
+    (transform,) = build({"gaussian_noise": 12.75}).transforms
+    assert isinstance(transform, aug.GaussNoise)
+    assert transform.var_limit == (0.0, 12.75 ** 2)
+    assert transform.mean == 0.0
+    assert transform.per_channel is True
+    # a non-numeric truthy value falls back to a standard deviation of 0.05 * 255
+    (fallback,) = build({"gaussian_noise": "yes"}).transforms
+    assert fallback.var_limit == (0.0, (0.05 * 255) ** 2)
+
+
