+    def _filter_bboxes(
+        self,
+        bboxes: NDArray,
+        tails: list[NDArray],
+        labels: dict[str, list[Any]],
+        image: NDArray,
+    ) -> tuple[NDArray, list[NDArray], dict[str, list[Any]]]:
+        """Clip boxes to the image and drop the ones left with no area.
+
+        Returns the surviving boxes together with the trailing box columns and the
+        bbox label fields, filtered the same way, so the three stay aligned.
+        """
+        if not len(bboxes):
+            return bboxes, tails, labels
+
+        height, width = image.shape[:2]
+        clipped = bboxes.copy()
+        clipped[:, [0, 2]] = np.clip(clipped[:, [0, 2]], 0, width)
+        clipped[:, [1, 3]] = np.clip(clipped[:, [1, 3]], 0, height)
+        areas = (clipped[:, 2] - clipped[:, 0]) * (clipped[:, 3] - clipped[:, 1])
