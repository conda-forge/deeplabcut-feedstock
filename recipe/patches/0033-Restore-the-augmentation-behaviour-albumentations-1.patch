+def test_partial_affine_block_defaults_the_missing_parameters(
+    affine_image, affine_cfg, expected_kpts, expected_boxes
+):
+    """A key left out of the affine block is that parameter's identity.
+
+    ``config/data.py`` types the block ``dict | None`` and validates it by calling
+    ``build_transforms``, so a block naming only some of the three is a configuration
+    a user can write; albumentations answered it with scale 1, rotation 0 and no
+    translation rather than a ``TypeError``.
+    """
+    pipeline = build({"affine": affine_cfg})
+    transform = pipeline.transforms[0]
+    transform.p = 1.0
+    # pin only the parameters the block actually names; the others must come out of
+    # the constructor already set to the identity
+    if "rotation" in affine_cfg:
+        transform.rotate = (affine_cfg["rotation"], affine_cfg["rotation"])
+    if "translation" in affine_cfg:
+        transform.translate_px = (affine_cfg["translation"], affine_cfg["translation"])
+
+    _, kpts, boxes, _ = run(pipeline, affine_image, AFFINE_KP, AFFINE_BB)
+    np.testing.assert_allclose(kpts[:, :2], expected_kpts, atol=1e-9)
+    np.testing.assert_allclose(boxes, expected_boxes, atol=1e-9)
+
